---
export const prerender = false;
import { getAdminData } from '../../lib/admin-data';

let donations = null;
let lastSync = null;

try {
  const data = await getAdminData();
  donations = data.donations;
  lastSync = data.lastSync;
} catch (error) {
  console.error('Failed to load admin data:', error);
}

const fmt = (n: number) => `£${n.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
const fmtDate = (s: string | null) => s ? new Date(s).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : 'Never';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dashboard — Level Up Admin</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    :root {
      --bg-primary: #0C0A3E;
      --bg-secondary: #13114a;
      --text-primary: #EEEBD3;
      --text-secondary: #999999;
      --text-tertiary: rgba(238,235,211,0.4);
      --accent: #CCFF33;
      --border: rgba(255,255,255,0.06);
    }
    :root.light-mode {
      --bg-primary: #FFFFFF;
      --bg-secondary: #F9F9F9;
      --text-primary: #1A1A1A;
      --text-secondary: #666666;
      --text-tertiary: #888888;
      --accent: #8B7EBD;
      --border: rgba(0,0,0,0.1);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
      min-height: 100vh;
    }
    nav {
      background: var(--bg-secondary);
      border-bottom: 1px solid var(--border);
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 56px;
    }
    .nav-brand { font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--accent); }
    .nav-right { display: flex; align-items: center; gap: 20px; }
    .sync-btn {
      background: var(--accent);
      color: var(--bg-primary);
      border: none;
      border-radius: 6px;
      padding: 8px 16px;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .sync-btn:hover { opacity: 0.85; }
    .sync-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .spinner {
      display: inline-block;
      width: 12px;
      height: 12px;
      border: 2px solid rgba(12,10,62,0.3);
      border-top-color: #0C0A3E;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .logout-btn {
      background: none;
      border: 1px solid var(--text-secondary);
      color: var(--text-secondary);
      border-radius: 6px;
      padding: 8px 16px;
      font-size: 12px;
      cursor: pointer;
    }
    main { max-width: 1200px; margin: 0 auto; padding: 40px 32px; }
    h1 { font-size: 28px; font-weight: 800; margin-bottom: 8px; }
    .subtitle { font-size: 14px; color: var(--text-secondary); margin-bottom: 40px; }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 40px;
    }
    .stat-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 24px;
    }
    .stat-label { font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 12px; }
    .stat-value { font-size: 28px; font-weight: 800; color: var(--accent); }
    .stat-sub { font-size: 12px; color: var(--text-tertiary); margin-top: 4px; }
    .section { margin-bottom: 40px; }
    .section-title { font-size: 14px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 16px; }
    .chart-container {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 24px;
    }
    .bar-row { display: flex; gap: 12px; align-items: center; margin-bottom: 12px; }
    .bar-label { font-size: 12px; width: 70px; flex-shrink: 0; color: var(--text-secondary); }
    .bar-track { flex: 1; background: var(--border); border-radius: 4px; height: 24px; overflow: hidden; }
    .bar-fill { height: 100%; background: var(--accent); border-radius: 4px; }
    .bar-value { font-size: 12px; width: 80px; text-align: right; flex-shrink: 0; color: var(--text-secondary); }
    table { width: 100%; border-collapse: collapse; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
    th { text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-tertiary); padding: 12px 20px; border-bottom: 1px solid var(--border); }
    td { padding: 12px 20px; font-size: 13px; border-bottom: 1px solid rgba(255,255,255,0.04); color: var(--text-primary); }
    tr:last-child td { border-bottom: none; }
    .last-sync { font-size: 11px; color: var(--text-tertiary); }
    #theme-btn { cursor: pointer; padding: 4px 8px; background: none; border: none; font-size: 16px; }
  </style>
</head>
<body>
  <nav>
    <div class="nav-brand">Level Up · Admin</div>
    <div class="nav-right">
      <span class="last-sync">Last sync: {fmtDate(lastSync)}</span>
      <button class="sync-btn" id="sync-btn">
        <span>Sync Now</span>
      </button>
      <button id="theme-btn">🌙</button>
      <button class="logout-btn" id="logout-btn">Sign out</button>
    </div>
  </nav>

  <main>
    <h1>Dashboard</h1>
    <p class="subtitle">Donations and performance overview for welevelup.org</p>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">This Month</div>
        <div class="stat-value">{donations ? fmt(donations.totalMonth) : '—'}</div>
        <div class="stat-sub">Total donations received</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">This Year</div>
        <div class="stat-value">{donations ? fmt(donations.totalYear) : '—'}</div>
        <div class="stat-sub">Year to date</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Active Subscribers</div>
        <div class="stat-value">{donations?.activeSubscribers ?? '—'}</div>
        <div class="stat-sub">Monthly recurring donors</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">New This Month</div>
        <div class="stat-value">{donations?.newThisMonth ?? '—'}</div>
        <div class="stat-sub">New recurring donors</div>
      </div>
    </div>

    <div class="section">
      <div class="section-title">Monthly Donations (Last 12 Months)</div>
      <div class="chart-container">
        {donations?.monthlyTotals?.length ? (
          <div>
            {donations.monthlyTotals.map((m: any) => {
              const max = Math.max(...donations.monthlyTotals.map((mt: any) => mt.total));
              const pct = max > 0 ? (m.total / max * 100) : 0;
              return (
                <div class="bar-row">
                  <div class="bar-label">{m.month}</div>
                  <div class="bar-track">
                    <div class="bar-fill" style={`width: ${pct}%`}></div>
                  </div>
                  <div class="bar-value">{fmt(m.total)}</div>
                </div>
              );
            })}
          </div>
        ) : (
          <div style="text-align: center; padding: 40px; color: var(--text-tertiary);">No data yet — click "Sync Now" to fetch donations.</div>
        )}
      </div>
    </div>

    <div class="section">
      <div class="section-title">Monthly Donation Totals</div>
      {donations?.monthlyTotals?.length ? (
        <table>
          <thead>
            <tr>
              <th>Month</th>
              <th>Active</th>
              <th>Monthly</th>
              <th>One-Off</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            {donations.monthlyTotals.map((m: any) => (
              <tr>
                <td>{m.month}</td>
                <td>{m.active_subscribers || 0}</td>
                <td>{fmt(m.monthly_donations || 0)}</td>
                <td>{fmt(m.one_off_donations || 0)}</td>
                <td><strong>{fmt(m.total)}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <div style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; padding: 40px; text-align: center; color: var(--text-tertiary);">No data yet.</div>
      )}
    </div>

    <div class="section">
      <div class="section-title">Monthly Subscription Breakdown</div>
      {donations?.monthlyTotals?.length ? (
        <table>
          <thead>
            <tr>
              <th>Month</th>
              <th>Mollie</th>
              <th>GoCardless</th>
              <th>PayPal</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            {donations.monthlyTotals.map((m: any) => (
              <tr>
                <td>{m.month}</td>
                <td>{m.mollie_count || 0}</td>
                <td>{m.gocardless_count || 0}</td>
                <td>{m.paypal_count || 0}</td>
                <td><strong>{(m.mollie_count || 0) + (m.gocardless_count || 0) + (m.paypal_count || 0)}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <div style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; padding: 40px; text-align: center; color: var(--text-tertiary);">No data yet.</div>
      )}
    </div>
  </main>

  <script>
    const html = document.documentElement;
    const theme = localStorage.getItem('admin-theme') || 'dark';
    if (theme === 'light') html.classList.add('light-mode');

    document.getElementById('theme-btn')?.addEventListener('click', () => {
      if (html.classList.toggle('light-mode')) {
        localStorage.setItem('admin-theme', 'light');
        document.getElementById('theme-btn').textContent = '☀️';
      } else {
        localStorage.setItem('admin-theme', 'dark');
        document.getElementById('theme-btn').textContent = '🌙';
      }
    });

    document.getElementById('sync-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('sync-btn');
      btn.disabled = true;

      const spinner = document.createElement('div');
      spinner.className = 'spinner';
      btn.innerHTML = '';
      btn.appendChild(spinner);
      const text = document.createElement('span');
      text.textContent = 'Syncing...';
      btn.appendChild(text);

      try {
        const res = await fetch('/api/admin-sync', { method: 'POST' });
        if (res.ok) {
          text.textContent = 'Done! Reloading...';
          setTimeout(() => location.reload(), 800);
        } else {
          alert('Sync failed');
          btn.innerHTML = 'Sync Now';
          btn.disabled = false;
        }
      } catch (e) {
        alert('Error: ' + e.message);
        btn.innerHTML = 'Sync Now';
        btn.disabled = false;
      }
    });

    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/admin-auth', { method: 'DELETE' });
      location.href = '/admin';
    });
  </script>
</body>
</html>
