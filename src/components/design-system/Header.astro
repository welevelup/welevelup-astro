---
// Design-system Header — full site menu (same structure/links as prod's
// src/components/Nav.astro), restyled on the new brand tokens. Sticky
// white bar, same as prod, so it reads consistently across every hero
// colour rather than trying to blend into it.
import type { BgColor } from '../../lib/brand-colors';
import Button from './Button.astro';
import logoNavyLime from '../../assets/brand/logos/logo-navy-lime.svg';

interface Props {
  heroBg?: BgColor;
}
---

<a href="#main-content" class="ds-header-skip">Skip to main content</a>
<header class="ds-header">
  <div class="ds-header-top">
    <a href="/" class="ds-header-logo">
      <img src={logoNavyLime.src} alt="Level Up" height="30" />
    </a>

    <nav class="ds-header-bar" id="ds-header-bar" aria-label="Main navigation">
      <div class="ds-header-group">
        <span role="button" tabindex="0" aria-haspopup="true" aria-expanded="false">About Us</span>
        <div class="ds-header-drop">
          <a href="/about-us">What we do</a>
          <a href="/who-we-are">Who we are</a>
          <a href="/our-impact">Our impact</a>
          <a href="/how-we-choose-our-campaigns">How we choose our campaigns</a>
        </div>
      </div>

      <div class="ds-header-group">
        <span role="button" tabindex="0" aria-haspopup="true" aria-expanded="false">Campaigns</span>
        <div class="ds-header-drop ds-header-mega">
          <div class="ds-header-mega-grid">
            <div class="ds-header-mega-col">
              <a href="/active-campaigns/media-guidelines-domestic-abuse" class="ds-header-mega-title">Dignity for Dead Women</a>
              <a href="https://levelup.movement-action.org/p/dignity-for-dead-women" target="_blank" rel="noopener">Sign the petition</a>
              <a href="/resources/ddw">Resources</a>
            </div>
            <div class="ds-header-mega-col">
              <a href="/active-campaigns/pregnancy-in-prison" class="ds-header-mega-title">Pregnancy in Prison</a>
              <a href="https://levelup.yourmovement.org/p/pregnancy-in-prison" target="_blank" rel="noopener">Sign the petition</a>
              <a href="/resources/pregnancy-in-prison">Resources</a>
              <a href="/toolkit">Legal Toolkit</a>
            </div>
            <div class="ds-header-mega-col">
              <a href="/active-campaigns/sexual-violence-in-football" class="ds-header-mega-title">Sexual Violence in Football</a>
              <a href="https://levelup.movement-action.org/p/sexual-violence-in-football" target="_blank" rel="noopener">Sign the petition</a>
              <a href="https://levelup.movement-action.org/p/sexual-violence-in-football" target="_blank" rel="noopener">Share your story</a>
            </div>
            <div class="ds-header-mega-col">
              <a href="/active-campaigns/abortion-is-healthcare" class="ds-header-mega-title">Abortion is Healthcare</a>
              <a href="https://levelup.yourmovement.org/p/abortion-is-healthcare" target="_blank" rel="noopener">Sign the petition</a>
              <a href="/memory/abortion-stories">Abortion Stories – Share Your Story</a>
              <a href="/resources/abortion-is-healthcare">Resources/Media Guidelines</a>
            </div>
            <div class="ds-header-mega-col">
              <a href="/active-campaigns/nomorelyes-2" class="ds-header-mega-title">#NoMoreLyes</a>
              <a href="https://levelup.yourmovement.org/p/no-more-lyes" target="_blank" rel="noopener">Sign the petition</a>
              <a href="/resources/nomorelyes">#NoMoreLyes Relaxer Info Kit</a>
              <a href="/active-campaigns/nomorelyes-open-letter">Sign the open letter to L'Oréal</a>
              <a href="/memory/hair-stories">Share your hair story</a>
            </div>
            <div class="ds-header-mega-col">
              <a href="/active-campaigns/we-protect-us" class="ds-header-mega-title">We Protect Us</a>
              <a href="https://levelup.yourmovement.org/p/we-protect-us" target="_blank" rel="noopener">Sign up for trainings</a>
            </div>
          </div>
        </div>
      </div>

      <div class="ds-header-group">
        <span role="button" tabindex="0" aria-haspopup="true" aria-expanded="false">Community</span>
        <div class="ds-header-drop ds-header-mega ds-header-mega--center">
          <div class="ds-header-mega-grid ds-header-mega-grid--2">
            <div class="ds-header-mega-col">
              <a href="/active-campaigns/islington-council-finish-holloway-womens-centre" class="ds-header-mega-title">Holloway Women's Centre</a>
              <a href="https://levelup.yourmovement.org/p/islington-council-finish-holloway-womens-centre" target="_blank" rel="noopener">Sign the petition</a>
              <a href="/active-campaigns/holloway-open-letter">Open letter to Islington Council</a>
            </div>
            <div class="ds-header-mega-col">
              <a href="/memory" class="ds-header-mega-title">Space for Memory</a>
              <a href="/memory/abortion-stories">Abortion stories</a>
              <a href="/memory/solidarity">Messages of solidarity</a>
              <a href="/memory/hair-stories">Hair stories</a>
              <a href="/memory/holloway-stories">Holloway stories</a>
            </div>
          </div>
        </div>
      </div>

      <div class="ds-header-group">
        <span role="button" tabindex="0" aria-haspopup="true" aria-expanded="false">Blog</span>
        <div class="ds-header-drop">
          <a href="/blog">All posts</a>
          <a href="/blog/if-you-like-us-cite-us">If you like us, cite us</a>
          <a href="/blog/its-time-to-reclaim-the-socialist-roots-of-international-womens-day">Socialist roots of IWD</a>
          <a href="/blog/gender-critical-feminism-isnt-feminist">Gender-critical feminism</a>
        </div>
      </div>

      <div class="ds-header-group">
        <span role="button" tabindex="0" aria-haspopup="true" aria-expanded="false">Resources</span>
        <div class="ds-header-drop">
          <a href="/resources">All Resources</a>
          <a href="/resources/nomorelyes">#NoMoreLyes Info Kit</a>
          <a href="/resources/ddw">Dignity for Dead Women</a>
          <a href="/resources/abortion-is-healthcare">Abortion Is Healthcare</a>
          <a href="/resources/pregnancy-in-prison">Pregnancy in Prison</a>
        </div>
      </div>

      <a href="/press">Press Coverage</a>
      <a href="/contact">Contact</a>

      <a href="https://levelup.yourmovement.org/p/join-us" class="ds-header-mobile-join" target="_blank" rel="noopener">Join Us</a>
      <a href="/donate" class="ds-header-mobile-donate">Donate</a>
    </nav>

    <div class="ds-header-ctas">
      <Button bg="electric-yellow" text="navy" href="/donate" label="Donate" class="ds-header-pill" />
      <Button bg="navy" text="off-white" href="https://levelup.yourmovement.org/p/join-us" label="Join us" class="ds-header-pill" />
    </div>

    <button class="ds-header-toggle" id="ds-header-toggle" aria-label="Menu" aria-expanded="false" aria-controls="ds-header-bar">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.getElementById('ds-header-toggle');
  const bar = document.getElementById('ds-header-bar');
  const header = toggle?.closest('.ds-header');

  toggle?.addEventListener('click', () => {
    const isOpen = bar?.classList.contains('ds-header-bar--open');
    bar?.classList.toggle('ds-header-bar--open');
    header?.classList.toggle('ds-header--menu-open');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  function toggleGroup(span: Element) {
    const group = span.closest('.ds-header-group');
    const isOpen = group?.classList.contains('ds-header-group--open');
    document.querySelectorAll('.ds-header-group--open').forEach((g) => {
      g.classList.remove('ds-header-group--open');
      g.querySelector(':scope > span')?.setAttribute('aria-expanded', 'false');
    });
    if (!isOpen) {
      group?.classList.add('ds-header-group--open');
      span.setAttribute('aria-expanded', 'true');
    }
  }

  document.querySelectorAll('.ds-header-group > span').forEach((span) => {
    span.addEventListener('click', () => toggleGroup(span));
    span.addEventListener('keydown', (e) => {
      const ke = e as KeyboardEvent;
      if (ke.key === 'Enter' || ke.key === ' ') {
        e.preventDefault();
        toggleGroup(span);
      }
    });
  });
</script>

<style>
  .ds-header-skip {
    position: absolute;
    left: -9999px;
    top: 8px;
    z-index: 9999;
    background: var(--color-electric-yellow);
    color: var(--color-navy);
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-body);
    font-weight: 700;
    text-decoration: none;
  }
  .ds-header-skip:focus { left: 8px; }

  .ds-header {
    background: var(--color-white);
    position: sticky;
    top: 0;
    z-index: 999;
    font-family: var(--font-body);
    border-bottom: 1px solid rgba(12, 10, 62, 0.08);
  }
  .ds-header-top {
    max-width: var(--container-max);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-3) var(--space-4);
  }
  .ds-header-logo { display: flex; align-items: center; flex-shrink: 0; }
  .ds-header-logo img { height: 28px; width: auto; display: block; }

  .ds-header-bar {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex: 1;
  }
  .ds-header-bar > a,
  .ds-header-group > span {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--color-navy);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    white-space: nowrap;
    display: inline-block;
  }
  .ds-header-bar > a:hover,
  .ds-header-group:hover > span {
    color: var(--color-loud-lilac);
  }

  .ds-header-group { position: relative; }
  .ds-header-drop {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--color-white);
    border: 1px solid rgba(12,10,62,0.12);
    min-width: 240px;
    padding: var(--space-3) 0;
    z-index: 200;
    box-shadow: 0 12px 32px rgba(0,0,0,0.12);
  }
  .ds-header-group:hover > .ds-header-drop,
  .ds-header-group:focus-within > .ds-header-drop,
  .ds-header-group--open > .ds-header-drop {
    display: block;
  }
  .ds-header-drop > a {
    display: block;
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--color-loud-lilac);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .ds-header-drop > a:hover { color: var(--color-navy); background: rgba(12,10,62,0.04); }

  .ds-header-mega { min-width: 900px; left: -120px; padding: 0; }
  .ds-header-mega-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
  .ds-header-mega-grid--2 { grid-template-columns: repeat(2, 1fr); }
  .ds-header-mega-col { padding: var(--space-5) var(--space-4); border-right: 1px solid rgba(12,10,62,0.07); border-bottom: 1px solid rgba(12,10,62,0.07); }
  .ds-header-mega-col:nth-child(3n) { border-right: none; }
  .ds-header-mega-col:nth-child(n+4) { border-bottom: none; }
  .ds-header-mega--center { left: 50%; transform: translateX(-50%); min-width: 560px; }

  .ds-header-mega-title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-navy) !important;
    display: block !important;
    margin-bottom: var(--space-3) !important;
    padding: 0 !important;
  }
  .ds-header-mega-title:hover { color: var(--color-loud-lilac) !important; }
  .ds-header-mega-col a {
    display: block;
    padding: var(--space-1) 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--color-loud-lilac);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .ds-header-mega-col a:hover { color: var(--color-navy); }

  .ds-header-ctas { display: flex; gap: var(--space-2); align-items: center; flex-shrink: 0; }
  .ds-header-ctas :global(.ds-header-pill) { padding: var(--space-2) var(--space-4); font-size: 0.8rem; }
  .ds-header-mobile-join,
  .ds-header-mobile-donate { display: none; }

  .ds-header-toggle {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
    flex-direction: column;
    gap: 5px;
  }
  .ds-header-toggle span { display: block; width: 22px; height: 2px; background: var(--color-navy); }

  @media (max-width: 1080px) {
    .ds-header-bar { display: none; }
    .ds-header-ctas { display: none; }
    .ds-header-toggle { display: flex; }

    .ds-header-bar--open {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      position: fixed;
      inset: 0;
      top: 60px;
      background: var(--color-white);
      z-index: 998;
      overflow-y: auto;
      padding: var(--space-4) var(--space-4) var(--space-10);
      gap: 0;
    }
    .ds-header-bar--open > a,
    .ds-header-bar--open > .ds-header-group > span {
      padding: var(--space-4) 0;
      font-size: 1rem;
      border-bottom: 1px solid rgba(12,10,62,0.08);
      width: 100%;
    }
    .ds-header-bar--open .ds-header-mega,
    .ds-header-bar--open .ds-header-drop:not(.ds-header-mega) {
      position: static;
      box-shadow: none;
      border: none;
      min-width: auto;
      left: 0;
      transform: none;
      padding-left: var(--space-4);
    }
    .ds-header-bar--open .ds-header-mega-grid { grid-template-columns: 1fr !important; }
    .ds-header-bar--open .ds-header-mega-col { border: none; padding: var(--space-3) 0; }
    .ds-header-mobile-join,
    .ds-header-mobile-donate {
      display: block;
      text-align: center;
      padding: var(--space-4);
      font-family: var(--font-body);
      font-weight: 700;
      text-decoration: none;
      text-transform: uppercase;
      margin-top: var(--space-3);
    }
    .ds-header-mobile-donate { background: var(--color-electric-yellow); color: var(--color-navy); }
    .ds-header-mobile-join { background: var(--color-navy); color: var(--color-off-white); }
  }
</style>
