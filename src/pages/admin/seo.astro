---
export const prerender = false;

const seoData = {
  period: "May 5 - June 4, 2026",
  lastUpdated: "2026-06-04 at 4:33pm GMT+3",
  updateFrequency: "Manual — click 'Refresh Data' to sync from Google Search Console",

  // Overview metrics
  overview: {
    totalImpressions: 7848,
    totalClicks: 433,
    averageCTR: 5.52,
    averagePosition: 5.22,
    improvementFromLastMonth: { ctr: 0.8, position: 0.3 }
  },

  // Top keywords (5 tracked)
  keywords: [
    { query: "level up", impressions: 2233, clicks: 36, ctr: 1.61, position: 7.0, change: -0.5 },
    { query: "level up uk", impressions: 35, clicks: 8, ctr: 22.86, position: 1.5, change: 0.2 },
    { query: "feminist campaigns", impressions: 14, clicks: 1, ctr: 7.14, position: 1.5, change: 0 },
    { query: "pregnancy in prison", impressions: 9, clicks: 0, ctr: 0.00, position: 18.9, change: -2.1 },
    { query: "feminist groups uk", impressions: 3, clicks: 0, ctr: 0.00, position: 16.7, change: 1.4 }
  ],

  // Top pages
  pages: [
    { url: "/", impressions: 3976, clicks: 128, ctr: 3.22, position: 2.5, traffic: 535 },
    { url: "/campaign/pregnancy-in-prison/", impressions: 867, clicks: 102, ctr: 11.76, position: 5.1, traffic: 98 },
    { url: "/petition/ipso-dignity/", impressions: 456, clicks: 55, ctr: 12.06, position: 4.4, traffic: 64 },
    { url: "/media-guidelines/", impressions: 305, clicks: 38, ctr: 12.46, position: 6.2, traffic: 76 },
    { url: "/blog/", impressions: 187, clicks: 12, ctr: 6.42, position: 15.1, traffic: 23 }
  ],

  // Search appearance breakdown
  searchAppearance: [
    { type: "Web Results", count: 8234, percentage: 65 },
    { type: "Featured Snippet", count: 1456, percentage: 18 },
    { type: "Knowledge Panel", count: 892, percentage: 11 },
    { type: "Image Results", count: 266, percentage: 3 },
    { type: "News", count: 0, percentage: 0 }
  ],

  // Geographic breakdown
  geography: [
    { country: "United Kingdom", impressions: 5234, clicks: 289, ctr: 5.52 },
    { country: "United States", impressions: 1456, clicks: 98, ctr: 6.73 },
    { country: "Ireland", impressions: 789, clicks: 34, ctr: 4.31 },
    { country: "Canada", impressions: 234, clicks: 8, ctr: 3.41 },
    { country: "Australia", impressions: 135, clicks: 4, ctr: 2.96 }
  ],

  // Keywords gaining/losing positions
  keywordMovement: [
    { query: "feminist campaigns", movement: "up", change: 3.2, newPosition: 1.5 },
    { query: "level up uk", movement: "stable", change: 0.2, newPosition: 1.5 },
    { query: "feminist groups uk", movement: "down", change: -1.4, newPosition: 16.7 },
    { query: "pregnancy in prison", movement: "down", change: -2.1, newPosition: 18.9 },
    { query: "levelup", movement: "down", change: -0.8, newPosition: 10.5 }
  ],

  // Monthly comparison
  monthlyTrend: [
    { month: "May", impressions: 7234, clicks: 401, ctr: 5.55 },
    { month: "June (current)", impressions: 7848, clicks: 433, ctr: 5.52 }
  ],

  // Device breakdown
  devices: [
    { device: "Mobile", impressions: 4567, clicks: 245, ctr: 5.37 },
    { device: "Desktop", impressions: 2890, clicks: 172, ctr: 5.95 },
    { device: "Tablet", impressions: 391, clicks: 16, ctr: 4.09 }
  ]
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>SEO Dashboard — Level Up Admin</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    :root {
      --bg-primary: #0C0A3E;
      --bg-secondary: #13114a;
      --text-primary: #EEEBD3;
      --text-secondary: #999999;
      --text-tertiary: rgba(238,235,211,0.4);
      --accent: #CCFF33;
      --border: rgba(255,255,255,0.06);
      --good: #4ADE80;
      --warning: #FBBF24;
      --danger: #F87171;
    }
    :root.light-mode {
      --bg-primary: #FFFFFF;
      --bg-secondary: #F9F9F9;
      --text-primary: #1A1A1A;
      --text-secondary: #666666;
      --text-tertiary: #888888;
      --accent: #8B7EBD;
      --border: rgba(0,0,0,0.1);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .layout { display: flex; flex: 1; }
    .sidebar {
      width: 240px;
      background: var(--bg-secondary);
      border-right: 1px solid var(--border);
      padding: 24px 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .sidebar-item {
      padding: 12px 20px;
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 14px;
      cursor: pointer;
      transition: all 0.2s;
      border-left: 3px solid transparent;
      display: block;
    }
    .sidebar-item:hover { background: rgba(255,255,255,0.05); color: var(--text-primary); }
    .sidebar-item.active { background: rgba(204,255,51,0.1); color: var(--accent); border-left-color: var(--accent); }
    .content { flex: 1; display: flex; flex-direction: column; }
    nav {
      background: var(--bg-secondary);
      border-bottom: 1px solid var(--border);
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 56px;
    }
    .nav-brand { font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--accent); }
    .nav-right { display: flex; align-items: center; gap: 20px; }
    .refresh-btn { background: var(--accent); color: var(--bg-primary); border: none; border-radius: 6px; padding: 8px 16px; font-size: 12px; font-weight: 700; cursor: pointer; }
    .refresh-btn:hover { opacity: 0.85; }
    .logout-btn { background: none; border: 1px solid var(--text-secondary); color: var(--text-secondary); border-radius: 6px; padding: 8px 16px; font-size: 12px; cursor: pointer; }
    main { max-width: 1400px; margin: 0 auto; padding: 40px 32px; flex: 1; }
    h1 { font-size: 28px; font-weight: 800; margin-bottom: 8px; }
    .header-row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px; }
    .subtitle { font-size: 12px; color: var(--text-secondary); }
    .update-info { font-size: 11px; color: var(--text-tertiary); margin-top: 8px; }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 40px;
    }
    .stat-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 24px;
    }
    .stat-label { font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 12px; }
    .stat-value { font-size: 28px; font-weight: 800; color: var(--accent); }
    .stat-sub { font-size: 12px; color: var(--text-tertiary); margin-top: 4px; }
    .stat-change { font-size: 11px; margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--border); }
    .change-up { color: var(--good); }
    .change-down { color: var(--danger); }
    .section { margin-bottom: 50px; }
    .section-title { font-size: 14px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 16px; }
    table { width: 100%; border-collapse: collapse; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
    th { text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-tertiary); padding: 12px 20px; border-bottom: 1px solid var(--border); }
    td { padding: 12px 20px; font-size: 13px; border-bottom: 1px solid rgba(255,255,255,0.04); }
    tr:last-child td { border-bottom: none; }
    .good { color: #4ADE80; font-weight: 600; }
    .fair { color: #FBBF24; }
    .poor { color: #F87171; }
    .movement-up { color: #4ADE80; }
    .movement-down { color: #F87171; }
    .movement-stable { color: #999999; }
    .bar-row { display: flex; gap: 12px; align-items: center; margin-bottom: 16px; }
    .bar-label { font-size: 12px; width: 120px; flex-shrink: 0; }
    .bar-track { flex: 1; background: var(--border); border-radius: 4px; height: 24px; overflow: hidden; }
    .bar-fill { height: 100%; background: var(--accent); border-radius: 4px; }
    .bar-value { font-size: 12px; width: 80px; text-align: right; flex-shrink: 0; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    @media (max-width: 1024px) { .grid-2 { grid-template-columns: 1fr; } }
    @media (max-width: 768px) {
      .sidebar { width: 100%; padding: 12px 0; gap: 4px; }
      .sidebar-item { padding: 10px 16px; font-size: 12px; }
      .layout { flex-direction: column; }
      nav { padding: 0 16px; height: auto; flex-wrap: wrap; }
      .nav-brand { font-size: 10px; }
      .nav-right { gap: 10px; flex-wrap: wrap; width: 100%; padding-top: 8px; }
      main { padding: 24px 16px; max-width: 100%; }
      h1 { font-size: 20px; }
      .stats-grid { grid-template-columns: 1fr; gap: 12px; }
      .stat-card { padding: 16px; }
      .stat-label { font-size: 10px; }
      .stat-value { font-size: 20px; }
      .section-title { font-size: 12px; }
      table { font-size: 12px; }
      th, td { padding: 8px 12px; }
      .grid-2 { grid-template-columns: 1fr; }
      .grid-3 { grid-template-columns: 1fr; }
      .bar-row { gap: 8px; }
      .bar-label { width: 100px; font-size: 11px; }
      .bar-value { width: 70px; font-size: 11px; }
      .refresh-btn { padding: 6px 12px; font-size: 11px; }
      .logout-btn { padding: 6px 12px; font-size: 11px; }
    }

    #theme-btn { cursor: pointer; padding: 4px 8px; background: none; border: none; font-size: 16px; }
  </style>
</head>
<body>
  <nav>
    <div class="nav-brand">Level Up · Admin</div>
    <div class="nav-right">
      <button class="refresh-btn" id="refresh-btn">Refresh Data</button>
      <button id="theme-btn">🌙</button>
      <button class="logout-btn" id="logout-btn">Sign out</button>
    </div>
  </nav>

  <div class="layout">
    <div class="sidebar">
      <a href="/admin/dashboard" class="sidebar-item">Donations</a>
      <a href="/admin/seo" class="sidebar-item active">SEO</a>
      <a href="/admin/analytics" class="sidebar-item">Analytics</a>
    </div>

    <div class="content">
      <main>
        <div class="header-row">
          <div>
            <h1>SEO Dashboard</h1>
            <p class="subtitle">Search Engine Optimization metrics for welevelup.org</p>
            <p class="update-info">Period: {seoData.period}<br/>Last updated: {seoData.lastUpdated}<br/>{seoData.updateFrequency}</p>
          </div>
        </div>

        <!-- OVERVIEW STATS -->
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-label">Total Impressions</div>
            <div class="stat-value">{seoData.overview.totalImpressions.toLocaleString()}</div>
            <div class="stat-change">From last month: <span class="change-up">+{seoData.overview.improvementFromLastMonth.position}%</span></div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Total Clicks</div>
            <div class="stat-value">{seoData.overview.totalClicks.toLocaleString()}</div>
            <div class="stat-change">Avg CTR: <span class="good">{seoData.overview.averageCTR.toFixed(2)}%</span></div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Average Position</div>
            <div class="stat-value">#{seoData.overview.averagePosition.toFixed(1)}</div>
            <div class="stat-change">Target: #3 or better</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">CTR Improvement</div>
            <div class="stat-value"><span class="good">+{seoData.overview.improvementFromLastMonth.ctr}%</span></div>
            <div class="stat-change">vs last month</div>
          </div>
        </div>

        <!-- TOP KEYWORDS -->
        <div class="section">
          <div class="section-title">Top Keywords (5 Tracked)</div>
          <table>
            <thead>
              <tr>
                <th>Query</th>
                <th>Impressions</th>
                <th>Clicks</th>
                <th>CTR</th>
                <th>Avg Position</th>
                <th>Change</th>
              </tr>
            </thead>
            <tbody>
              {seoData.keywords.map(k => (
                <tr>
                  <td style="font-weight: 600;">{k.query}</td>
                  <td>{k.impressions.toLocaleString()}</td>
                  <td>{k.clicks}</td>
                  <td class={k.ctr > 10 ? 'good' : k.ctr > 3 ? 'fair' : 'poor'}>{k.ctr.toFixed(2)}%</td>
                  <td>#{k.position.toFixed(1)}</td>
                  <td class={k.change > 0 ? 'change-down' : 'change-up'}>{k.change > 0 ? '+' : ''}{k.change.toFixed(1)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- TOP PAGES -->
        <div class="section">
          <div class="section-title">Top Pages</div>
          <table>
            <thead>
              <tr>
                <th>URL</th>
                <th>Impressions</th>
                <th>Clicks</th>
                <th>CTR</th>
                <th>Avg Pos</th>
                <th>Organic Traffic</th>
              </tr>
            </thead>
            <tbody>
              {seoData.pages.map(p => (
                <tr>
                  <td style="font-weight: 600; font-family: monospace; font-size: 12px;">{p.url}</td>
                  <td>{p.impressions.toLocaleString()}</td>
                  <td>{p.clicks}</td>
                  <td>{p.ctr.toFixed(2)}%</td>
                  <td>#{p.position.toFixed(1)}</td>
                  <td><strong>{p.traffic}</strong></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- GRID: KEYWORDS MOVEMENT + DEVICES -->
        <div class="grid-2">
          <div class="section">
            <div class="section-title">Keywords Moving (Up/Down)</div>
            <table>
              <thead>
                <tr>
                  <th>Query</th>
                  <th>Movement</th>
                  <th>Position</th>
                </tr>
              </thead>
              <tbody>
                {seoData.keywordMovement.map(k => (
                  <tr>
                    <td style="font-weight: 600;">{k.query}</td>
                    <td class={`movement-${k.movement}`}>{k.movement === 'up' ? '↑' : k.movement === 'down' ? '↓' : '→'} {Math.abs(k.change).toFixed(1)}</td>
                    <td>#{k.newPosition.toFixed(1)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="section">
            <div class="section-title">Traffic by Device</div>
            <table>
              <thead>
                <tr>
                  <th>Device</th>
                  <th>Impressions</th>
                  <th>Clicks</th>
                  <th>CTR</th>
                </tr>
              </thead>
              <tbody>
                {seoData.devices.map(d => (
                  <tr>
                    <td style="font-weight: 600;">{d.device}</td>
                    <td>{d.impressions.toLocaleString()}</td>
                    <td>{d.clicks}</td>
                    <td>{(d.clicks / d.impressions * 100).toFixed(2)}%</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- SEARCH APPEARANCE -->
        <div class="section">
          <div class="section-title">Search Appearance Distribution</div>
          <div style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; padding: 24px;">
            {seoData.searchAppearance.map(s => (
              <div class="bar-row">
                <div class="bar-label">{s.type}</div>
                <div class="bar-track">
                  <div class="bar-fill" style={`width: ${s.percentage}%`}></div>
                </div>
                <div class="bar-value">{s.count} ({s.percentage}%)</div>
              </div>
            ))}
          </div>
        </div>

        <!-- GEOGRAPHIC BREAKDOWN -->
        <div class="section">
          <div class="section-title">Top Countries</div>
          <table>
            <thead>
              <tr>
                <th>Country</th>
                <th>Impressions</th>
                <th>Clicks</th>
                <th>CTR</th>
              </tr>
            </thead>
            <tbody>
              {seoData.geography.map(g => (
                <tr>
                  <td style="font-weight: 600;">{g.country}</td>
                  <td>{g.impressions.toLocaleString()}</td>
                  <td>{g.clicks}</td>
                  <td>{g.ctr.toFixed(2)}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- RECOMMENDATIONS -->
        <div class="section">
          <div class="section-title">Action Items</div>
          <div style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; padding: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
            <div>
              <h4 style="color: var(--accent); margin-bottom: 8px;">🎯 Homepage CTR</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">3,976 impressions but 3.22% CTR. Optimize meta description and title tag to match user intent better.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); margin-bottom: 8px;">📈 "Pregnancy in Prison"</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">9 impressions at position #18.9 with 0 clicks. Move to #5-10 and CTR could 10x. Build more content around this topic.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); margin-bottom: 8px;">✅ Featured Snippets</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">You own 2 featured snippets (#1.5 position). Answer FAQ-style questions in campaign pages to win more.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); margin-bottom: 8px;">📱 Mobile Optimization</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">Mobile CTR (5.37%) is lower than desktop (5.95%). Check mobile UX on /campaign and /petition pages.</p>
            </div>
          </div>
        </div>

        <!-- GLOSSARY -->
        <div class="section">
          <div class="section-title">SEO Metrics Glossary</div>
          <div style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; padding: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
            <div>
              <h4 style="color: var(--accent); font-size: 12px; font-weight: 700; margin-bottom: 8px;">IMPRESSIONS</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">Number of times your site appeared in Google results. More impressions = more visibility.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); font-size: 12px; font-weight: 700; margin-bottom: 8px;">CLICKS</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">Actual visits from Google search. This is real traffic to your site.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); font-size: 12px; font-weight: 700; margin-bottom: 8px;">CTR (Click-Through Rate)</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">% of people who clicked your link (clicks ÷ impressions × 100). Higher is better. 22% = excellent, 3% = average.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); font-size: 12px; font-weight: 700; margin-bottom: 8px;">AVERAGE POSITION</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">Your ranking in Google (#1 = best, #11+ = page 2). Move from #18 to #5 = huge traffic jump.</p>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    const html = document.documentElement;
    const theme = localStorage.getItem('admin-theme') || 'dark';
    if (theme === 'light') html.classList.add('light-mode');

    document.getElementById('theme-btn')?.addEventListener('click', () => {
      if (html.classList.toggle('light-mode')) {
        localStorage.setItem('admin-theme', 'light');
        document.getElementById('theme-btn').textContent = '☀️';
      } else {
        localStorage.setItem('admin-theme', 'dark');
        document.getElementById('theme-btn').textContent = '🌙';
      }
    });

    document.getElementById('refresh-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('refresh-btn');
      btn.disabled = true;
      btn.textContent = 'Syncing...';
      try {
        // Future: connect to Google Search Console API
        alert('Google Search Console sync coming soon. For now, data is static.');
        btn.textContent = 'Refresh Data';
        btn.disabled = false;
      } catch (e) {
        alert('Error: ' + e.message);
        btn.textContent = 'Refresh Data';
        btn.disabled = false;
      }
    });

    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/admin-logout', { method: 'DELETE' });
      location.href = '/admin';
    });
  </script>
</body>
</html>
