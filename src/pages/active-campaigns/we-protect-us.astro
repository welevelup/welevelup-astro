---
/**
 * Campaign: We Protect Us — rebuilt on the design system.
 * Doesn't fit CampaignTemplate — this is a free training signup page, not a
 * petition (no petitionHref, no timeline/demands), so it's a standalone
 * page reusing the same primitives. Real content preserved verbatim — see
 * .bak-pre-step2 for the original.
 */
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/design-system/Header.astro';
import SplitHero from '../../components/design-system/SplitHero.astro';
import Section from '../../components/design-system/Section.astro';
import Headline from '../../components/design-system/Headline.astro';
import Label from '../../components/design-system/Label.astro';
import Button from '../../components/design-system/Button.astro';
import Footer from '../../components/design-system/Footer.astro';

const SIGNUP_HREF = 'https://levelup.yourmovement.org/p/we-protect-us';
---
<Layout
  headHtml=""
  title="We Protect Us — Free Bystander Intervention Training | Level Up"
  description="Free online bystander intervention training from Level Up — learn to safely interrupt harassment in public, at work, or in your community."
  ogImage="/wp-content/uploads/2025/09/we-protect-us-2.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify([
    { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://welevelup.org" },
      { "@type": "ListItem", "position": 2, "name": "Campaigns", "item": "https://welevelup.org/active-campaigns" },
      { "@type": "ListItem", "position": 3, "name": "We Protect Us", "item": "https://welevelup.org/active-campaigns/we-protect-us" }
    ]}
  ])} />

  <Header heroBg="loud-lilac" />

  <SplitHero bg="loud-lilac" imageSrc="/wp-content/uploads/2025/09/we-protect-us-2.webp" imageAlt="We Protect Us bystander intervention training">
    <Label color="electric-yellow">Bystander Intervention</Label>
    <Headline color="off-white">Free Bystander Intervention Training</Headline>
    <p style="color: var(--color-off-white); max-width: 46ch;">Join Level Up's free online bystander intervention training and learn how to safely interrupt harassment in public, at work, in your family or in your community.</p>
    <Button bg="electric-yellow" text="navy" href={SIGNUP_HREF} label="Sign up for trainings" />
  </SplitHero>

  <Section bg="electric-yellow">
    <div class="wpu-stat">
      <span class="wpu-stat-value">413</span>
      <span class="wpu-stat-caption">People trained in the past year</span>
    </div>
  </Section>

  <Section bg="off-white">
    <Headline as="h2">We protect us</Headline>
    <p style="max-width: 68ch;">Join Level Up's free online bystander intervention training and learn how to safely interrupt harassment in public, at work, in your family or in your community.</p>
    <p style="max-width: 68ch;">We provide practical, feminist-led training sessions that equip you with the skills to intervene in cases of sexist, racist, LGBTQ+ or Islamophobic harassment and gender-based violence.</p>
  </Section>

  <Section bg="white">
    <Headline as="h2">What the training is</Headline>
    <p style="max-width: 68ch;">The fight for gender justice takes real action on a daily basis, but sometimes it's hard to know what that looks like.</p>
    <p style="max-width: 68ch;">That's why Level Up runs free online bystander intervention sessions – to give everyone the skills they need to intervene when they see harassment happening.</p>
    <p style="max-width: 68ch;">In the past year, we've trained 413 people, and we're running more sessions in 2023!</p>
  </Section>

  <Section bg="navy">
    <Headline as="h2" color="off-white">Why we run it</Headline>
    <p style="color: var(--color-off-white); max-width: 68ch;">Violence in our society – from sexist or racist harassment and domestic abuse to LGBTQ+ or Islamophobic hate crime – will not be prevented through more policing. It will only be prevented if we all take action. We protect us, we keep each other safe.</p>
  </Section>

  <Section bg="off-white">
    <Headline as="h2">Next event</Headline>
    <p style="max-width: 68ch;">There are no upcoming events right now. Subscribe to our mailing list to stay updated.</p>
    <div class="wpu-video">
      <video controls preload="metadata" src="/wp-content/uploads/2025/08/in-the-edit-street_v3.2-1.mp4#t=1">
        Your browser does not support video.
      </video>
      <p class="wpu-video-caption"><em>Level Up and Black Protest Legal Support created a short video ft. Sapphire Mackintosh on using your agency to intervene in a police stop and search.</em></p>
    </div>
  </Section>

  <Section bg="navy">
    <div class="wpu-support-cta">
      <Headline as="h2" color="off-white">Get involved</Headline>
      <div class="wpu-support-cta-actions">
        <Button bg="electric-yellow" text="navy" href={SIGNUP_HREF} label="Sign up for trainings" />
        <Button bg="off-white" text="navy" href="/donate" label="Donate" />
      </div>
    </div>
  </Section>

  <Section bg="navy">
    <div class="wpu-join-cta">
      <Headline as="h2" color="off-white">Join the Level Up community</Headline>
      <p style="color: var(--color-off-white); max-width: 480px; margin-inline: auto;">Campaign updates, event invitations, and feminist thinking.</p>
      <Button bg="gentle-lilac" text="navy" href="https://levelup.yourmovement.org/p/join-us" label="Join us" />
    </div>
  </Section>

  <Footer bg="loud-lilac" />
</Layout>

<style>
  .wpu-stat { text-align: center; display: flex; flex-direction: column; gap: var(--space-2); }
  .wpu-stat-value { font-family: var(--font-headline); font-size: var(--text-headline); color: var(--color-navy); line-height: 1; }
  .wpu-stat-caption { font-family: var(--font-body); color: var(--color-navy); }
  .wpu-video { margin-top: var(--space-6); }
  .wpu-video video { width: 100%; max-width: 680px; display: block; border-radius: var(--radius-card); }
  .wpu-video-caption { margin-top: var(--space-3); max-width: 68ch; }
  .wpu-support-cta, .wpu-join-cta { text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-4); }
  .wpu-support-cta-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; justify-content: center; }
</style>
