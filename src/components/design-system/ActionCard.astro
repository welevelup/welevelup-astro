---
// Matches the real "How you can help" action-card pattern (dp-action in the
// pre-Step-2 campaign pages, and the dark "Donate / Support this ongoing
// work / →" cards in the homepage mockup): a whole clickable block with a
// bold title, a short description, and a trailing arrow — not a separate
// button.
import type { BgColor, TextColor } from '../../lib/brand-colors';

interface Props<Bg extends BgColor = BgColor> {
  bg: Bg;
  text: TextColor<Bg>;
  title: string;
  description: string;
  href: string;
}
const { bg, text, title, description, href } = Astro.props as Props;
const external = /^https?:\/\//.test(href);
---

<a
  class="ds-card ds-action-card"
  style={`background: var(--color-${bg}); color: var(--color-${text});`}
  href={href}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
>
  <span class="ds-action-card-body">
    <strong class="ds-action-card-title">{title}</strong>
    <span class="ds-action-card-desc">{description}</span>
  </span>
  <span class="ds-action-card-arrow" aria-hidden="true">&rarr;</span>
</a>

<style>
  .ds-card {
    border-radius: var(--radius-card);
    padding: var(--space-6);
  }
  .ds-action-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    text-decoration: none;
  }
  .ds-action-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .ds-action-card-title {
    font-family: var(--font-headline);
    font-size: var(--text-subheadline);
  }
  .ds-action-card-desc {
    font-family: var(--font-body);
    font-size: var(--text-body);
    opacity: 0.85;
  }
  .ds-action-card-arrow {
    font-size: 1.5em;
    flex-shrink: 0;
  }
</style>
