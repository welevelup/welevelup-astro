{
  "redirects": [
    {
      "source": "/petition/(.*)",
      "destination": "https://levelup.yourmovement.org/p/$1",
      "permanent": true
    },
    {
      "source": "/all-resources",
      "destination": "/resources",
      "permanent": true
    },
    {
      "source": "/ddw-resources",
      "destination": "/resources/ddw",
      "permanent": true
    },
    {
      "source": "/pp-resources",
      "destination": "/resources/pregnancy-in-prison",
      "permanent": true
    },
    {
      "source": "/abortion-is-healthcare-resources",
      "destination": "/resources/abortion-is-healthcare",
      "permanent": true
    },
    {
      "source": "/media-guidelines",
      "destination": "/resources/ddw",
      "permanent": true
    },
    {
      "source": "/our-work",
      "destination": "/our-impact",
      "permanent": true
    },
    {
      "source": "/our-team",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/news-and-events",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/beyond-sympathy-feminist-solidarity-without-deservingness",
      "destination": "/blog/beyond-sympathy-feminist-solidarity-without-deservingness",
      "permanent": true
    },
    {
      "source": "/how-we-choose-our-campaigns",
      "destination": "/blog/how-we-choose-our-campaigns",
      "permanent": true
    },
    {
      "source": "/the-griefs-left-unattended",
      "destination": "/blog/the-griefs-left-unattended",
      "permanent": true
    },
    {
      "source": "/why-expanding-criminalisation-is-a-feminist-issue",
      "destination": "/blog/why-expanding-criminalisation-is-a-feminist-issue",
      "permanent": true
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/category/abortion-stories",
      "destination": "/memory/abortion-stories",
      "permanent": true
    },
    {
      "source": "/category/abortion-stories/(.*)",
      "destination": "/memory/abortion-stories",
      "permanent": true
    },
    {
      "source": "/tag/lye",
      "destination": "/active-campaigns/nomorelyes",
      "permanent": true
    },
    {
      "source": "/tag/packaging",
      "destination": "/resources/nomorelyes",
      "permanent": true
    },
    {
      "source": "/tag/ovarian-cancer",
      "destination": "/resources/nomorelyes",
      "permanent": true
    },
    {
      "source": "/tag/kidney-failure",
      "destination": "/resources/nomorelyes",
      "permanent": true
    },
    {
      "source": "/category/(.*)",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/tag/(.*)",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/author/(.*)",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/wp-admin(.*)",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/wp-content/:path*",
      "destination": "https://welevelup.org/wp-content/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net https://www.facebook.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://www.facebook.com https://connect.facebook.net https://challenges.cloudflare.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self' https://app.mollie.com;" }
      ]
    }
  ]
}
