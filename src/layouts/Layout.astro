---
import CookieBanner from '../components/CookieBanner.astro';
import { default as SpeedInsights } from '@vercel/speed-insights/astro';

interface Props {
  headHtml: string;
  bodyClass?: string;
  title?: string;
  description?: string;
  ogUrl?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  headHtml,
  bodyClass = '',
  title,
  description,
  ogUrl,
  ogImage = 'https://welevelup.org/wp-content/uploads/2023/05/Level-Up-OG.png',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const siteBase = 'https://welevelup.org';
const canonicalUrl = ogUrl ?? (siteBase + Astro.url.pathname);
---
<!doctype html>
<html lang="en-GB" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://connect.facebook.net" />
    <link rel="dns-prefetch" href="https://www.facebook.com" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <Fragment set:html={headHtml} />
    <style is:global>
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

      /* Must come after WP CSS to win cascade — hides Elementor header/footer */
      header[data-elementor-type="header"],
      .elementor-location-header,
      footer[data-elementor-type="footer"],
      .elementor-location-footer { display: none !important; }

      /* Hide Elementor mobile-hidden elements (e.g. secondary CTA button) */
      .elementor-hidden-mobile { display: none !important; }

      /* Hide "Big beauty brands..." subtext on mobile only */
      @media (max-width: 768px) {
        .elementor-element-c703ee4 { display: none !important; }
      }

      /* Desktop hero: fill viewport minus nav (~109px) and ic-bar (~42px) */
      @media (min-width: 769px) {
        .elementor-element-c89219b {
          min-height: calc(100dvh - 155px) !important;
          height: auto !important;
        }
      }

      /* Homepage hero: full-screen on mobile with readable text */
      @media (max-width: 768px) {
        /* Hero fills viewport minus mobile nav (~68px) and ic-bar with padding (~62px) */
        .elementor-element-c89219b {
          min-height: calc(100dvh - 135px) !important;
          height: auto !important;
        }
        .home-caption .elementor-widget-container p {
          font-size: 17px !important;
          line-height: 1.5 !important;
        }
        .home-caption .elementor-heading-title {
          font-size: 40px !important;
          line-height: 1.05 !important;
        }
      }
    </style>
    {title && <title>{title}</title>}
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/webp" href="/wp-content/uploads/2025/07/cropped-cropped-square-shape-01-180x180.webp" />
    <link rel="apple-touch-icon" href="/wp-content/uploads/2025/07/cropped-cropped-square-shape-01-180x180.webp" />
    <link rel="canonical" href={canonicalUrl} />
    {title && <meta property="og:title" content={title} />}
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Level Up" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@we_level_up" />
    {title && <meta name="twitter:title" content={title} />}
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "NGO",
      "name": "Level Up",
      "alternateName": "welevelup.org",
      "url": "https://welevelup.org",
      "logo": {
        "@type": "ImageObject",
        "url": "https://welevelup.org/wp-content/uploads/2025/07/level_up_new.webp"
      },
      "description": "Level Up is a UK-based feminist campaigning organisation working to advance reproductive justice, abortion decriminalisation and freedom from systemic violence.",
      "foundingDate": "2016",
      "email": "hello@welevelup.org",
      "areaServed": "GB",
      "knowsAbout": ["reproductive justice", "abortion rights", "domestic violence", "gender justice", "feminist campaigns"],
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "hello@welevelup.org",
        "contactType": "general"
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "3rd Floor, 86–90 Paul Street",
        "addressLocality": "London",
        "postalCode": "EC2A 4NE",
        "addressCountry": "GB"
      },
      "sameAs": [
        "https://www.facebook.com/levelupaction",
        "https://twitter.com/we_level_up",
        "https://www.instagram.com/welevelup",
        "https://www.tiktok.com/@levelupactionuk"
      ]
    })} />

    <!-- Meta Pixel — only fires after explicit cookie consent -->
    <script is:inline>
      if (typeof window !== 'undefined' && localStorage.getItem('lu_cookie_consent') === 'accepted' && !window.location.pathname.startsWith('/donor-portal')) {
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '1862990614381002');
        fbq('track', 'PageView');
      }
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
    <CookieBanner />
    <SpeedInsights />

    <script is:inline>
      document.addEventListener('click', function (e) {
        var el = e.target.closest('a[href*="yourmovement.org"]');
        if (!el || typeof gtag !== 'function') return;
        var url = el.getAttribute('href') || '';
        var text = (el.textContent || '').trim();
        var action = url.includes('/p/join-us') ? 'join_us'
          : url.includes('petition') || text.toLowerCase().includes('petition') ? 'sign_petition'
          : url.includes('training') || text.toLowerCase().includes('training') ? 'sign_up_training'
          : 'yourmovement_click';
        gtag('event', action, {
          event_category: 'outbound',
          event_label: url,
          link_text: text,
        });
      });
    </script>
  </body>
</html>
