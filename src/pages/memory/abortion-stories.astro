---
/**
 * Abortion Stories — rebuilt on the design system.
 * Real content preserved verbatim — see abortion-stories.astro.bak-pre-designsystem
 * for the original "warm literary journal" bespoke version. The share-your-story
 * form is static markup only (no JS) in the original too — its own note says
 * the form isn't active yet and directs people to email instead.
 */
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/design-system/Header.astro';
import Section from '../../components/design-system/Section.astro';
import Grid25 from '../../components/design-system/Grid25.astro';
import Headline from '../../components/design-system/Headline.astro';
import Label from '../../components/design-system/Label.astro';
import Button from '../../components/design-system/Button.astro';
import Footer from '../../components/design-system/Footer.astro';

const ACCENTS = ['electric-yellow', 'gentle-lilac', 'loud-lilac'] as const;

const FEATURED = [
  { quote: "I got pregnant at 22 — the first time with my future husband. My doctor warned me I'd feel awful afterwards. Instead I felt completely free. I've never regretted it for a second.", tag: 'Age 22' },
  { quote: 'I was 25, in a relationship with a much older man who pressured me to keep the pregnancy. There were religious protesters outside the clinic. He read their pamphlets to me to increase the pressure. I went through weeks of fever and pain recovering alone. I have absolutely no regrets.', tag: 'Age 25' },
  { quote: 'I already had three children. Financially and emotionally we had nothing left to give. It was the toughest decision of my life. But I made it for the children I already had. No woman takes abortion lightly. I have no regrets.', tag: 'Mother of three' },
  { quote: 'I was six months into my second pregnancy when my doctor told me plainly: if you continue, you will likely die, and so will the baby. It was less than a year after my caesarean. I never told anyone except my partner. The secrecy was its own weight. I still feel angry that I had to carry it in silence.', tag: 'Medical necessity' },
  { quote: "I was 43 with an irregular cycle. I didn't expect to be fertile. I am so grateful I had access. I simply did not have the mental or physical capacity to have a child. That is a complete and sufficient reason.", tag: 'Age 43' },
  { quote: 'One set of pills failed. I collapsed, vomited, passed out from pain. I was admitted to hospital for two days. When I told the male doctor how much pain I was in, he told me it was normal and I should expect it. No one should have to fight to be believed when they are already going through this.', tag: 'Medical abortion, 5 weeks' },
  { quote: "I paid for a private consultation so there would be no record on my NHS file. I'm aware of the privilege that required. But it shows you what women do when they are afraid of being judged — even by their own doctor.", tag: 'Anonymous' },
  { quote: 'I had two abortions — one at 17 in 1977, one in 1990 when my IUD failed before a year of travel abroad. Both times, I had no doubt. Both times, society made me feel I should. I am now in my 60s and I have never once wished I had made a different choice.', tag: 'Two experiences, no regrets' },
].map((s, i) => ({ ...s, accent: ACCENTS[i % ACCENTS.length] }));

const MORE_VOICES = [
  { quote: "I was 17. I drove myself to the hospital alone. They put me on a ward with newborns. I wanted to break my family's cycle of early parenthood. The system did not make it easy.", tag: 'Age 17' },
  { quote: 'My partner said there was nothing I could do about it. I relied on strangers on Reddit for information. I told no one except my mother. The NHS gave me almost nothing.', tag: 'During lockdown' },
  { quote: 'I grew up in a religious household that was against abortion. Then I had two planned children. Now I am vehemently pro-choice — because I understand what it means to actually choose.', tag: 'Mother of two' },
  { quote: "I had PCOS and believed I couldn't conceive. I was wrong. I crossed a border to access what I needed. The secrecy alone was its own kind of punishment.", tag: 'Age 34' },
  { quote: 'Condom and morning-after pill both failed. There were religious protesters outside the clinic on both visits. I spent all my savings on a private clinic so I wouldn’t be recognised. No regrets.', tag: 'Age 25, committed relationship' },
  { quote: 'I drove to another city and paid over a thousand pounds out of pocket. The home pill experience was difficult with no follow-up support. I am still glad I had the option.', tag: 'Australia, age 25' },
  { quote: 'I was 38, happily married, with a stepdaughter I love. My parents were aging. The house was small. I thought carefully about my life. Nine years later — no regrets.', tag: 'Age 38' },
  { quote: "I switched contraception and had bad luck. I never told my partner — I knew he'd want to continue and I didn't. We split a year later. I'm now 39 and still do not want children. Zero regrets.", tag: 'Age 24, now 39' },
  { quote: 'My copper coil fell out without me knowing. I was pregnant, my relationship was breaking down, and at the ultrasound I saw a heartbeat. I still made the decision that was right for me. The grief and the rightness can both be true.', tag: 'Age 20, university student' },
  { quote: 'My partner became aggressive the moment I told him. I had the abortion. The relationship ended anyway. I made the right call twice.', tag: 'Anonymous' },
  { quote: 'I was in a relationship with an alcoholic. I made the decision. Later I did community work I could never have done as a parent. I have no doubt the life I chose was the right one.', tag: 'Anonymous' },
  { quote: 'I was 18. I had my mother’s support, I was seen the same day, and I went back to work the next morning. Zero regrets. I wish it were this straightforward for everyone.', tag: 'Age 18' },
].map((s, i) => ({ ...s, accent: ACCENTS[i % ACCENTS.length] }));
---
<Layout
  headHtml=""
  title="Abortion Stories | Memory Space | Level Up"
  description="Real abortion experiences told anonymously. These stories push back against shame and silence — because abortion is healthcare and your story belongs to you."
>
  <Header />

  <Section bg="pale-yellow">
    <a href="/memory" class="as-back-link">← Back to Memory</a>
    <Label color="loud-lilac">Anonymous stories</Label>
    <Headline>Abortion Stories</Headline>
    <p class="as-hero-intro">A space for people to read and share experiences of abortion, each anonymous and held with care.</p>
  </Section>

  <Section bg="off-white">
    <Grid25>
      <Fragment slot="narrow">
        <blockquote class="as-pull-statement">"Abortion is healthcare and one in three women will have one in their lifetime."</blockquote>
        <cite class="as-pull-cite">Level Up</cite>
      </Fragment>
      <Fragment slot="wide">
        <p>Everyone who has accessed an abortion has a different experience, and a deeply personal story that is theirs to tell.</p>
        <p>This is a chance for you to share your abortion story anonymously and read stories shared by other people. Sharing our own experiences is one of the ways that we can normalise abortion and build a society that shows compassion towards people who need them.</p>
      </Fragment>
    </Grid25>
  </Section>

  <Section bg="pale-yellow">
    <Headline as="h2">Their words</Headline>
    <div class="as-quote-grid">
      {FEATURED.map((s) => (
        <div class="as-quote-card" style={`border-color: var(--color-${s.accent});`}>
          <p class="as-quote-text">{s.quote}</p>
          <span class="as-quote-tag">{s.tag}</span>
        </div>
      ))}
    </div>
  </Section>

  <Section bg="off-white">
    <Headline as="h2">More voices</Headline>
    <div class="as-quote-grid as-quote-grid--3">
      {MORE_VOICES.map((s) => (
        <div class="as-quote-card" style={`border-color: var(--color-${s.accent});`}>
          <p class="as-quote-text">{s.quote}</p>
          <span class="as-quote-tag">{s.tag}</span>
        </div>
      ))}
    </div>
  </Section>

  <Section bg="gentle-lilac">
    <p class="as-solidarity-text">One in three women will have an abortion in their lifetime.<br/><strong>None of them owe anyone an explanation.</strong></p>
  </Section>

  <Section bg="pale-yellow">
    <Grid25>
      <Fragment slot="narrow">
        <Label color="loud-lilac">Open call</Label>
        <Headline as="h2">Share your story</Headline>
        <p class="as-share-sub">Your words, your way. Completely anonymous.</p>
      </Fragment>
      <Fragment slot="wide">
        <p class="as-share-body">If you'd like to share your abortion story anonymously to help move the conversation from debate to compassion, we'd be honoured to receive it.</p>
        <p class="as-share-body">You set the terms. You can be as brief or as detailed as you choose. You can share why you'd like it to be included — or not explain yourself at all.</p>

        <div class="as-form">
          <p class="as-form-legend">What would you like to share?</p>

          <div class="as-form-row">
            <label class="as-form-field">
              <span class="as-form-label">Your name (optional)</span>
              <input class="as-form-input" type="text" placeholder="First name, or leave blank" />
            </label>
            <label class="as-form-field">
              <span class="as-form-label">Email address</span>
              <input class="as-form-input" type="email" placeholder="So we can follow up if needed" />
            </label>
          </div>

          <label class="as-form-field">
            <span class="as-form-label">Your story</span>
            <textarea class="as-form-textarea" rows="6" placeholder="Write as much or as little as feels right. There is no wrong way to do this."></textarea>
            <span class="as-form-hint">Your submission is handled with care. We will never publish your name or any identifying details without your explicit consent.</span>
          </label>

          <label class="as-form-field">
            <span class="as-form-label">A brief context (optional)</span>
            <input class="as-form-input" type="text" placeholder="e.g. Mother of one, age 28 — or leave blank" />
          </label>

          <div class="as-form-checks">
            <label class="as-form-check">
              <input type="checkbox" checked />
              <span>Keep my story anonymous — do not publish my name</span>
            </label>
            <label class="as-form-check">
              <input type="checkbox" />
              <span>You can share my story on the Level Up website</span>
            </label>
          </div>

          <button class="as-form-submit" type="button">Send your story →</button>
          <p class="as-form-note">This form is not yet active. To share your story, email us at <a href="mailto:hello@welevelup.org">hello@welevelup.org</a> with the subject line "My Story".</p>
        </div>
      </Fragment>
    </Grid25>
  </Section>

  <Section bg="navy">
    <Headline as="h2" color="electric-yellow" class="as-nav-heading">Continue exploring</Headline>
    <div class="as-nav-links">
      <a href="/memory" class="as-nav-link">
        <span class="as-nav-link-label">← Memory</span>
        <span class="as-nav-link-desc">Return to the full archive</span>
      </a>
      <a href="/active-campaigns/abortion-is-healthcare" class="as-nav-link">
        <span class="as-nav-link-label">Abortion Is Healthcare →</span>
        <span class="as-nav-link-desc">The campaign behind these stories</span>
      </a>
    </div>
  </Section>

  <Section bg="navy">
    <div class="as-cta">
      <Headline as="h2" color="electric-yellow">Join the Level Up community</Headline>
      <p style="color: var(--color-off-white); opacity: 0.75; max-width: 480px; margin-inline: auto;">Campaign updates, event invitations, and feminist thinking.</p>
      <Button bg="electric-yellow" text="navy" href="https://levelup.yourmovement.org/p/join-us" label="Join us" />
    </div>
  </Section>

  <Footer bg="navy" />
</Layout>

<style>
  .as-back-link {
    display: block;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--color-loud-lilac);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-6);
  }
  .as-back-link:hover { color: var(--color-navy); }
  .as-hero-intro { font-family: var(--font-body); font-size: 1.25rem; color: var(--color-navy); opacity: 0.7; max-width: 44ch; }

  .as-pull-statement {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--color-navy);
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-3);
  }
  .as-pull-cite { font-family: var(--font-body); font-weight: 700; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-loud-lilac); font-style: normal; }

  .as-quote-grid { max-width: 1100px; margin: var(--space-8) auto 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); }
  .as-quote-grid--3 { grid-template-columns: repeat(3, 1fr); }
  .as-quote-card {
    background: var(--color-off-white);
    border-left: 4px solid;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .as-quote-text { font-family: var(--font-body); font-size: 1rem; line-height: 1.7; color: var(--color-navy); opacity: 0.85; margin: 0; flex: 1; }
  .as-quote-tag { font-family: var(--font-body); font-weight: 600; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-navy); opacity: 0.45; }

  .as-solidarity-text {
    font-family: var(--font-body);
    font-size: 1.375rem;
    line-height: 1.5;
    color: var(--color-navy);
    text-align: center;
    max-width: 32ch;
    margin: 0 auto;
  }
  .as-solidarity-text strong { font-weight: 800; }

  .as-share-sub { font-family: var(--font-body); color: var(--color-navy); opacity: 0.7; margin: 0; }
  .as-share-body { font-family: var(--font-body); font-size: 1.0625rem; line-height: 1.6; color: var(--color-navy); opacity: 0.8; margin: 0 0 var(--space-4); }

  .as-form { margin-top: var(--space-6); display: flex; flex-direction: column; gap: var(--space-5); }
  .as-form-legend { font-family: var(--font-body); font-weight: 700; font-size: 0.9375rem; color: var(--color-navy); margin: 0; }
  .as-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .as-form-field { display: flex; flex-direction: column; gap: var(--space-2); }
  .as-form-label { font-family: var(--font-body); font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-navy); opacity: 0.6; }
  .as-form-input, .as-form-textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: var(--space-3) var(--space-4);
    border: 2px solid rgba(12,10,62,0.15);
    background: var(--color-white);
    color: var(--color-navy);
  }
  .as-form-input:focus, .as-form-textarea:focus { outline: 3px solid var(--color-navy); outline-offset: 2px; }
  .as-form-hint { font-family: var(--font-body); font-size: 0.8125rem; color: var(--color-navy); opacity: 0.55; margin: 0; }
  .as-form-checks { display: flex; flex-direction: column; gap: var(--space-3); }
  .as-form-check { display: flex; align-items: flex-start; gap: var(--space-3); font-family: var(--font-body); font-size: 0.9375rem; color: var(--color-navy); opacity: 0.85; }
  .as-form-check input { margin-top: 3px; }
  .as-form-submit {
    align-self: flex-start;
    font-family: var(--font-headline);
    font-size: 1.05rem;
    background: var(--color-electric-yellow);
    color: var(--color-navy);
    border: none;
    padding: var(--space-3) var(--space-6);
    cursor: pointer;
  }
  .as-form-submit:hover { opacity: 0.9; }
  .as-form-note { font-family: var(--font-body); font-size: 0.875rem; color: var(--color-navy); opacity: 0.6; margin: 0; }
  .as-form-note a { color: var(--color-loud-lilac); }

  :global(.as-nav-heading) { text-align: center; margin-bottom: var(--space-8) !important; }
  .as-nav-links { max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .as-nav-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: rgba(238,235,211,0.06);
    border: 1px solid rgba(238,235,211,0.15);
    padding: var(--space-6);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .as-nav-link:hover { border-color: var(--color-electric-yellow); }
  .as-nav-link-label { font-family: var(--font-headline); font-size: 1.15rem; color: var(--color-electric-yellow); }
  .as-nav-link-desc { font-family: var(--font-body); font-size: 0.875rem; color: var(--color-off-white); opacity: 0.6; }

  .as-cta { text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-4); }

  @media (max-width: 768px) {
    .as-quote-grid, .as-quote-grid--3 { grid-template-columns: 1fr; }
    .as-form-row { grid-template-columns: 1fr; }
    .as-nav-links { grid-template-columns: 1fr; }
  }
</style>
