---
/**
 * Who We Are (Team) — rebuilt on the design system.
 * Real content preserved verbatim — see .bak-pre-step2 for the original.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/design-system/Header.astro';
import Section from '../components/design-system/Section.astro';
import Headline from '../components/design-system/Headline.astro';
import Label from '../components/design-system/Label.astro';
import Button from '../components/design-system/Button.astro';
import Footer from '../components/design-system/Footer.astro';

const TEAM = [
  { name: 'Ruvimbo Kuuzabuwe', role: 'Creative Content Strategist', fun: "When I'm not fighting gender injustice I'm making music", photo: '/team/Ruvimbo-Kuuzabuwe.webp' },
  { name: 'Seyi Falodun-Liburd', role: 'Strategy and Fundraising', fun: "When I'm not interrupting gender injustice I'm usually listening to music or a podcast while painting", photo: '/team/Seyi-Falodun-Liburd.webp' },
  { name: 'Jade Hammond', role: 'Digital Comms Strategist', fun: "When I'm not interrupting gender injustice, I'm dancing, drawing or going down internet rabbit holes on psychology and/or sharks", photo: '/team/Jade-Hammond.webp' },
  { name: 'Janey Starling', role: 'Strategy and Campaigning', fun: "When I'm not interrupting gender injustice at Level Up, you can find me singing in a punk band, tending to the flowers in my garden or lifting weights.", photo: '/team/Janey-Starling.webp' },
  { name: 'Ikamara Larasi', role: 'Campaigner', fun: "When I'm not interrupting gender injustice I'm usually nerding out on genealogy and music.", photo: '/team/Ikamara-Larasi.webp' },
  { name: 'Catalina Rojas Ugarte', role: 'Tech Lead', fun: "When I'm not interrupting gender injustice, I'm cooking or planning a trip to Greece.", photo: '/team/Catalina-Rojas-Ugarte.webp', linkedin: 'https://www.linkedin.com/in/catalina-rojas-ugarte/' },
  { name: 'Sabrina-Anne Sarpong', role: 'Finance', fun: '', photo: '/team/Sabrina-Anne-Sarpong.webp' },
];

const ADVISORY = [
  { name: 'Marai Larasi', role: 'Advocate, Activist and Consultant' },
  { name: 'Esme Peach', role: 'Creative Strategist' },
  { name: 'Rachel Barrett', role: 'Barrister at Cloisters' },
  { name: 'Kajal Odedra', role: 'Executive Director at Change.org UK' },
  { name: 'Ayesha Saran', role: 'Programme Manager at Barrow Cadbury' },
];

const COFOUNDERS = ['Carys Afoko', 'Sondhya Gupta', 'Rose Hall', 'Hannah Lownsbrough', 'Hanna Thomas'];
---
<Layout
  headHtml=""
  title="Who We Are | Level Up"
  description="Meet the Level Up community — feminists from a range of backgrounds centering the voices of women, gender-nonconforming and trans people fighting gender injustice."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://welevelup.org" },
      { "@type": "ListItem", "position": 2, "name": "Who We Are", "item": "https://welevelup.org/who-we-are" }
    ]
  })} />

  <Header heroBg="navy" />

  <Section bg="navy">
    <Label color="gentle-lilac">The Team</Label>
    <Headline color="electric-yellow">Meet Our Team</Headline>
  </Section>

  <Section bg="off-white">
    <div class="wwa-team-grid">
      {TEAM.map((p) => (
        <article class="wwa-card">
          <div class="wwa-card-photo">
            <img src={p.photo} alt={p.name} loading="lazy" />
          </div>
          <h2 class="wwa-card-name">{p.name}</h2>
          <p class="wwa-card-role">{p.role}</p>
          {p.fun && <p class="wwa-card-fun">{p.fun}</p>}
          {p.linkedin && (
            <a href={p.linkedin} class="wwa-linkedin" target="_blank" rel="noopener" aria-label={`${p.name} on LinkedIn`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          )}
        </article>
      ))}
    </div>
  </Section>

  <Section bg="navy">
    <div class="wwa-advisory">
      <div class="wwa-advisory-col">
        <Headline as="h2" color="electric-yellow" class="wwa-advisory-title">Strategic Advisory Group</Headline>
        <ul class="wwa-advisory-list">
          {ADVISORY.map((a) => (
            <li>{a.name} <span class="wwa-advisory-role">({a.role})</span></li>
          ))}
        </ul>
      </div>
      <div class="wwa-advisory-col">
        <Headline as="h2" color="electric-yellow" class="wwa-advisory-title">Co-Founders</Headline>
        <ul class="wwa-advisory-list">
          {COFOUNDERS.map((name) => <li>{name}</li>)}
        </ul>
      </div>
    </div>
  </Section>

  <Section bg="navy">
    <div class="wwa-cta">
      <Headline as="h2" color="electric-yellow">Join the Level Up community</Headline>
      <p style="color: var(--color-off-white); opacity: 0.75; max-width: 480px; margin-inline: auto;">Campaign updates, event invitations, and feminist thinking.</p>
      <Button bg="electric-yellow" text="navy" href="https://levelup.yourmovement.org/p/join-us" label="Join us" />
    </div>
  </Section>

  <Footer bg="navy" />
</Layout>

<style>
  .wwa-team-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8) var(--space-6);
  }
  .wwa-card { display: flex; flex-direction: column; }
  .wwa-card-photo {
    width: 100%;
    aspect-ratio: 3/4;
    background: var(--color-navy);
    overflow: hidden;
    margin-bottom: var(--space-4);
  }
  .wwa-card-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .wwa-card-name { font-family: var(--font-headline); font-size: var(--text-body); color: var(--color-navy); margin: 0 0 var(--space-1); }
  .wwa-card-role {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-loud-lilac);
    margin: 0 0 var(--space-3);
  }
  .wwa-card-fun { font-size: 0.875rem; line-height: 1.6; color: var(--color-navy); opacity: 0.65; margin: 0; flex: 1; }
  .wwa-linkedin { display: inline-flex; align-items: center; color: var(--color-navy); margin-top: var(--space-3); }
  .wwa-linkedin:hover { color: var(--color-loud-lilac); }

  .wwa-advisory { max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); }
  .wwa-advisory :global(.wwa-advisory-title) {
    font-size: var(--text-body);
    margin: 0 0 var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 2px solid var(--color-electric-yellow);
  }
  .wwa-advisory-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .wwa-advisory-list li { font-weight: 700; font-size: 0.9rem; color: var(--color-off-white); text-transform: uppercase; letter-spacing: 0.03em; }
  .wwa-advisory-role { font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--color-off-white); opacity: 0.65; font-size: 0.8rem; }

  .wwa-cta { text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-4); }

  @media (max-width: 1024px) {
    .wwa-team-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 768px) {
    .wwa-team-grid { grid-template-columns: repeat(2, 1fr); }
    .wwa-advisory { grid-template-columns: 1fr; gap: var(--space-8); }
  }
</style>
