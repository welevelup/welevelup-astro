---
export const prerender = false;
import { getAdminData } from '../../lib/admin-data';

let donations = null;
let lastSync = null;

try {
  const data = await getAdminData();
  donations = data.donations;
  lastSync = data.lastSync;
} catch (error) {
  console.error('Failed to load admin data:', error);
}

const fmt = (n: number) =>
  `£${n.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
const fmtDate = (s: string | null) =>
  s
    ? new Date(s).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })
    : 'Never';

const donationsJSON = JSON.stringify(donations ?? null);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Donations Dashboard — Level Up Admin</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    :root {
      --bg-primary: #0C0A3E;
      --bg-secondary: #13114a;
      --text-primary: #EEEBD3;
      --text-secondary: #999999;
      --text-tertiary: rgba(238,235,211,0.4);
      --accent: #CCFF33;
      --border: rgba(255,255,255,0.06);
      --good: #4ADE80;
      --warning: #FBBF24;
      --danger: #F87171;
      --mollie: #4ADE80;
      --gocardless: #FBBF24;
      --paypal: #F87171;
    }
    :root.light-mode {
      --bg-primary: #FFFFFF;
      --bg-secondary: #F9F9F9;
      --text-primary: #1A1A1A;
      --text-secondary: #666666;
      --text-tertiary: #888888;
      --accent: #8B7EBD;
      --border: rgba(0,0,0,0.1);
      --mollie: #16a34a;
      --gocardless: #d97706;
      --paypal: #dc2626;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .layout { display: flex; flex: 1; }

    /* ── SIDEBAR ── */
    .sidebar {
      width: 240px;
      background: var(--bg-secondary);
      border-right: 1px solid var(--border);
      padding: 24px 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex-shrink: 0;
    }
    .sidebar-item {
      padding: 12px 20px;
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 14px;
      cursor: pointer;
      transition: all 0.2s;
      border-left: 3px solid transparent;
      display: block;
    }
    .sidebar-item:hover { background: rgba(255,255,255,0.05); color: var(--text-primary); }
    .sidebar-item.active { background: rgba(204,255,51,0.1); color: var(--accent); border-left-color: var(--accent); }

    /* ── CONTENT ── */
    .content { flex: 1; display: flex; flex-direction: column; min-width: 0; }
    nav {
      background: var(--bg-secondary);
      border-bottom: 1px solid var(--border);
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 56px;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    .nav-brand { font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--accent); }
    .nav-right { display: flex; align-items: center; gap: 12px; }
    .sync-info { font-size: 11px; color: var(--text-tertiary); white-space: nowrap; }
    .refresh-btn {
      background: var(--accent);
      color: var(--bg-primary);
      border: none;
      border-radius: 6px;
      padding: 8px 16px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: opacity 0.15s;
    }
    .refresh-btn:hover { opacity: 0.85; }
    .refresh-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .logout-btn { background: none; border: 1px solid var(--text-secondary); color: var(--text-secondary); border-radius: 6px; padding: 8px 16px; font-size: 12px; cursor: pointer; }
    #theme-btn { cursor: pointer; padding: 4px 8px; background: none; border: none; font-size: 16px; }

    /* ── MAIN ── */
    main { max-width: 1400px; margin: 0 auto; padding: 40px 32px; flex: 1; width: 100%; }
    h1 { font-size: 28px; font-weight: 800; margin-bottom: 8px; }
    .header-row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px; }
    .subtitle { font-size: 12px; color: var(--text-secondary); }
    .update-info { font-size: 11px; color: var(--text-tertiary); margin-top: 8px; }

    /* ── STATS GRID ── */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 40px;
    }
    .stat-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 24px;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(0,0,0,0.2); }
    .stat-label { font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 12px; }
    .stat-value { font-size: 28px; font-weight: 800; color: var(--accent); }
    .stat-sub { font-size: 12px; color: var(--text-tertiary); margin-top: 4px; }
    .stat-change { font-size: 11px; margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--border); }
    .change-up { color: var(--good); }
    .change-down { color: var(--danger); }

    /* ── CHART ── */
    .section { margin-bottom: 50px; }
    .section-title { font-size: 14px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 16px; }
    .chart-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 24px;
    }
    .chart-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .chart-legend {
      display: flex;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }
    .legend-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 600;
      color: var(--text-secondary);
    }
    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .chart-wrap { width: 100%; overflow: hidden; }
    #multi-chart { width: 100%; display: block; }

    /* ── TABLES ── */
    table { width: 100%; border-collapse: collapse; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
    th { text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-tertiary); padding: 12px 20px; border-bottom: 1px solid var(--border); white-space: nowrap; }
    td { padding: 12px 20px; font-size: 13px; border-bottom: 1px solid rgba(255,255,255,0.04); }
    tr:last-child td { border-bottom: none; }
    tbody tr { transition: background 0.1s; }
    tbody tr:hover { background: rgba(255,255,255,0.03); }
    .td-total { font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums; }
    .td-mono { font-variant-numeric: tabular-nums; }
    .td-mollie { color: var(--mollie); font-weight: 600; font-variant-numeric: tabular-nums; }
    .td-gocardless { color: var(--gocardless); font-weight: 600; font-variant-numeric: tabular-nums; }
    .td-paypal { color: var(--paypal); font-weight: 600; font-variant-numeric: tabular-nums; }
    .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .badge {
      display: inline-block;
      font-size: 10px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 99px;
      letter-spacing: 0.04em;
    }
    .badge-recurring { background: rgba(204,255,51,0.12); color: var(--accent); }

    /* ── GATEWAY BARS ── */
    .gateway-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }
    .gateway-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 24px;
      transition: all 0.3s cubic-bezier(0.16,1,0.3,1);
    }
    .gateway-card:hover { border-color: var(--accent); background: rgba(204,255,51,0.03); }
    .gateway-name { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 16px; }
    .gateway-amount { font-size: 24px; font-weight: 800; font-family: 'SF Mono', 'Fira Code', monospace; margin-bottom: 8px; font-variant-numeric: tabular-nums; }
    .gateway-percent { font-size: 14px; color: var(--text-tertiary); margin-bottom: 16px; }
    .gateway-bar {
      height: 8px;
      background: var(--border);
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 12px;
    }
    .gateway-bar-fill { height: 100%; border-radius: 4px; transition: width 0.8s cubic-bezier(0.16,1,0.3,1); }
    .gateway-meta { font-size: 11px; color: var(--text-secondary); display: flex; justify-content: space-between; }
    .gateway-meta-item { display: flex; flex-direction: column; gap: 2px; }

    /* ── GRID 2 ── */
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }

    /* ── EMPTY STATE ── */
    .empty { text-align: center; padding: 48px 16px; color: var(--text-tertiary); font-size: 13px; }
    .empty strong { display: block; font-size: 16px; margin-bottom: 6px; color: var(--text-secondary); }

    /* ── TOAST ── */
    .toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px 18px;
      font-size: 13px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
      z-index: 999;
      transform: translateY(80px);
      opacity: 0;
      transition: transform 0.3s cubic-bezier(0.16,1,0.3,1), opacity 0.3s;
      max-width: calc(100vw - 32px);
    }
    .toast.show { transform: translateY(0); opacity: 1; }
    .toast.success { border-left: 3px solid var(--good); }
    .toast.error   { border-left: 3px solid var(--danger); }

    /* ── CHART ANIMATION ── */
    .chart-line-animated {
      stroke-dasharray: 3000;
      stroke-dashoffset: 3000;
      animation: drawLine 1.4s 0.2s cubic-bezier(0.16,1,0.3,1) forwards;
    }
    @keyframes drawLine { to { stroke-dashoffset: 0; } }

    /* ── DATA TABLES (clean style) ── */
    .data-table-wrap {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--bg-secondary);
    }
    .data-table-wrap table {
      border: none;
      border-radius: 0;
      width: 100%;
      border-collapse: collapse;
      border-spacing: 0;
    }
    .data-table-wrap th {
      text-align: left;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      color: var(--text-tertiary);
      padding: 12px 20px;
      border-bottom: 1px solid var(--border);
      background: var(--bg-secondary);
    }
    .data-table-wrap td {
      padding: 12px 20px;
      font-size: 13px;
      border-bottom: 1px solid rgba(255,255,255,0.04);
    }
    .data-table-wrap td[style*="text-align:right"],
    .data-table-wrap th[style*="text-align:right"] {
      font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
      font-variant-numeric: tabular-nums;
      text-align: right;
      font-weight: 600;
    }
    .data-table-wrap tbody tr:last-child td {
      border-bottom: none;
    }
    .data-table-wrap tbody tr:nth-child(even) td {
      background: rgba(255,255,255,0.03);
    }
    .data-table-wrap tbody tr:hover td {
      background: rgba(255,255,255,0.06) !important;
    }
    /* Sticky first column */
    .data-table-wrap th:first-child,
    .data-table-wrap td:first-child {
      position: sticky;
      left: 0;
      z-index: 2;
      background: var(--bg-secondary);
      border-right: 2px solid var(--border);
    }
    .data-table-wrap tbody tr:nth-child(even) td:first-child {
      background: var(--row-alt-bg, var(--bg-secondary));
    }
    /* Base cell sizing — more breathing room */
    .data-table-wrap th {
      font-size: 11px;
      padding: 10px 16px;
      white-space: nowrap;
      border-bottom: 1px solid var(--border);
    }
    .data-table-wrap td {
      font-size: 12px;
      padding: 10px 16px;
      white-space: nowrap;
      min-height: 40px;
      border-bottom: 1px solid rgba(255,255,255,0.035);
      vertical-align: middle;
    }
    .data-table-wrap tbody tr:last-child td {
      border-bottom: none;
    }
    /* Alternating rows — more visible separation */
    .data-table-wrap tbody tr:nth-child(even) {
      --row-alt-bg: rgba(255,255,255,0.04);
    }
    .data-table-wrap tbody tr:nth-child(even) td {
      background: rgba(255,255,255,0.04);
    }
    .data-table-wrap tbody tr:hover td {
      background: rgba(255,255,255,0.07) !important;
    }
    .data-table-wrap tbody tr:hover td:first-child {
      background: rgba(255,255,255,0.07) !important;
    }

    /* ── GROUP HEADER ROWS ── */
    /* These rows hold the section labels: Normal / Failed / Cancelled */
    .th-group {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 8px 16px;
      border-bottom: none;
    }
    /* Normal group — accent green */
    .th-group-normal {
      background: rgba(204,255,51,0.12);
      color: var(--accent);
    }
    /* Separator between Normal and Failed groups */
    .th-group-normal.col-sep {
      border-right: 2px solid rgba(204,255,51,0.3) !important;
    }
    /* Failed group — danger red */
    .th-group-failed {
      background: rgba(248,113,113,0.14);
      color: var(--danger);
    }
    .th-group-failed.col-sep {
      border-right: 2px solid rgba(248,113,113,0.3) !important;
    }
    /* Cancelled group — warning amber */
    .th-group-cancelled {
      background: rgba(251,191,36,0.12);
      color: var(--warning);
    }
    .th-group-cancelled.col-sep {
      border-right: 2px solid rgba(251,191,36,0.25) !important;
    }

    /* ── SUB-HEADER ROW (column labels) ── */
    .th-sub {
      border-top: 2px solid rgba(255,255,255,0.06);
    }
    .th-sub-normal {
      background: rgba(204,255,51,0.06);
      color: var(--text-secondary);
    }
    .th-sub-failed {
      background: rgba(248,113,113,0.09);
      color: var(--danger);
    }
    .th-sub-cancelled {
      background: rgba(251,191,36,0.08);
      color: var(--warning);
    }
    /* Sub-header separators mirror group separators */
    .th-sub-normal.col-sep {
      border-right: 2px solid rgba(204,255,51,0.2) !important;
    }
    .th-sub-failed.col-sep {
      border-right: 2px solid rgba(248,113,113,0.25) !important;
    }
    .th-sub-cancelled.col-sep {
      border-right: 2px solid rgba(251,191,36,0.2) !important;
    }

    /* ── NUMERIC CELLS ── */
    /* Monospace font for all tabular numbers — true alignment */
    .td-mono,
    .td-total,
    .td-failed,
    .td-failed-total,
    .td-cancelled,
    .td-cancelled-total,
    .td-mollie,
    .td-gocardless,
    .td-paypal {
      font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', 'Courier New', monospace;
      font-variant-numeric: tabular-nums;
      text-align: right;
    }
    .td-failed  { color: var(--danger); }
    .td-failed-total {
      color: var(--danger);
      font-weight: 700;
    }
    .td-cancelled { color: var(--warning); }
    .td-cancelled-total {
      color: var(--warning);
      font-weight: 700;
    }

    /* Group column separators — right border acts as section fence */
    .col-sep { border-right: 2px solid var(--border) !important; }
    /* Normal-group separator gets accent tint */
    td.col-sep:nth-child(5),
    th.col-sep:nth-child(5) {
      border-right: 2px solid rgba(204,255,51,0.18) !important;
    }
    /* Failed-group separator gets danger tint */
    td.col-sep:nth-child(7),
    th.col-sep:nth-child(7),
    td.col-sep:nth-child(9),
    th.col-sep:nth-child(9) {
      border-right: 2px solid rgba(248,113,113,0.2) !important;
    }

    /* Month label column */
    .td-month {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-primary);
      letter-spacing: 0.02em;
    }

    /* ── LIGHT-MODE OVERRIDES ── */
    :root.light-mode .data-table-wrap tbody tr:nth-child(even) td {
      background: rgba(0,0,0,0.03);
    }
    :root.light-mode .data-table-wrap tbody tr:hover td {
      background: rgba(0,0,0,0.05) !important;
    }
    :root.light-mode .th-group-normal  { background: rgba(100,160,0,0.1); color: #5a8700; }
    :root.light-mode .th-group-failed  { background: rgba(220,38,38,0.09); }
    :root.light-mode .th-group-cancelled { background: rgba(180,100,0,0.09); }
    :root.light-mode .th-sub-normal  { background: rgba(100,160,0,0.05); color: var(--text-secondary); }
    :root.light-mode .th-sub-failed  { background: rgba(220,38,38,0.05); }
    :root.light-mode .th-sub-cancelled { background: rgba(180,100,0,0.05); }
    :root.light-mode .data-table-wrap td {
      border-bottom: 1px solid rgba(0,0,0,0.05);
    }
    :root.light-mode .data-table-wrap th:first-child,
    :root.light-mode .data-table-wrap td:first-child {
      background: #F9F9F9;
      border-right: 2px solid rgba(0,0,0,0.08);
    }
    :root.light-mode .data-table-wrap tbody tr:nth-child(even) td:first-child {
      background: rgba(0,0,0,0.03);
    }

    /* ── SCROLLBAR ── */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

    /* ── RESPONSIVE ── */
    @media (max-width: 1024px) {
      .grid-2 { grid-template-columns: 1fr; }
    }
    @media (max-width: 768px) {
      .sidebar { width: 100%; padding: 12px 0; gap: 4px; flex-direction: row; flex-wrap: wrap; }
      .sidebar-item { padding: 10px 16px; font-size: 12px; }
      .layout { flex-direction: column; }
      nav { padding: 0 16px; height: auto; min-height: 56px; flex-wrap: wrap; gap: 8px; padding-top: 8px; padding-bottom: 8px; }
      .nav-brand { font-size: 10px; }
      .nav-right { gap: 8px; flex-wrap: wrap; }
      .sync-info { display: none; }
      main { padding: 24px 16px; max-width: 100%; }
      h1 { font-size: 20px; }
      .stats-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
      .stat-card { padding: 16px; }
      .stat-label { font-size: 10px; }
      .stat-value { font-size: 20px; }
      .section-title { font-size: 12px; }
      table { font-size: 12px; }
      th, td { padding: 8px 12px; }
      .grid-2 { grid-template-columns: 1fr; }
      .gateway-label { width: 90px; font-size: 11px; }
      .gateway-value { width: 80px; font-size: 11px; }
      .refresh-btn { padding: 6px 12px; font-size: 11px; }
      .logout-btn { padding: 6px 12px; font-size: 11px; }
      .chart-legend { gap: 12px; }
    }
    @media (max-width: 480px) {
      .stats-grid { grid-template-columns: 1fr; }
      .header-row { flex-direction: column; gap: 12px; }
    }
  </style>
</head>
<body>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<nav aria-label="Admin navigation">
  <div class="nav-brand">Level Up · Admin</div>
  <div class="nav-right">
    <span class="sync-info" id="sync-label">Synced: {fmtDate(lastSync)}</span>
    <button class="refresh-btn" id="sync-btn" aria-label="Sync donation data now">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
      </svg>
      Sync Now
    </button>
    <button id="theme-btn" aria-label="Toggle light/dark theme">🌙</button>
    <button class="logout-btn" id="logout-btn" aria-label="Sign out">Sign out</button>
  </div>
</nav>

<div class="layout">
  <aside class="sidebar" aria-label="Sidebar navigation">
    <a href="/admin/dashboard" class="sidebar-item active" aria-current="page">Donations</a>
    <a href="/admin/seo" class="sidebar-item">SEO</a>
    <a href="/admin/analytics" class="sidebar-item">Analytics</a>
  </aside>

  <div class="content">
    <main id="main-content">
      <div class="header-row">
        <div>
          <h1>Donations Dashboard</h1>
          <p class="subtitle">Donation revenue across all payment gateways — welevelup.org</p>
          <p class="update-info" id="update-info">Last synced: {fmtDate(lastSync)}</p>
        </div>
      </div>

      <!-- STATS GRID -->
      <div class="stats-grid" role="list" aria-label="Donation statistics">
        <div class="stat-card" role="listitem">
          <div class="stat-label">This Month</div>
          <div class="stat-value" id="stat-month">—</div>
          <div class="stat-sub">Total raised</div>
        </div>
        <div class="stat-card" role="listitem">
          <div class="stat-label">This Year</div>
          <div class="stat-value" id="stat-year">—</div>
          <div class="stat-sub">Year to date</div>
        </div>
        <div class="stat-card" role="listitem">
          <div class="stat-label">Active Subscribers</div>
          <div class="stat-value" id="stat-subs">—</div>
          <div class="stat-sub">Recurring donors</div>
        </div>
        <div class="stat-card" role="listitem">
          <div class="stat-label">New This Month</div>
          <div class="stat-value" id="stat-new">—</div>
          <div class="stat-sub">First-time donors</div>
        </div>
      </div>

      <!-- MULTI-LINE CHART -->
      <section class="section" aria-labelledby="chart-heading">
        <div class="section-title" id="chart-heading">Donations by Gateway — Last 12 Months</div>
        <div class="chart-card">
          <div class="chart-header">
            <span style="font-size:11px;color:var(--text-tertiary);">Donation count per gateway per month</span>
            <div class="chart-legend" aria-label="Chart legend">
              <div class="legend-item">
                <div class="legend-dot" style="background:var(--mollie)"></div>
                Mollie
              </div>
              <div class="legend-item">
                <div class="legend-dot" style="background:var(--gocardless)"></div>
                GoCardless
              </div>
              <div class="legend-item">
                <div class="legend-dot" style="background:var(--paypal)"></div>
                PayPal
              </div>
            </div>
          </div>
          <div class="chart-wrap">
            <svg id="multi-chart" viewBox="0 0 820 260" preserveAspectRatio="none" aria-label="Monthly donations by gateway chart" role="img">
              <title>Monthly Donations by Gateway</title>
              <defs>
                <linearGradient id="gradMollie" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#4ADE80" stop-opacity="0.15"/>
                  <stop offset="100%" stop-color="#4ADE80" stop-opacity="0"/>
                </linearGradient>
              </defs>
              <g id="chart-grid"></g>
              <g id="chart-areas"></g>
              <g id="chart-lines"></g>
              <g id="chart-dots"></g>
              <g id="chart-xlabels"></g>
              <g id="chart-ylabels"></g>
              <text id="chart-empty" x="410" y="130" text-anchor="middle" font-size="13" fill="rgba(200,200,200,0.4)" font-family="DM Sans,sans-serif">No chart data yet — run a sync</text>
            </svg>
          </div>
        </div>
      </section>

      <!-- GATEWAY BREAKDOWN BARS -->
      <section class="section" aria-labelledby="gateway-heading">
        <div class="section-title" id="gateway-heading">Revenue by Gateway (Year to Date)</div>
        <div class="gateway-grid" id="gateway-bars">
          <div class="empty">
            <strong>No data</strong>
            Run a sync to load donation data.
          </div>
        </div>
      </section>

      <!-- MONTHLY DONATION TOTALS -->
      <section class="section" aria-labelledby="monthly-heading">
        <div class="section-title" id="monthly-heading">Monthly Donation Totals</div>
        <div style="overflow-x: auto; border-radius: 10px; border: 1px solid var(--border); background: var(--bg-secondary);">
          <table id="monthly-table" style="width: 100%; border-collapse: collapse;">
            <thead>
              <tr style="background: var(--bg-secondary); border-bottom: 1px solid var(--border);">
                <th style="padding: 12px 20px; text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-tertiary);">Month</th>
                <th style="padding: 12px 20px; text-align: right; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-tertiary);">Active Subs</th>
                <th style="padding: 12px 20px; text-align: right; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-tertiary);">Recurring £</th>
                <th style="padding: 12px 20px; text-align: right; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-tertiary);">One-Off £</th>
                <th style="padding: 12px 20px; text-align: right; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-tertiary);">Total £</th>
              </tr>
            </thead>
            <tbody id="monthly-tbody">
              <tr><td colspan="5" style="padding: 48px 20px; text-align: center; color: var(--text-tertiary);">No data. Run a sync.</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- MONTHLY SUBSCRIPTION BREAKDOWN BY GATEWAY -->
      <section class="section" aria-labelledby="gateway-table-heading">
        <div class="section-title" id="gateway-table-heading">Monthly Subscription Breakdown</div>
        <div class="data-table-wrap">
          <table aria-label="Monthly subscription breakdown by gateway">
            <thead>
              <tr>
                <th scope="col">Month</th>
                <th scope="col" style="text-align:right;color:var(--mollie)">Mollie</th>
                <th scope="col" style="text-align:right;color:var(--gocardless)">GoCardless</th>
                <th scope="col" style="text-align:right;color:var(--paypal)">PayPal</th>
                <th scope="col" style="text-align:right">Total</th>
                <th scope="col" style="text-align:right">Failed</th>
                <th scope="col" style="text-align:right">Cancelled</th>
              </tr>
            </thead>
            <tbody id="gateway-tbody">
              <tr><td colspan="7"><div class="empty"><strong>No data</strong>Run a sync.</div></td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- RECENT DONATIONS -->
      <section class="section" aria-labelledby="recent-heading">
        <div class="section-title" id="recent-heading">Recent Donations</div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th scope="col">Date</th>
                <th scope="col">Amount</th>
                <th scope="col">Currency</th>
                <th scope="col">Gateway</th>
                <th scope="col">Type</th>
              </tr>
            </thead>
            <tbody id="recent-tbody">
              <tr><td colspan="5"><div class="empty"><strong>No data</strong>Run a sync.</div></td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="section">
        <div class="section-title">Cancelled Subscriptions</div>
        <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
          <table>
            <thead>
              <tr style="background: var(--bg-secondary);">
                <th scope="col">Date</th>
                <th scope="col">Amount</th>
                <th scope="col">Currency</th>
                <th scope="col">Gateway</th>
                <th scope="col">Payer</th>
              </tr>
            </thead>
            <tbody id="cancelled-tbody">
              <tr><td colspan="5"><div class="empty"><strong>No cancelled subscriptions</strong></div></td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="section">
        <div class="section-title">Failed Transactions</div>
        <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
          <table>
            <thead>
              <tr style="background: var(--bg-secondary);">
                <th scope="col">Date</th>
                <th scope="col">Amount</th>
                <th scope="col">Currency</th>
                <th scope="col">Gateway</th>
                <th scope="col">Payer</th>
              </tr>
            </thead>
            <tbody id="failed-tbody">
              <tr><td colspan="5"><div class="empty"><strong>No failed transactions</strong></div></td></tr>
            </tbody>
          </table>
        </div>
      </section>    </main>
  </div>
</div>

<script define:vars={{ donationsJSON, lastSync }}>
  // ── DATA ──────────────────────────────────────────────────
  const donations = (() => {
    try { return JSON.parse(donationsJSON); } catch { return null; }
  })();

  // ── THEME ─────────────────────────────────────────────────
  const html = document.documentElement;
  const THEME_KEY = 'admin-theme';

  function applyTheme(t) {
    if (t === 'light') {
      html.classList.add('light-mode');
      const btn = document.getElementById('theme-btn');
      if (btn) btn.textContent = '☀️';
    } else {
      html.classList.remove('light-mode');
      const btn = document.getElementById('theme-btn');
      if (btn) btn.textContent = '🌙';
    }
  }
  applyTheme(localStorage.getItem(THEME_KEY) || 'dark');

  document.getElementById('theme-btn')?.addEventListener('click', () => {
    const isLight = html.classList.toggle('light-mode');
    const next = isLight ? 'light' : 'dark';
    localStorage.setItem(THEME_KEY, next);
    const btn = document.getElementById('theme-btn');
    if (btn) btn.textContent = isLight ? '☀️' : '🌙';
    if (donations?.monthlyTotals?.length) drawMultiChart(donations.monthlyTotals);
    if (donations?.byGateway) drawGatewayBars(donations.byGateway);
  });

  // ── HELPERS ───────────────────────────────────────────────
  function fmt(n) {
    return '£' + Number(n || 0).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  function fmtNum(n) {
    return Number(n || 0).toLocaleString('en-GB');
  }
  function cssVar(name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }

  // ── TOAST ─────────────────────────────────────────────────
  function showToast(msg, type) {
    const t = document.getElementById('toast');
    if (!t) return;
    t.textContent = msg;
    t.className = 'toast ' + (type || 'success') + ' show';
    setTimeout(() => { t.classList.remove('show'); }, 3500);
  }

  // ── STATS ─────────────────────────────────────────────────
  function populateStats(d) {
    const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
    if (!d) {
      set('stat-month', '—'); set('stat-year', '—');
      set('stat-subs', '—'); set('stat-new', '—');
      return;
    }
    set('stat-month', fmt(d.totalMonth));
    set('stat-year',  fmt(d.totalYear));
    set('stat-subs',  fmtNum(d.activeSubscribers));
    set('stat-new',   fmtNum(d.newThisMonth));
  }

  // ── MULTI-LINE CHART ──────────────────────────────────────
  function drawMultiChart(rows) {
    const empty = document.getElementById('chart-empty');
    if (!rows || rows.length < 2) {
      if (empty) empty.style.display = '';
      return;
    }
    if (empty) empty.style.display = 'none';

    const W = 820, H = 260, PL = 44, PR = 20, PT = 20, PB = 44;
    const gW = W - PL - PR;
    const gH = H - PT - PB;

    const mollieC    = cssVar('--mollie')     || '#4ADE80';
    const gcC        = cssVar('--gocardless') || '#FBBF24';
    const paypalC    = cssVar('--paypal')     || '#F87171';
    const mutedC     = cssVar('--text-tertiary') || 'rgba(200,200,200,0.4)';
    const faintC     = cssVar('--border')     || 'rgba(255,255,255,0.06)';

    const allCounts = rows.flatMap(r => [r.mollie_count || 0, r.gocardless_count || 0, r.paypal_count || 0]);
    const maxVal = Math.max(...allCounts, 1);
    const gridLines = 4;

    function xOf(i) { return PL + (i / (rows.length - 1)) * gW; }
    function yOf(v) { return PT + gH - (v / maxVal) * gH; }

    // Grid
    let gridSvg = '';
    for (let i = 0; i <= gridLines; i++) {
      const y = PT + (i / gridLines) * gH;
      const val = Math.round(maxVal * (1 - i / gridLines));
      gridSvg += `<line x1="${PL}" y1="${y}" x2="${W - PR}" y2="${y}" stroke="${faintC}" stroke-width="1"/>`;
      gridSvg += `<text x="${PL - 5}" y="${y + 4}" font-size="9" fill="${mutedC}" text-anchor="end" font-family="DM Sans,sans-serif">${val}</text>`;
    }

    // Month labels
    const monthNames = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const step = rows.length > 8 ? 2 : 1;
    let xlabels = '';
    rows.forEach((r, i) => {
      if (i % step !== 0 && i !== rows.length - 1) return;
      const mm = (r.month || '').slice(5);
      const label = monthNames[parseInt(mm, 10)] || mm;
      xlabels += `<text x="${xOf(i)}" y="${H - 8}" font-size="10" fill="${mutedC}" text-anchor="middle" font-family="DM Sans,sans-serif">${label}</text>`;
    });

    // Build polyline points for each gateway
    function buildPoints(key) {
      return rows.map((r, i) => `${xOf(i)},${yOf(r[key] || 0)}`).join(' ');
    }

    const molliePoints   = buildPoints('mollie_count');
    const gcPoints       = buildPoints('gocardless_count');
    const paypalPoints   = buildPoints('paypal_count');

    // Dots with tooltips
    function buildDots(key, color) {
      return rows.map((r, i) => {
        const v = r[key] || 0;
        const month = (r.month || '').slice(0, 7);
        const label = key.replace('_count', '');
        return `<circle cx="${xOf(i)}" cy="${yOf(v)}" r="3.5" fill="${color}" stroke="var(--bg-secondary)" stroke-width="2"><title>${month} ${label}: ${v} donations</title></circle>`;
      }).join('');
    }

    document.getElementById('chart-grid').innerHTML = gridSvg;
    document.getElementById('chart-xlabels').innerHTML = xlabels;
    document.getElementById('chart-ylabels').innerHTML = '';
    document.getElementById('chart-areas').innerHTML = '';

    // Lines — GoCardless and PayPal dashed, Mollie solid (primary)
    document.getElementById('chart-lines').innerHTML = `
      <polyline points="${paypalPoints}"   fill="none" stroke="${paypalC}"  stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="5,3" opacity="0.85"/>
      <polyline points="${gcPoints}"       fill="none" stroke="${gcC}"      stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="8,3" opacity="0.85"/>
      <polyline points="${molliePoints}"   fill="none" stroke="${mollieC}"  stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="chart-line-animated"/>
    `;
    document.getElementById('chart-dots').innerHTML =
      buildDots('paypal_count',    paypalC) +
      buildDots('gocardless_count', gcC) +
      buildDots('mollie_count',    mollieC);

    // Trigger line animation reset
    const lines = document.querySelectorAll('.chart-line-animated');
    lines.forEach(l => {
      l.style.animation = 'none';
      l.getBoundingClientRect();
      l.style.animation = '';
    });
  }

  // ── GATEWAY CARDS ──────────────────────────────────────────
  function drawGatewayBars(byGateway) {
    const container = document.getElementById('gateway-bars');
    if (!container) return;
    if (!byGateway || (byGateway.mollie === 0 && byGateway.gocardless === 0 && byGateway.paypal === 0)) {
      container.innerHTML = '<div class="empty"><strong>No data</strong>Run a sync to load donation data.</div>';
      return;
    }

    const gateways = [
      { label: 'Mollie',       value: byGateway.mollie || 0,      color: 'var(--mollie)' },
      { label: 'GoCardless',   value: byGateway.gocardless || 0,  color: 'var(--gocardless)' },
      { label: 'PayPal',       value: byGateway.paypal || 0,      color: 'var(--paypal)' },
    ];
    const total = gateways.reduce((s, g) => s + g.value, 0) || 1;

    container.innerHTML = gateways.map(g => {
      const pct = Math.round((g.value / total) * 100);
      return `
        <div class="gateway-card">
          <div class="gateway-name" style="color:${g.color}">${g.label}</div>
          <div class="gateway-amount">${fmt(g.value)}</div>
          <div class="gateway-percent">${pct}% of total</div>
          <div class="gateway-bar">
            <div class="gateway-bar-fill" style="width:${pct}%;background:${g.color}"></div>
          </div>
          <div class="gateway-meta">
            <div class="gateway-meta-item">
              <span style="font-size:10px;text-transform:uppercase;letter-spacing:0.05em;opacity:0.7">Year to Date</span>
              <span style="font-weight:600">${fmt(g.value)}</span>
            </div>
          </div>
        </div>`;
    }).join('');
  }

  // ── MONTHLY TOTALS TABLE ──────────────────────────────────
  function populateMonthlyTable(rows) {
    const tbody = document.getElementById('monthly-tbody');
    if (!tbody) return;
    if (!rows || !rows.length) {
      tbody.innerHTML = '<tr><td colspan="5" style="padding: 48px 20px; text-align: center; color: var(--text-tertiary); font-size: 13px;"><strong>No data</strong><br/>Run a sync to load donation data.</td></tr>';
      return;
    }
    tbody.innerHTML = [...rows].reverse().map(m => {
      const lbl = (m.month || '').slice(0, 7);
      const recurring = m.monthly_donations ?? 0;
      const oneoff = m.one_off_donations ?? 0;
      const total = m.total ?? 0;
      return `<tr style="border-bottom: 1px solid rgba(255,255,255,0.04);">
        <td style="padding: 12px 20px; font-size: 13px;">${lbl}</td>
        <td style="padding: 12px 20px; font-size: 13px; text-align: right; font-family: 'SF Mono', monospace; font-variant-numeric: tabular-nums;">${m.active_subscribers ?? 0}</td>
        <td style="padding: 12px 20px; font-size: 13px; text-align: right; font-family: 'SF Mono', monospace; font-variant-numeric: tabular-nums;">${fmt(recurring)}</td>
        <td style="padding: 12px 20px; font-size: 13px; text-align: right; font-family: 'SF Mono', monospace; font-variant-numeric: tabular-nums;">${fmt(oneoff)}</td>
        <td style="padding: 12px 20px; font-size: 13px; text-align: right; font-family: 'SF Mono', monospace; font-variant-numeric: tabular-nums; font-weight: 600;">${fmt(total)}</td>
      </tr>`;
    }).join('');
  }

  // ── GATEWAY TABLE ─────────────────────────────────────────
  function populateGatewayTable(rows) {
    const tbody = document.getElementById('gateway-tbody');
    if (!tbody) return;
    if (!rows || !rows.length) {
      tbody.innerHTML = '<tr><td colspan="13"><div class="empty"><strong>No data</strong>Run a sync.</div></td></tr>';
      return;
    }
    tbody.innerHTML = [...rows].reverse().map(m => {
      const monthLabel = (m.month || '').slice(0, 7);
      const total = (m.mollie_count ?? 0) + (m.gocardless_count ?? 0) + (m.paypal_count ?? 0);
      const failedTotal = (m.failed_mollie ?? 0) + (m.failed_gocardless ?? 0) + (m.failed_paypal ?? 0);
      const cancelledTotal = (m.cancelled_mollie ?? 0) + (m.cancelled_gocardless ?? 0) + (m.cancelled_paypal ?? 0);
      return `<tr>
        <td class="td-month">${monthLabel}</td>
        <td class="td-mollie">${m.mollie_count ?? 0}</td>
        <td class="td-gocardless">${m.gocardless_count ?? 0}</td>
        <td class="td-paypal">${m.paypal_count ?? 0}</td>
        <td class="td-total col-sep">${total}</td>
        <td class="td-failed">${m.failed_mollie ?? 0}</td>
        <td class="td-failed">${m.failed_gocardless ?? 0}</td>
        <td class="td-failed">${m.failed_paypal ?? 0}</td>
        <td class="td-failed-total col-sep">${failedTotal}</td>
        <td class="td-cancelled">${m.cancelled_mollie ?? 0}</td>
        <td class="td-cancelled">${m.cancelled_gocardless ?? 0}</td>
        <td class="td-cancelled">${m.cancelled_paypal ?? 0}</td>
        <td class="td-cancelled-total">${cancelledTotal}</td>
      </tr>`;
    }).join('');
  }

  // ── RECENT DONATIONS TABLE ────────────────────────────────
  function populateRecentTable(recents) {
    const tbody = document.getElementById('recent-tbody');
    if (!tbody) return;
    if (!recents || !recents.length) {
      tbody.innerHTML = '<tr><td colspan="5"><div class="empty"><strong>No data</strong>Run a sync.</div></td></tr>';
      return;
    }
    const gwColor = { mollie: 'var(--mollie)', gocardless: 'var(--gocardless)', paypal: 'var(--paypal)' };
    tbody.innerHTML = recents.map(d => {
      const dateStr = d.date ? new Date(d.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
      const color = gwColor[d.gateway] || 'var(--text-secondary)';
      const amtStr = (d.currency === 'GBP' ? '£' : (d.currency === 'EUR' ? '€' : '$')) +
        Number(d.amount || 0).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      return `<tr>
        <td>${dateStr}</td>
        <td class="td-mono" style="font-weight:700;color:var(--accent)">${amtStr}</td>
        <td style="font-size:11px;color:var(--text-tertiary)">${d.currency || '—'}</td>
        <td style="font-weight:600;color:${color};text-transform:capitalize">${d.gateway || '—'}</td>
        <td>${d.type === 'recurring' ? '<span class="badge badge-recurring">Recurring</span>' : '<span style="font-size:11px;color:var(--text-tertiary)">One-off</span>'}</td>
      </tr>`;
    }).join('');
  }

  // ── SYNC BUTTON ───────────────────────────────────────────
  document.getElementById('sync-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('sync-btn');
    if (!btn) return;
    btn.disabled = true;
    btn.innerHTML = `
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true" style="animation:spin 1s linear infinite">
        <path d="M21 12a9 9 0 1 1-3-6.7"/>
      </svg>
      Syncing…`;
    const style = document.createElement('style');
    style.textContent = '@keyframes spin{to{transform:rotate(360deg)}}';
    document.head.appendChild(style);
    try {
      const res = await fetch('/api/admin-sync', { method: 'POST' });
      if (res.ok) {
        showToast('Sync complete — reloading…', 'success');
        setTimeout(() => location.reload(), 1200);
      } else {
        showToast('Sync failed (' + res.status + ')', 'error');
        btn.disabled = false;
        btn.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg> Sync Now`;
      }
    } catch (e) {
      showToast('Error: ' + e.message, 'error');
      btn.disabled = false;
      btn.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg> Sync Now`;
    }
  });

  // ── LOGOUT ────────────────────────────────────────────────
  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await fetch('/api/admin-login', { method: 'DELETE' }).catch(() => {});
    location.href = '/admin';
  });

  function populateCancelledTable(cancelled) {
    const tbody = document.getElementById('cancelled-tbody');
    if (!tbody) return;
    if (!cancelled || !cancelled.length) {
      tbody.innerHTML = '<tr><td colspan="5"><div class="empty"><strong>No cancelled subscriptions</strong></div></td></tr>';
      return;
    }
    const gwColor = { mollie: 'var(--mollie)', gocardless: 'var(--gocardless)', paypal: 'var(--paypal)' };
    tbody.innerHTML = cancelled.map(d => {
      const dateStr = d.date ? new Date(d.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
      const color = gwColor[d.gateway] || 'var(--text-secondary)';
      const amtStr = (d.currency === 'GBP' ? '£' : (d.currency === 'EUR' ? '€' : '$')) +
        Number(d.amount || 0).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      return `<tr>
        <td>${dateStr}</td>
        <td class="td-mono" style="font-weight:700;color:var(--accent)">${amtStr}</td>
        <td style="font-size:11px;color:var(--text-tertiary)">${d.currency || '—'}</td>
        <td style="font-weight:600;color:${color};text-transform:capitalize">${d.gateway || '—'}</td>
        <td style="font-size:11px;color:var(--text-tertiary)">${d.payer || '—'}</td>
      </tr>`;
    }).join('');
  if (donations?.cancelledSubscriptions?.length) {
    populateCancelledTable(donations.cancelledSubscriptions);
  } else {
    populateCancelledTable(null);
  }
  if (donations?.failedTransactions?.length) {
    populateFailedTable(donations.failedTransactions);
  } else {
    populateFailedTable(null);
  }
  }

  function populateFailedTable(failed) {
    const tbody = document.getElementById('failed-tbody');
    if (!tbody) return;
    if (!failed || !failed.length) {
      tbody.innerHTML = '<tr><td colspan="5"><div class="empty"><strong>No failed transactions</strong></div></td></tr>';
      return;
    }
    const gwColor = { mollie: 'var(--mollie)', gocardless: 'var(--gocardless)', paypal: 'var(--paypal)' };
    tbody.innerHTML = failed.map(d => {
      const dateStr = d.date ? new Date(d.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
      const color = gwColor[d.gateway] || 'var(--text-secondary)';
      const amtStr = (d.currency === 'GBP' ? '£' : (d.currency === 'EUR' ? '€' : '$')) +
        Number(d.amount || 0).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      return `<tr>
        <td>${dateStr}</td>
        <td class="td-mono" style="font-weight:700;color:var(--danger)">${amtStr}</td>
        <td style="font-size:11px;color:var(--text-tertiary)">${d.currency || '—'}</td>
        <td style="font-weight:600;color:${color};text-transform:capitalize">${d.gateway || '—'}</td>
        <td style="font-size:11px;color:var(--text-tertiary)">${d.payer || '—'}</td>
      </tr>`;
    }).join('');
  }
  function populateCancelledTable(cancelled) {
    const tbody = document.getElementById('cancelled-tbody');
    if (!tbody) return;
    if (!cancelled || !cancelled.length) {
      tbody.innerHTML = '<tr><td colspan="5"><div class="empty"><strong>No cancelled subscriptions</strong></div></td></tr>';
      return;
    }
    const gwColor = { mollie: 'var(--mollie)', gocardless: 'var(--gocardless)', paypal: 'var(--paypal)' };
    tbody.innerHTML = cancelled.map(d => {
      const dateStr = d.date ? new Date(d.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
      const color = gwColor[d.gateway] || 'var(--text-secondary)';
      const amtStr = (d.currency === 'GBP' ? '£' : (d.currency === 'EUR' ? '€' : '$')) +
        Number(d.amount || 0).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      return `<tr>
        <td>${dateStr}</td>
        <td class="td-mono" style="font-weight:700;color:var(--accent)">${amtStr}</td>
        <td style="font-size:11px;color:var(--text-tertiary)">${d.currency || '—'}</td>
        <td style="font-weight:600;color:${color};text-transform:capitalize">${d.gateway || '—'}</td>
        <td style="font-size:11px;color:var(--text-tertiary)">${d.payer || '—'}</td>
      </tr>`;
    }).join('');
  }

  function populateFailedTable(failed) {
    const tbody = document.getElementById('failed-tbody');
    if (!tbody) return;
    if (!failed || !failed.length) {
      tbody.innerHTML = '<tr><td colspan="5"><div class="empty"><strong>No failed transactions</strong></div></td></tr>';
      return;
    }
    const gwColor = { mollie: 'var(--mollie)', gocardless: 'var(--gocardless)', paypal: 'var(--paypal)' };
    tbody.innerHTML = failed.map(d => {
      const dateStr = d.date ? new Date(d.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
      const color = gwColor[d.gateway] || 'var(--text-secondary)';
      const amtStr = (d.currency === 'GBP' ? '£' : (d.currency === 'EUR' ? '€' : '$')) +
        Number(d.amount || 0).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      return `<tr>
        <td>${dateStr}</td>
        <td class="td-mono" style="font-weight:700;color:var(--danger)">${amtStr}</td>
        <td style="font-size:11px;color:var(--text-tertiary)">${d.currency || '—'}</td>
        <td style="font-weight:600;color:${color};text-transform:capitalize">${d.gateway || '—'}</td>
        <td style="font-size:11px;color:var(--text-tertiary)">${d.payer || '—'}</td>
      </tr>`;
    }).join('');
  }

  // ── INITIALISE ────────────────────────────────────────────
  populateStats(donations);
  if (donations?.monthlyTotals?.length) {
    drawMultiChart(donations.monthlyTotals);
    populateMonthlyTable(donations.monthlyTotals);
    populateGatewayTable(donations.monthlyTotals);
  } else {
    populateMonthlyTable(null);
    populateGatewayTable(null);
  }
  if (donations?.byGateway) {
    drawGatewayBars(donations.byGateway);
  }
  if (donations?.recentDonations?.length) {
    populateRecentTable(donations.recentDonations);
  } else {
    populateRecentTable(null);
  }
  if (donations?.cancelledSubscriptions?.length) {
    populateCancelledTable(donations.cancelledSubscriptions);
  } else {
    populateCancelledTable(null);
  }
  if (donations?.failedTransactions?.length) {
    populateFailedTable(donations.failedTransactions);
  } else {
    populateFailedTable(null);
  }
</script>
</body>
</html>
