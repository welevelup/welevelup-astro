---
// Roughly 2:5 two-column grid per the style guide's "Grids" page.
// Collapses to one left-aligned column on mobile.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`ds-grid-25 ${className}`}>
  <div class="ds-grid-25-narrow"><slot name="narrow" /></div>
  <div class="ds-grid-25-wide"><slot name="wide" /></div>
</div>

<style>
  .ds-grid-25 {
    display: grid;
    grid-template-columns: var(--grid-25-cols);
    gap: var(--space-8);
    text-align: left;
  }
  /* Each slot is wrapped in its own div so multiple child elements passed
     into one slot (e.g. a Headline + a Collage) stay together as a single
     grid column instead of each becoming its own auto-placed grid cell. */
  .ds-grid-25-narrow, .ds-grid-25-wide {
    min-width: 0;
  }
  @media (max-width: 768px) {
    .ds-grid-25 {
      grid-template-columns: 1fr;
    }
  }
</style>
