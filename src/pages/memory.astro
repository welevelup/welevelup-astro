---
/**
 * Memory Space — hub page, rebuilt on the design system.
 * Real content preserved verbatim — see git history for the pre-rebuild
 * "editorial dark-luxury bento" version.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/design-system/Header.astro';
import Section from '../components/design-system/Section.astro';
import Headline from '../components/design-system/Headline.astro';
import Label from '../components/design-system/Label.astro';
import Button from '../components/design-system/Button.astro';
import ActionCard from '../components/design-system/ActionCard.astro';
import Footer from '../components/design-system/Footer.astro';

const SECTIONS = [
  { bg: 'navy' as const, text: 'off-white' as const, title: 'Abortion Stories', description: 'Real experiences, told anonymously. These stories push back against shame and silence — because abortion is healthcare, and your story belongs to you.', href: '/memory/abortion-stories' },
  { bg: 'electric-yellow' as const, text: 'navy' as const, title: 'Solidarity Messages', description: 'Messages sent directly to Carla Foster, Rianna Cleary, Louise Powell, and others the system tried to punish for their choices. Proof that they are not alone.', href: '/memory/solidarity' },
  { bg: 'gentle-lilac' as const, text: 'navy' as const, title: 'Hair Stories', description: 'Black women share what using hair relaxers has meant for their health, identity, and lives. Real voices demanding change.', href: '/memory/hair-stories' },
  { bg: 'off-white' as const, text: 'navy' as const, title: 'Holloway Voices', description: "Women, allies, and professionals share what a Holloway Women's Centre would mean. A promise made — and not yet kept.", href: '/memory/holloway-stories' },
];

const FRAGMENTS = [
  { quote: "I was 19 and completely alone. No one told me I could get support. Writing this down is the first time I've said it out loud.", caption: 'Anonymous — Abortion Stories' },
  { quote: 'Carla — I wept when I read what happened to you. You are not a criminal. You are a mother. We stand with you.', caption: 'Solidarity message to Carla Foster' },
  { quote: "The hardest thing wasn't the procedure. It was the silence that came after it — the feeling that I had no one to tell.", caption: 'Anonymous — Abortion Stories' },
  { quote: "I've been campaigning for reproductive rights for eleven years. I still find it hard to talk about my own experience. That is the power of shame — and why this space matters.", caption: 'Hair Stories' },
  { quote: 'Rianna — the system failed you. We will not forget your name. You deserved care, not prosecution.', caption: 'Solidarity message to Rianna Cleary' },
];
---
<Layout
  headHtml=""
  title="Memory Space | Stories of Resistance | Level Up"
  description="An archive of personal stories, solidarity messages, and voices of resistance. Abortion stories, hair stories, Holloway voices — told in their own words."
>
  <Header />

  <Section bg="navy">
    <Label color="gentle-lilac">Memory Space</Label>
    <Headline color="electric-yellow">A Space to Remember, to Resist</Headline>
    <p style="color: var(--color-off-white); opacity: 0.85; max-width: 62ch;">This is where personal experience lives alongside grief, solidarity, and resistance. Abortion stories told in your own words. Messages of support sent to women the state tried to silence. Hair stories that refuse to be forgotten. Together, they form an archive of what it means to fight for your body and your freedom.</p>
  </Section>

  <Section bg="off-white">
    <div class="mm-cards">
      {SECTIONS.map((s) => (
        <ActionCard bg={s.bg} text={s.text} title={s.title} description={s.description} href={s.href} />
      ))}
    </div>
  </Section>

  <Section bg="navy">
    <Label color="gentle-lilac">Voices from the archive</Label>
    <div class="mm-fragments">
      {FRAGMENTS.map((f) => (
        <figure class="mm-fragment">
          <blockquote>{f.quote}</blockquote>
          <figcaption>{f.caption}</figcaption>
        </figure>
      ))}
    </div>
  </Section>

  <Section bg="pale-yellow">
    <div class="mm-about">
      <div class="mm-about-heading">
        <Headline as="h2">Why this space exists</Headline>
        <a href="https://levelup.yourmovement.org/p/join-us" class="mm-about-link" target="_blank" rel="noopener">Add your story →</a>
      </div>
      <div class="mm-about-body">
        <p>Too many experiences are buried — lost to shame, to fear of judgement, to a culture that treats women's bodies as political territory rather than human lives. Memory Space exists because forgetting is a form of erasure.</p>
        <p>When the state prosecutes a woman for her pregnancy outcome, the cruelest part is the isolation. Solidarity messages break that isolation. When abortion is treated as something unspeakable, anonymous stories dismantle that silence one truth at a time.</p>
        <p>This archive is not passive. It is a record of what happened — and a refusal to let it be normal.</p>
      </div>
    </div>
  </Section>

  <Section bg="navy">
    <div class="mm-cta">
      <Headline as="h2" color="electric-yellow">Join the Level Up community</Headline>
      <p style="color: var(--color-off-white); opacity: 0.75; max-width: 480px; margin-inline: auto;">Campaign updates, event invitations, and feminist thinking.</p>
      <Button bg="electric-yellow" text="navy" href="https://levelup.yourmovement.org/p/join-us" label="Join us" />
    </div>
  </Section>

  <Footer bg="navy" />
</Layout>

<style>
  .mm-cards {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mm-fragments {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .mm-fragment {
    background: rgba(238,235,211,0.06);
    border: 1px solid rgba(238,235,211,0.12);
    padding: var(--space-6);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .mm-fragment blockquote {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-off-white);
  }
  .mm-fragment figcaption {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gentle-lilac);
  }

  .mm-about {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-10);
    align-items: start;
  }
  .mm-about-heading { display: flex; flex-direction: column; gap: var(--space-4); }
  .mm-about-link {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-navy);
    text-decoration: none;
    border-bottom: 2px solid var(--color-loud-lilac);
    padding-bottom: 2px;
    display: inline-block;
    width: fit-content;
  }
  .mm-about-link:hover { color: var(--color-loud-lilac); }
  .mm-about-body { display: flex; flex-direction: column; gap: var(--space-4); }
  .mm-about-body p { font-family: var(--font-body); color: var(--color-navy); opacity: 0.75; margin: 0; font-size: 1.0625rem; line-height: 1.7; }

  .mm-cta { text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-4); }

  @media (max-width: 768px) {
    .mm-fragments { grid-template-columns: 1fr; }
    .mm-about { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>
