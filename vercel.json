          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=*"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.mollie.com https://www.googletagmanager.com https://connect.facebook.net https://www.facebook.com https://challenges.cloudflare.com https://browser.sentry-cdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' wss://js.mollie.com wss://ws-eu.pusher.com https://*.pusher.com https://*.sentry.io https://*.browser-intake-datadoghq.eu https://pay.google.com https://google.com https://www.google.com https://api.mollie.com https://www.mollie.com https://*.mollie.com https://*.google-analytics.com https://www.facebook.com https://connect.facebook.net https://challenges.cloudflare.com; frame-src https://*.mollie.com https://pay.mollie.nl https://pay.mollie.com https://js.mollie.com https://www.youtube.com https://www.youtube-nocookie.com https://challenges.cloudflare.com https://www.google.com https://www.paypal.com; object-src 'none'; base-uri 'self'; form-action 'self' https://app.mollie.com https://www.mollie.com; frame-ancestors 'none';"
        }
