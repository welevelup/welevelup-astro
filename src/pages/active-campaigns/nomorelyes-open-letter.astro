  .nol-prose p { margin: 0 0 var(--space-4); }
  .nol-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-6); text-align: center; }
  .nol-stat { display: flex; flex-direction: column; gap: var(--space-2); }
  .nol-stat-value { font-family: var(--font-headline); font-size: var(--text-headline); color: var(--color-navy); line-height: 1; }
  .nol-stat-caption { font-family: var(--font-body); color: var(--color-navy); }
  .nol-demands { display: flex; flex-direction: column; gap: var(--space-8); margin-top: var(--space-8); }
  .nol-demand { display: flex; gap: var(--space-4); }
  .nol-demand-num { font-family: var(--font-headline); font-size: var(--text-subheadline); color: var(--color-electric-yellow); flex-shrink: 0; }
  .nol-demand-title { font-family: var(--font-headline); font-size: var(--text-body); color: var(--color-off-white); margin: 0 0 var(--space-2); }
  .nol-demand-desc { color: var(--color-off-white); opacity: 0.85; margin: 0; max-width: 68ch; }
  .nol-pullquote { font-family: var(--font-headline); font-size: var(--text-subheadline); color: var(--color-navy); max-width: 20ch; margin: 0 0 var(--space-6); border: none; padding: 0; }
  .nol-sign-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); }
  .nol-recent-signers { margin-top: var(--space-6); background: var(--color-pale-yellow); padding: var(--space-4); border-radius: var(--radius-card); }
  .nol-recent-label { font-weight: 700; margin: 0 0 var(--space-2); }
  .nol-recent-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-2); }
