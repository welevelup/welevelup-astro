---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { extract } from '../lib/extractHtml';
import homeRaw from '../_clone/index.html?raw';
const { headInner, bodyClass } = extract(homeRaw);
---
<Layout
  headHtml={headInner}
  bodyClass={bodyClass}
  title="Contact Level Up"
  description="Get in touch with Level Up. We'd love to hear from you. Email us at hello@welevelup.org or send a message via our contact form."
>
  <Nav />

  <section class="ct-hero">
    <div class="ct-hero-inner">
      <h1 class="ct-title">Contact Level Up</h1>
    </div>
  </section>

  <section class="ct-content">
    <div class="ct-grid">
      <!-- INFO -->
      <div class="ct-info">
        <h2 class="ct-info-heading">Get in touch with the Level Up team</h2>
        <p class="ct-info-intro">We're a UK-based feminist campaigning organisation working to end bodily and systemic violence. If you're a journalist, supporter, potential partner, or someone with a campaign idea — we'd love to hear from you.</p>

        <div class="ct-info-block">
          <p class="ct-info-label">For media enquiries:</p>
          <a href="mailto:media@welevelup.org" class="ct-info-email">media@welevelup.org</a>
        </div>
        <div class="ct-info-block">
          <p class="ct-info-label">Got a campaign idea, or just want to say hi?</p>
          <a href="mailto:hello@welevelup.org" class="ct-info-email">hello@welevelup.org</a>
        </div>
        <div class="ct-info-block">
          <p class="ct-info-label">Work with us</p>
          <a href="mailto:hello@welevelup.org" class="ct-info-email">hello@welevelup.org</a>
        </div>
        <div class="ct-info-block">
          <p class="ct-info-label">Address</p>
          <p class="ct-info-address">3rd Floor 86 – 90 Paul Street<br/>London<br/>EC2A 4NE</p>
        </div>
      </div>

      <!-- FORM -->
      <div class="ct-form-wrap">
        <form class="ct-form" action="mailto:hello@welevelup.org" method="POST" enctype="text/plain">
          <div class="ct-form-row">
            <label>
              <span>Name</span>
              <input type="text" name="name" required autocomplete="given-name" />
            </label>
            <label>
              <span>Last Name</span>
              <input type="text" name="last_name" autocomplete="family-name" />
            </label>
          </div>
          <label>
            <span>Email <em class="ct-required">*</em></span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label>
            <span>Post Body <em class="ct-required">*</em></span>
            <textarea name="message" rows="8" required></textarea>
          </label>
          <button type="submit">Send message</button>
        </form>
      </div>
    </div>
  </section>

  <section class="ct-cta">
    <h2>Join the Level Up community</h2>
    <p>Campaign updates, event invitations, and feminist thinking — straight to your inbox.</p>
    <a href="https://levelup.yourmovement.org/p/join-us" class="ct-cta-btn" target="_blank" rel="noopener">Join us</a>
  </section>

  <Footer />
</Layout>

<style is:global>
  .ct-hero {
    background: #0C0A3E;
    padding: 80px 24px 64px;
    font-family: 'DM Sans', sans-serif;
  }
  .ct-hero-inner { max-width: 900px; margin: 0 auto; }
  .ct-title {
    font: 800 clamp(48px, 10vw, 96px)/0.88 'DM Sans';
    color: #EEEBD3 !important;
    letter-spacing: -0.04em;
    margin: 0;
    text-transform: uppercase;
  }

  .ct-content {
    background: #fff;
    padding: 72px 24px;
    font-family: 'DM Sans', sans-serif;
  }
  .ct-grid {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 80px;
    align-items: start;
  }

  /* Info column */
  .ct-info { display: flex; flex-direction: column; }
  .ct-info-heading {
    font: 700 22px/1.2 'DM Sans' !important;
    color: #0C0A3E !important;
    letter-spacing: -0.01em;
    margin: 0 0 20px !important;
  }
  .ct-info-intro {
    font: 400 16px/1.65 'DM Sans' !important;
    color: rgba(12,10,62,0.75) !important;
    margin: 0 0 40px !important;
  }
  .ct-info-block {
    padding: 20px 0;
    border-top: 1px solid rgba(12,10,62,0.1);
  }
  .ct-info-label {
    font: 400 14px/1.4 'DM Sans' !important;
    color: rgba(12,10,62,0.55) !important;
    margin: 0 0 6px !important;
  }
  .ct-info-email {
    font: 700 16px/1 'DM Sans' !important;
    color: #0C0A3E !important;
    text-decoration: none !important;
  }
  .ct-info-email:hover { color: #A89CED !important; }
  .ct-info-address {
    font: 400 14px/1.6 'DM Sans' !important;
    color: rgba(12,10,62,0.7) !important;
    margin: 0 !important;
  }

  /* Form column */
  .ct-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .ct-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .ct-form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ct-form label span {
    font: 600 13px/1 'DM Sans';
    color: #0C0A3E;
  }
  .ct-required {
    font-style: normal;
    color: #C0392B;
    margin-left: 2px;
  }
  .ct-form input, .ct-form textarea {
    font: 400 15px/1.4 'DM Sans';
    padding: 12px 14px;
    border: 1px solid rgba(12,10,62,0.18);
    background: #fff;
    color: #0C0A3E;
    transition: border-color 0.15s;
  }
  .ct-form input:focus, .ct-form textarea:focus {
    outline: none;
    border-color: #0C0A3E !important;
  }
  .ct-form button {
    font: 700 13px/1 'DM Sans';
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: #CCFF33;
    color: #0C0A3E;
    border: none;
    padding: 18px 36px;
    cursor: pointer;
    transition: background 0.15s;
    align-self: flex-start;
    margin-top: 4px;
  }
  .ct-form button:hover { background: #0C0A3E; color: #CCFF33 !important; }

  .ct-cta {
    background: #0C0A3E;
    padding: 80px 24px;
    text-align: center;
    font-family: 'DM Sans';
  }
  .ct-cta h2 { font: 800 40px/0.9 'DM Sans'; color: #CCFF33 !important; letter-spacing: -0.04em; margin: 0 0 16px; }
  .ct-cta p { font: 400 17px/1.5 'DM Sans'; color: rgba(238,235,211,0.6); max-width: 440px; margin: 0 auto 32px; }
  .ct-cta-btn { display: inline-block; background: #CCFF33; color: #0C0A3E; font: 700 14px/1 'DM Sans'; text-transform: uppercase; letter-spacing: 0.08em; padding: 18px 40px; text-decoration: none; }
  .ct-cta-btn:hover { background: #fff; }

  @media (max-width: 768px) {
    .ct-grid { grid-template-columns: 1fr; gap: 48px; }
    .ct-form-row { grid-template-columns: 1fr; }
  }
</style>
