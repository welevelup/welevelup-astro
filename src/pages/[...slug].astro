---
/**
 * Catch-all that serves every cloned WordPress page (except the home, which
 * has its own src/pages/index.astro).
 *
 * At build time, src/lib/cloneManifest walks src/_clone/ and returns one
 * CloneRoute per index.html. Each route reads its source HTML, pulls out
 * head + body + bodyClass via extract(), and renders through Layout.
 */
import { readFileSync } from 'node:fs';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { extract } from '../lib/extractHtml';
import { getCloneRoutes } from '../lib/cloneManifest';

export async function getStaticPaths() {
  return getCloneRoutes().map(({ slug, file }) => ({
    params: { slug },
    props: { file },
  }));
}

const slugMeta: Record<string, { title: string; description: string }> = {
  'about-us': {
    title: 'About Level Up | Feminist Campaigning Organisation',
    description: 'Level Up is a UK-based feminist community campaigning for gender justice — from abortion rights to ending pregnancy in prison. Find out who we are and what drives us.',
  },
  'our-team': {
    title: 'Our Team | Level Up',
    description: 'Meet the team behind Level Up, the UK feminist campaigning organisation fighting for gender justice through people-powered campaigns.',
  },
  'press': {
    title: 'Level Up Press Coverage | Feminist Campaigning in the UK',
    description: 'Explore media coverage of Level Up, a UK-based feminist campaigning organisation working on reproductive justice, abortion decriminalisation and gender justice.',
  },
  'contact': {
    title: 'Contact Level Up | Media Enquiries & Campaign Ideas',
    description: 'Get in touch with Level Up. Contact us for media enquiries, campaign ideas, partnerships or collaboration opportunities. Based in London, working across the UK.',
  },
  'media-guidelines': {
    title: 'Media Guidelines for Reporting Fatal Domestic Abuse | Level Up',
    description: 'Media guidelines for reporting fatal domestic abuse led by Level Up, challenging harmful press coverage and calling for responsible journalism to prevent domestic homicide.',
  },
  'nomorelyes-relaxer-info-kit': {
    title: 'Hair Relaxer Cancer Risk — What You Need to Know | Level Up',
    description: "Hair relaxers may double the risk of womb cancer. Level Up's #NoMoreLyes campaign calls on beauty brands to remove toxic chemicals from hair relaxers. Read the science and take action.",
  },
};

const { file } = Astro.props;
if (!file) {
  return Astro.redirect('/404');
}
const rawHtml = readFileSync(file, 'utf-8');
const { headInner, bodyClass, mainContent } = extract(rawHtml);
const meta = slugMeta[Astro.params.slug ?? ''] ?? {};
---
<Layout headHtml={headInner} bodyClass={bodyClass} title={meta.title} description={meta.description} noindex={!meta.title}>
  <Nav />
  <Fragment set:html={mainContent} />
  <Footer />
</Layout>
