---
// New design-system Footer — namespaced separately from src/components/Footer.astro
// (which legacy pages still use) to avoid a naming collision during Step 1/2.
// Real contact info matches src/components/Footer.astro verbatim.
import logoOffwhite from '../../assets/brand/logos/logo-offwhite.svg';
import logoLimeNavy from '../../assets/brand/logos/logo-lime-navy.svg';

interface Props {
  bg?: 'navy' | 'loud-lilac';
}
const { bg = 'navy' } = Astro.props;
const logo = bg === 'loud-lilac' ? logoLimeNavy : logoOffwhite;
const linkColor = bg === 'loud-lilac' ? 'electric-yellow' : 'off-white';
---

<footer class={`ds-footer ds-footer--${bg}`} style={`background: var(--color-${bg}); color: var(--color-off-white);`}>
  <div class="ds-footer-inner">
    <div class="ds-footer-brand">
      <img src={logo.src} alt="Level Up" height="32" />
      <div class="ds-footer-social">
        <a href="https://www.facebook.com/levelupaction" target="_blank" rel="noopener" aria-label="Facebook" style={`color: var(--color-${linkColor});`}>
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="https://twitter.com/we_level_up" target="_blank" rel="noopener" aria-label="Twitter" style={`color: var(--color-${linkColor});`}>
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
        </a>
        <a href="https://www.instagram.com/welevelup" target="_blank" rel="noopener" aria-label="Instagram" style={`color: var(--color-${linkColor});`}>
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a href="https://www.tiktok.com/@levelupactionuk" target="_blank" rel="noopener" aria-label="TikTok" style={`color: var(--color-${linkColor});`}>
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.75a4.85 4.85 0 01-1.01-.06z"/></svg>
        </a>
      </div>
    </div>

    <div class="ds-footer-contact">
      <a href="mailto:hello@welevelup.org" style={`color: var(--color-${linkColor});`}>hello@welevelup.org</a>
      <p>3rd Floor 86 – 90 Paul Street<br />London<br />EC2A 4NE</p>
    </div>

    <div class="ds-footer-legal">
      <p>© 2018–{new Date().getFullYear()} Level Up. All Rights Reserved.</p>
      <p>Except where otherwise noted, content on this site is licensed under a <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/" target="_blank" rel="noopener" style={`color: var(--color-${linkColor});`}>Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License</a></p>
      <img src="/wp-content/uploads/2024/10/footer-logo-1.webp" alt="CC BY-NC-ND 4.0" width="88" height="31" />
    </div>
  </div>
</footer>

<style>
  .ds-footer { padding-block: var(--space-12); }
  .ds-footer-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: grid;
    grid-template-columns: 1fr 1fr 1.5fr;
    gap: var(--space-8);
    align-items: start;
    font-family: var(--font-body);
  }
  .ds-footer-brand { display: flex; flex-direction: column; gap: var(--space-4); align-items: flex-start; }
  .ds-footer-social { display: flex; gap: var(--space-3); }
  .ds-footer-contact { display: flex; flex-direction: column; gap: var(--space-3); }
  .ds-footer-contact a { font-weight: 700; text-decoration: none; }
  .ds-footer-legal { font-size: var(--text-label); opacity: 0.85; display: flex; flex-direction: column; gap: var(--space-2); }
  .ds-footer-legal a { color: inherit; }
  @media (max-width: 768px) {
    .ds-footer-inner { grid-template-columns: 1fr; }
  }
</style>
