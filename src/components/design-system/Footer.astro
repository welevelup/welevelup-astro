---
// New design-system Footer — namespaced separately from src/components/Footer.astro
// (which legacy pages still use) to avoid a naming collision during Step 1.
import logo from '../../assets/brand/logos/logo-offwhite.svg';
---

<footer class="ds-footer">
  <div class="ds-footer-inner">
    <img src={logo.src} alt="Level Up" height="28" />
    <nav aria-label="Footer navigation">
      <a href="/about-us">About</a>
      <a href="/contact">Contact</a>
      <a href="/donate">Donate</a>
    </nav>
    <p class="ds-footer-copy">&copy; {new Date().getFullYear()} Level Up</p>
  </div>
</footer>

<style>
  .ds-footer {
    background: var(--color-navy);
    color: var(--color-off-white);
    padding-block: var(--space-8);
  }
  .ds-footer-inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    font-family: var(--font-body);
  }
  .ds-footer-inner nav { display: flex; gap: var(--space-4); }
  .ds-footer-inner a { color: inherit; text-decoration: none; }
  .ds-footer-copy { margin-left: auto; opacity: 0.7; font-size: var(--text-label); }
</style>
