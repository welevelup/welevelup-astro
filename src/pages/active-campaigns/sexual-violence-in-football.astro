  <CampaignTemplate
    name="Sexual violence in football"
    intro="Sexual violence in football is a campaign led by Level Up to challenge the culture of impunity around gender-based violence in professional football."
    petitionHref="https://levelup.movement-action.org/p/sexual-violence-in-football"
    imageSrc="/wp-content/uploads/2025/08/1553e305-ff32-46ed-a997-a255d801a668_tfywcj-1-e1769823018750.webp"
