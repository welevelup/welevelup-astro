---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { extract } from '../lib/extractHtml';
import homeRaw from '../_clone/index.html?raw';
const { headInner, bodyClass } = extract(homeRaw);
---
<Layout
  headHtml={headInner}
  bodyClass={bodyClass}
  title="Contact Level Up"
  description="Get in touch with Level Up. We'd love to hear from you. Email us at hello@welevelup.org or send a message via our contact form."
>
  <Nav />

  <section class="ct-hero">
    <div class="ct-hero-inner">
      <span class="ct-label">Get in touch</span>
      <h1 class="ct-title">Contact Level Up</h1>
      <p class="ct-subtitle">We're a UK-based feminist campaigning organisation working to end bodily and systemic violence. If you're a journalist, supporter, potential partner, or someone with a campaign idea — we'd love to hear from you.</p>
    </div>
  </section>

  <section class="ct-content">
    <div class="ct-grid">
      <!-- FORM -->
      <div class="ct-form-wrap">
        <h2>Send us a message</h2>
        <form class="ct-form" id="ct-form">
          <label>
            <span>Name</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label>
            <span>Subject</span>
            <input type="text" name="subject" />
          </label>
          <label>
            <span>Message</span>
            <textarea name="message" rows="6" required></textarea>
          </label>
          <button type="button" id="ct-submit" onclick="ctSend()">Send message</button>
          <p id="ct-status" class="ct-status" aria-live="polite"></p>
        </form>
        <script is:inline>
          async function ctSend() {
            var form = document.getElementById(‘ct-form’);
            var btn = document.getElementById(‘ct-submit’);
            var status = document.getElementById(‘ct-status’);
            var name = form.querySelector(‘[name=name]’).value.trim();
            var email = form.querySelector(‘[name=email]’).value.trim();
            var message = form.querySelector(‘[name=message]’).value.trim();
            if (!name || !email || !message) {
              status.textContent = ‘Name, email and message are required.’;
              status.className = ‘ct-status ct-status--err’;
              return;
            }
            var data = { name: name, email: email, message: message,
              subject: (form.querySelector(‘[name=subject]’) || {}).value || ‘’ };
            btn.textContent = ‘Sending…’;
            btn.disabled = true;
            status.textContent = ‘’;
            status.className = ‘ct-status’;
            try {
              var res = await fetch(‘/api/contact’, { method: ‘POST’, headers: { ‘Content-Type’: ‘application/json’ }, body: JSON.stringify(data) });
              var json = {};
              try { json = await res.json(); } catch(_) {}
              if (res.ok) {
                status.textContent = "Message sent — we’ll be in touch soon!";
                status.className = ‘ct-status ct-status--ok’;
                form.reset();
                status.scrollIntoView({ behavior: ‘smooth’, block: ‘nearest’ });
              } else {
                status.textContent = json.error || ‘Something went wrong. Please email us directly.’;
                status.className = ‘ct-status ct-status--err’;
              }
            } catch(err) {
              status.textContent = ‘Something went wrong. Please email hello@welevelup.org’;
              status.className = ‘ct-status ct-status--err’;
            }
            btn.textContent = ‘Send message’;
            btn.disabled = false;
          }
        </script>
      </div>

      <!-- INFO -->
      <div class="ct-info">
        <div class="ct-info-block">
          <h3>For media enquiries</h3>
          <a href="mailto:media@welevelup.org">media@welevelup.org</a>
        </div>
        <div class="ct-info-block">
          <h3>Got a campaign idea, or just want to say hi?</h3>
          <a href="mailto:hello@welevelup.org">hello@welevelup.org</a>
        </div>
        <div class="ct-info-block">
          <h3>Work with us</h3>
          <a href="mailto:hello@welevelup.org">hello@welevelup.org</a>
        </div>
        <div class="ct-info-block">
          <h3>Address</h3>
          <p>3rd Floor 86 – 90 Paul Street<br/>London<br/>EC2A 4NE</p>
        </div>
        <div class="ct-info-block">
          <h3>Follow us</h3>
          <div class="ct-social">
            <a href="https://www.facebook.com/levelupaction" target="_blank" rel="noopener">Facebook</a>
            <a href="https://twitter.com/we_level_up" target="_blank" rel="noopener">Twitter/X</a>
            <a href="https://www.instagram.com/welevelup" target="_blank" rel="noopener">Instagram</a>
            <a href="https://www.tiktok.com/@levelupactionuk" target="_blank" rel="noopener">TikTok</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="ct-cta">
    <h2>Join the Level Up community</h2>
    <p>Campaign updates, event invitations, and feminist thinking — straight to your inbox.</p>
    <a href="https://levelup.yourmovement.org/p/join-us" class="ct-cta-btn" target="_blank" rel="noopener">Join us</a>
  </section>

  <Footer />
</Layout>

<style is:global>
  .ct-hero {
    background: #0C0A3E;
    padding: 80px 24px 64px;
    font-family: 'DM Sans', sans-serif;
  }
  .ct-hero-inner { max-width: 900px; margin: 0 auto; }
  .ct-label {
    font: 600 12px/1 'DM Sans';
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #A89CED;
    display: block;
    margin-bottom: 12px;
  }
  .ct-title {
    font: 800 clamp(40px, 8vw, 72px)/0.9 'DM Sans';
    color: #CCFF33 !important;
    letter-spacing: -0.04em;
    margin: 0 0 16px;
  }
  .ct-subtitle {
    font: 400 18px/1.5 'DM Sans';
    color: rgba(238,235,211,0.6);
  }

  .ct-content {
    background: #EEEBD3;
    padding: 64px 24px;
    font-family: 'DM Sans', sans-serif;
  }
  .ct-grid {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 64px;
  }

  .ct-form-wrap h2 {
    font: 800 28px/1.1 'DM Sans';
    color: #0C0A3E;
    letter-spacing: -0.03em;
    margin: 0 0 32px;
  }
  .ct-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .ct-form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ct-form label span {
    font: 600 12px/1 'DM Sans';
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(12,10,62,0.5);
  }
  .ct-form input, .ct-form textarea {
    font: 400 16px/1.4 'DM Sans';
    padding: 14px 16px;
    border: 2px solid rgba(12,10,62,0.12);
    background: #fff;
    color: #0C0A3E;
    transition: border-color 0.15s;
  }
  .ct-form input:focus, .ct-form textarea:focus {
    outline: 3px solid #CCFF33;
    outline-offset: 2px;
    border-color: #CCFF33 !important;
  }
  .ct-form button {
    font: 900 14px/1 'DM Sans';
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: #CCFF33;
    color: #0C0A3E;
    border: none;
    padding: 18px 36px;
    cursor: pointer;
    transition: all 0.15s;
    align-self: flex-start;
  }
  .ct-form button:hover { background: #0C0A3E; color: #CCFF33 !important; }

  .ct-info { display: flex; flex-direction: column; gap: 32px; }
  .ct-info-block h3 {
    font: 700 14px/1 'DM Sans';
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #0C0A3E;
    margin: 0 0 10px;
  }
  .ct-info-block a {
    font: 500 16px/1.4 'DM Sans';
    color: #0C0A3E;
    text-decoration: underline;
    text-decoration-color: #A89CED;
    text-underline-offset: 3px;
  }
  .ct-info-block a:hover { text-decoration-color: #CCFF33 !important; }
  .ct-info-block p {
    font: 400 16px/1.6 'DM Sans';
    color: rgba(12,10,62,0.7);
    margin: 0;
  }
  .ct-social { display: flex; gap: 16px; }
  .ct-social a {
    font: 600 13px/1 'DM Sans';
    color: #0C0A3E;
    text-decoration: none;
    border-bottom: 2px solid #A89CED;
    padding-bottom: 2px;
  }
  .ct-social a:hover { border-bottom-color: #CCFF33 !important; }

  .ct-status {
    font: 500 15px/1.5 'DM Sans';
    padding: 14px 16px;
    margin: 0;
    display: none;
  }
  .ct-status--ok {
    display: block;
    background: #CCFF33;
    color: #0C0A3E;
    border-left: 4px solid #0C0A3E;
  }
  .ct-status--err {
    display: block;
    background: #ffe0e0;
    color: #8b0000;
    border-left: 4px solid #8b0000;
  }

  .ct-cta {
    background: #0C0A3E;
    padding: 80px 24px;
    text-align: center;
    font-family: 'DM Sans';
  }
  .ct-cta h2 { font: 800 40px/0.9 'DM Sans'; color: #CCFF33 !important; letter-spacing: -0.04em; margin: 0 0 16px; }
  .ct-cta p { font: 400 17px/1.5 'DM Sans'; color: rgba(238,235,211,0.6); max-width: 440px; margin: 0 auto 32px; }
  .ct-cta-btn { display: inline-block; background: #CCFF33; color: #0C0A3E; font: 700 14px/1 'DM Sans'; text-transform: uppercase; letter-spacing: 0.08em; padding: 18px 40px; text-decoration: none; }
  .ct-cta-btn:hover { background: #fff; }

  @media (max-width: 768px) {
    .ct-grid { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
