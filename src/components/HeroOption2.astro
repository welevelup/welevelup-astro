---
// Hero banner — matches original site design exactly
---

<section class="hero-banner">
  <div class="hero-bg" style="background-image: url('/images/hero-banner.jpg');"></div>

  <div class="hero-content">
    <p class="hero-intro">We are a feminist community campaigning for gender justice in the UK.</p>
    <p class="hero-intro">Take action on our latest campaign:</p>

    <h1 class="hero-title">#NOMORELYES</h1>

    <div class="hero-cta">
      <a href="https://levelup.yourmovement.org/p/no-more-lyes" target="_blank" rel="noopener" class="hero-btn">
        Sign the petition
      </a>
    </div>

    <p class="hero-desc">
      Big beauty brands like L'Oréal must remove toxic ingredients from hair relaxers.<br/>
      The price of Black women's beauty should never be our health.
    </p>
  </div>

  <!-- Ticker — same as original ic-bar -->
  <div class="ic-bar-hero">
    <div class="ic-bar-track-hero">
      <a href="/active-campaigns/islington-council-finish-holloway-womens-centre" class="ic-bar-item-hero">
        <span class="ic-bar-badge-hero">NEW</span>
        <span>⚠ Islington Council must finish Holloway Women's Centre — 847 signed this week →</span>
      </a>
      <a href="/active-campaigns/islington-council-finish-holloway-womens-centre" class="ic-bar-item-hero">
        <span class="ic-bar-badge-hero">NEW</span>
        <span>⚠ Islington Council must finish Holloway Women's Centre — 847 signed this week →</span>
      </a>
      <a href="/active-campaigns/islington-council-finish-holloway-womens-centre" class="ic-bar-item-hero">
        <span class="ic-bar-badge-hero">NEW</span>
        <span>⚠ Islington Council must finish Holloway Women's Centre — 847 signed this week →</span>
      </a>
    </div>
  </div>
</section>

<script>
  // Measure nav height and set CSS custom property
  function setNavHeight() {
    const nav = document.querySelector('header') || document.querySelector('nav') || document.querySelector('.site-header');
    if (nav) {
      document.documentElement.style.setProperty('--nav-height', nav.offsetHeight + 'px');
    }
  }
  setNavHeight();
  window.addEventListener('resize', setNavHeight);
</script>

<style is:global>
  /* Hide old Elementor hero */
  .elementor-element-c89219b,
  [data-id="c89219b"] {
    display: none !important;
  }
  /* Hide duplicate ic-bar from clone */
  .ic-bar {
    display: none !important;
  }
</style>

<style>
  .hero-banner {
    height: calc(100vh - var(--nav-height, 130px));
    background: #0C0A3E;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    position: relative;
    font-family: 'DM Sans', sans-serif;
  }

  /* Background image with dark overlay */
  .hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    pointer-events: none;
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg,
      rgba(12, 10, 62, 0.72) 0%,
      rgba(12, 10, 62, 0.45) 55%,
      rgba(12, 10, 62, 0.15) 100%
    );
  }

  /* Content */
  .hero-content {
    position: relative;
    z-index: 2;
    padding: 80px 48px 40px;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 800px;
  }

  .hero-intro {
    font: 600 15px/1.4 'DM Sans', sans-serif !important;
    color: #CCFF33 !important;
    margin: 0 0 6px 0 !important;
    padding: 0 !important;
  }

  .hero-title {
    font: 900 clamp(3rem, 10vw, 6.5rem)/0.95 'DM Sans', sans-serif !important;
    color: #CCFF33 !important;
    letter-spacing: -0.03em !important;
    margin: 16px 0 24px 0 !important;
    text-transform: uppercase !important;
  }

  .hero-cta {
    margin-bottom: 20px !important;
  }

  .hero-btn {
    display: inline-block !important;
    background: #CCFF33 !important;
    color: #0C0A3E !important;
    font: 700 15px/1 'DM Sans', sans-serif !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    padding: 14px 32px !important;
    text-decoration: none !important;
    border: none !important;
    cursor: pointer !important;
    transition: background 0.15s !important;
    min-height: 44px !important;
    border-radius: 0 !important;
  }

  .hero-btn:hover {
    background: #c0f01a !important;
  }

  .hero-desc {
    font: 600 14px/1.5 'DM Sans', sans-serif !important;
    color: #CCFF33 !important;
    margin: 0 !important;
    max-width: 600px !important;
    padding: 0 !important;
  }

  .hero-desc br {
    display: block !important;
  }

  /* ===== TICKER — exact match to ic-bar ===== */
  .ic-bar-hero {
    background: #CCFF33 !important;
    overflow: hidden !important;
    white-space: nowrap !important;
    position: relative !important;
    z-index: 2 !important;
    flex-shrink: 0 !important;
    display: block !important;
  }

  .ic-bar-hero:hover .ic-bar-track-hero {
    animation-play-state: paused;
  }

  .ic-bar-track-hero {
    display: inline-flex !important;
    animation: marquee-hero 20s linear infinite !important;
  }

  .ic-bar-item-hero {
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    padding: 12px 48px !important;
    font: 600 13px/1 'DM Sans', sans-serif !important;
    color: #0C0A3E !important;
    text-decoration: none !important;
    white-space: nowrap !important;
  }

  .ic-bar-badge-hero {
    background: #0C0A3E !important;
    color: #CCFF33 !important;
    font: 700 10px/1 'DM Sans', sans-serif !important;
    padding: 4px 8px !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    flex-shrink: 0 !important;
  }

  @keyframes marquee-hero {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.33%); }
  }

  /* ===== TABLET ===== */
  @media (max-width: 1024px) {
    .hero-bg {
      background-position: center 20% !important;
    }

    .hero-content {
      padding: 40px 24px 32px;
      justify-content: flex-end;
    }

    .hero-intro {
      font-size: 14px;
    }

    .hero-title {
      font-size: clamp(2.5rem, 8vw, 4rem);
      margin: 12px 0 20px 0;
    }
  }

  /* ===== MÓVIL ===== */
  @media (max-width: 767px) {
    .hero-bg {
      background-position: center 15% !important;
    }

    .hero-bg::after {
      background: linear-gradient(
        to top,
        rgba(12, 10, 62, 0.95) 0%,
        rgba(12, 10, 62, 0.7) 40%,
        rgba(12, 10, 62, 0.2) 70%,
        rgba(12, 10, 62, 0.05) 100%
      ) !important;
    }

    .hero-content {
      padding: 0 20px 28px !important;
      justify-content: flex-end !important;
    }

    .hero-intro {
      font-size: 13px !important;
      line-height: 1.3 !important;
      margin-bottom: 4px !important;
    }

    .hero-title {
      font-size: clamp(2.2rem, 9vw, 3rem) !important;
      margin: 8px 0 20px 0 !important;
      letter-spacing: -0.02em !important;
    }

    .hero-desc {
      display: none !important;
    }

    .hero-btn {
      font-size: 14px !important;
      padding: 14px 0 !important;
      width: 100% !important;
      text-align: center !important;
      border-radius: 4px !important;
    }

    .ic-bar-item-hero {
      font-size: 11px !important;
      padding: 10px 24px !important;
    }
  }
</style>
