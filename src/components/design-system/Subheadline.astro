---
import type { ColorName } from '../../lib/brand-colors';

interface Props {
  as?: 'h2' | 'h3' | 'h4';
  color?: ColorName;
  class?: string;
}
const { as: Tag = 'h2', color = 'navy', class: className = '' } = Astro.props;
---

<Tag class={`ds-subheadline ${className}`} style={`color: var(--color-${color});`}>
  <slot />
</Tag>

<style>
  .ds-subheadline {
    font-family: var(--font-headline);
    text-transform: none;
    font-size: var(--text-subheadline);
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
  }
</style>
