---
export const prerender = false;
import { getAdminData } from '../../lib/admin-data';

let donations = null;
let lastSync = null;

try {
  const data = await getAdminData();
  donations = data.donations;
  lastSync = data.lastSync;
} catch (error) {
  console.error('Failed to load admin data:', error);
}

const fmt = (n: number) => `£${n.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
const fmtDate = (s: string | null) => s ? new Date(s).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : 'Never';
const donationsJSON = JSON.stringify(donations || {});
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dashboard — Level Up Admin</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    :root {
      --bg-primary: #0C0A3E;
      --bg-secondary: #13114a;
      --text-primary: #EEEBD3;
      --text-secondary: #999999;
      --text-tertiary: rgba(238,235,211,0.4);
      --accent: #CCFF33;
      --border: rgba(255,255,255,0.06);
    }
    :root.light-mode {
      --bg-primary: #FFFFFF;
      --bg-secondary: #F9F9F9;
      --text-primary: #1A1A1A;
      --text-secondary: #666666;
      --text-tertiary: #888888;
      --accent: #8B7EBD;
      --border: rgba(0,0,0,0.1);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'DM Sans', system-ui, sans-serif; background: var(--bg-primary); color: var(--text-primary); min-height: 100vh; display: flex; flex-direction: column; }
    .layout { display: flex; flex: 1; }
    .sidebar { width: 240px; background: var(--bg-secondary); border-right: 1px solid var(--border); padding: 24px 0; display: flex; flex-direction: column; gap: 8px; }
    .sidebar-item { padding: 12px 20px; color: var(--text-secondary); text-decoration: none; font-size: 14px; cursor: pointer; transition: all 0.2s; border-left: 3px solid transparent; display: block; }
    .sidebar-item:hover { background: rgba(255,255,255,0.05); color: var(--text-primary); }
    .sidebar-item.active { background: rgba(204,255,51,0.1); color: var(--accent); border-left-color: var(--accent); }
    .content { flex: 1; display: flex; flex-direction: column; }
    nav { background: var(--bg-secondary); border-bottom: 1px solid var(--border); padding: 0 16px; display: flex; align-items: center; justify-content: space-between; height: 56px; flex-wrap: wrap; }
    .nav-brand { font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--accent); }
    .nav-right { display: flex; align-items: center; gap: 10px; }
    .sync-btn { background: var(--accent); color: var(--bg-primary); border: none; border-radius: 6px; padding: 8px 12px; font-size: 11px; font-weight: 700; cursor: pointer; transition: all 0.2s; }
    .sync-btn:hover { opacity: 0.85; }
    .sync-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .logout-btn { background: none; border: 1px solid var(--text-secondary); color: var(--text-secondary); border-radius: 6px; padding: 8px 12px; font-size: 11px; cursor: pointer; }
    main { max-width: 1200px; margin: 0 auto; padding: 24px 16px; flex: 1; }
    h1 { font-size: 24px; font-weight: 800; margin-bottom: 8px; }
    .subtitle { font-size: 12px; color: var(--text-secondary); margin-bottom: 24px; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 24px; }
    .stat-card { background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; padding: 16px; }
    .stat-label { font-size: 10px; font-weight: 600; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 8px; }
    .stat-value { font-size: 20px; font-weight: 800; color: var(--accent); }
    .stat-sub { font-size: 11px; color: var(--text-tertiary); margin-top: 4px; }
    .section { margin-bottom: 24px; }
    .section-title { font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 12px; }
    .chart-container { background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; padding: 16px; min-height: 300px; display: flex; align-items: center; justify-content: center; }
    table { width: 100%; border-collapse: collapse; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; font-size: 12px; }
    th { text-align: left; font-size: 10px; font-weight: 600; text-transform: uppercase; color: var(--text-tertiary); padding: 8px 12px; border-bottom: 1px solid var(--border); }
    td { padding: 8px 12px; border-bottom: 1px solid rgba(255,255,255,0.04); }
    tr:last-child td { border-bottom: none; }
    .last-sync { font-size: 10px; color: var(--text-tertiary); }
    #theme-btn { cursor: pointer; padding: 4px 8px; background: none; border: none; font-size: 14px; }
    
    @media (max-width: 768px) {
      .layout { flex-direction: column; }
      .sidebar { width: 100%; padding: 8px 0; gap: 4px; }
      .sidebar-item { padding: 8px 12px; font-size: 12px; }
      nav { padding: 0 12px; height: auto; }
      .nav-brand { font-size: 10px; }
      .nav-right { gap: 8px; flex-wrap: wrap; }
      main { padding: 16px 12px; }
      h1 { font-size: 18px; }
      .stats-grid { grid-template-columns: 1fr; gap: 10px; }
      .stat-card { padding: 12px; }
      table { font-size: 11px; }
      th, td { padding: 6px 8px; }
    }
  </style>
</head>
<body>
  <nav>
    <div class="nav-brand">Level Up Admin</div>
    <div class="nav-right">
      <span class="last-sync">Sync: {fmtDate(lastSync)}</span>
      <button class="sync-btn" id="sync-btn">SYNC NOW</button>
      <button id="theme-btn">🌙</button>
      <button class="logout-btn" id="logout-btn">Out</button>
    </div>
  </nav>

  <div class="layout">
    <div class="sidebar">
      <a href="/admin/dashboard" class="sidebar-item active">Donations</a>
      <a href="/admin/seo" class="sidebar-item">SEO</a>
      <a href="/admin/analytics" class="sidebar-item">Analytics</a>
    </div>

    <div class="content">
      <main>
        <h1>Dashboard</h1>
        <p class="subtitle">Donations overview for welevelup.org</p>

        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-label">This Month</div>
            <div class="stat-value" id="month-total">£0</div>
            <div class="stat-sub">Total</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">This Year</div>
            <div class="stat-value" id="year-total">£0</div>
            <div class="stat-sub">YTD</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Active Subscribers</div>
            <div class="stat-value" id="subscribers">0</div>
            <div class="stat-sub">Recurring</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">New This Month</div>
            <div class="stat-value" id="new-month">0</div>
            <div class="stat-sub">New</div>
          </div>
        </div>

        <div class="section">
          <div class="section-title">Monthly Donations (Last 12 Months)</div>
          <div class="chart-container">
            <svg id="lineChart" viewBox="0 0 800 250" style="width: 100%; max-height: 250px;"></svg>
          </div>
        </div>

        <div class="section">
          <div class="section-title">Monthly Totals</div>
          <table>
            <thead>
              <tr>
                <th>Month</th>
                <th>Recurring</th>
                <th>One-Off</th>
                <th>Total</th>
              </tr>
            </thead>
            <tbody id="monthly-table">
              <tr><td colspan="4" style="text-align: center; color: var(--text-tertiary);">No data</td></tr>
            </tbody>
          </table>
        </div>
      </main>
    </div>
  </div>

  <script>
    const html = document.documentElement;
    const donationsData = JSON.parse('{donationsJSON}');
    const theme = localStorage.getItem('admin-theme') || 'dark';
    if (theme === 'light') html.classList.add('light-mode');

    // Update stats
    if (donationsData && donationsData.totalMonth) {
      document.getElementById('month-total').textContent = '£' + donationsData.totalMonth.toFixed(2);
      document.getElementById('year-total').textContent = '£' + donationsData.totalYear.toFixed(2);
      document.getElementById('subscribers').textContent = donationsData.activeSubscribers;
      document.getElementById('new-month').textContent = donationsData.newThisMonth;

      // Update table
      if (donationsData.monthlyTotals && donationsData.monthlyTotals.length) {
        const tbody = document.getElementById('monthly-table');
        tbody.innerHTML = donationsData.monthlyTotals.map(m => `
          <tr>
            <td>${m.month}</td>
            <td>£${m.monthly_donations.toFixed(2)}</td>
            <td>£${m.one_off_donations.toFixed(2)}</td>
            <td><strong>£${m.total.toFixed(2)}</strong></td>
          </tr>
        `).join('');
      }

      // Draw chart
      const canvas = document.getElementById('lineChart');
      if (donationsData.monthlyTotals && donationsData.monthlyTotals.length > 1) {
        const data = donationsData.monthlyTotals;
        const isDark = !html.classList.contains('light-mode');
        const accent = isDark ? '#CCFF33' : '#8B7EBD';
        const text = isDark ? '#EEEBD3' : '#1A1A1A';
        const grid = isDark ? '#333' : '#ddd';

        const w = 800, h = 250, pad = 40;
        const gw = w - 2 * pad, gh = h - 2 * pad;
        const max = Math.max(...data.map(d => d.total));
        
        const pts = data.map((d, i) => ({
          x: pad + (i / (data.length - 1)) * gw,
          y: h - pad - (d.total / max) * gh
        }));

        const pathData = pts.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x} ${p.y}`).join(' ');
        
        canvas.innerHTML = `
          <defs>
            <linearGradient id="fill" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:${accent};stop-opacity:0.2" />
              <stop offset="100%" style="stop-color:${accent};stop-opacity:0" />
            </linearGradient>
          </defs>
          <path d="${pathData} L ${pts[pts.length-1].x} ${h-pad} L ${pts[0].x} ${h-pad} Z" fill="url(#fill)"/>
          <polyline points="${pts.map(p => p.x + ',' + p.y).join(' ')}" fill="none" stroke="${accent}" stroke-width="2" stroke-linecap="round"/>
          ${pts.map((p, i) => `<circle cx="${p.x}" cy="${p.y}" r="4" fill="${accent}"/>`).join('')}
          ${pts.map((p, i) => `<text x="${p.x}" y="${h-10}" font-size="11" fill="${text}" text-anchor="middle">${data[i].month.slice(5)}</text>`).join('')}
        `;
      }
    }

    // Sync button
    document.getElementById('sync-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('sync-btn');
      btn.disabled = true;
      btn.textContent = 'Syncing...';
      try {
        const res = await fetch('/api/admin-sync', { method: 'POST' });
        if (res.ok) {
          const data = await res.json();
          console.log('[Sync] Success:', data);
          btn.textContent = 'Done!';
          setTimeout(() => location.reload(), 1000);
        } else {
          console.error('[Sync] Failed:', res.status);
          alert('Sync failed: ' + res.status);
          btn.textContent = 'SYNC NOW';
          btn.disabled = false;
        }
      } catch (e) {
        console.error('[Sync] Error:', e);
        alert('Error: ' + e.message);
        btn.textContent = 'SYNC NOW';
        btn.disabled = false;
      }
    });

    // Theme toggle
    document.getElementById('theme-btn')?.addEventListener('click', () => {
      if (html.classList.toggle('light-mode')) {
        localStorage.setItem('admin-theme', 'light');
        document.getElementById('theme-btn').textContent = '☀️';
      } else {
        localStorage.setItem('admin-theme', 'dark');
        document.getElementById('theme-btn').textContent = '🌙';
      }
    });

    // Logout
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/admin-auth', { method: 'DELETE' });
      location.href = '/admin';
    });
  </script>
</body>
</html>
