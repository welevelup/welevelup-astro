---
export const prerender = false;
import { getAdminData } from '../../lib/admin-data';

let donations = null;
let lastSync = null;

try {
  const data = await getAdminData();
  donations = data.donations;
  lastSync = data.lastSync;
} catch (error) {
  console.error('Failed to load admin data:', error);
}

const fmt = (n: number) => `£${n.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
const fmtDate = (s: string | null) => s ? new Date(s).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : 'Never';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dashboard — Level Up Admin</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --bg-primary: #0C0A3E;
      --bg-secondary: #13114a;
      --text-primary: #EEEBD3;
      --text-secondary: #999999;
      --text-tertiary: rgba(238,235,211,0.4);
      --text-muted: rgba(238,235,211,0.3);
      --accent: #CCFF33;
      --border: rgba(255,255,255,0.06);
      --border-light: rgba(255,255,255,0.04);
      --hover: rgba(255,255,255,0.02);
    }
    :root.light-mode {
      --bg-primary: #FFFFFF;
      --bg-secondary: #F9F9F9;
      --text-primary: #1A1A1A;
      --text-secondary: #666666;
      --text-tertiary: #888888;
      --text-muted: #AAAAAA;
      --accent: #8B7EBD;
      --border: rgba(0,0,0,0.1);
      --border-light: rgba(0,0,0,0.05);
      --hover: rgba(0,0,0,0.04);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
      min-height: 100vh;
    }
    nav {
      background: var(--bg-secondary);
      border-bottom: 1px solid var(--border);
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 56px;
    }
    .nav-brand { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
    .nav-right { display: flex; align-items: center; gap: 20px; }
    .sync-btn {
      background: var(--accent);
      color: var(--bg-primary);
      border: none;
      border-radius: 6px;
      padding: 8px 16px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      cursor: pointer;
      transition: opacity 0.15s;
    }
    .sync-btn:hover { opacity: 0.85; }
    .sync-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .logout-btn {
      background: none;
      border: 1px solid var(--text-secondary);
      color: var(--text-secondary);
      border-radius: 6px;
      padding: 8px 16px;
      font-size: 12px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .logout-btn:hover { border-color: var(--text-primary); color: var(--text-primary); }
    .last-sync { font-size: 11px; color: var(--text-tertiary); }
    main { max-width: 1200px; margin: 0 auto; padding: 40px 32px; }
    h1 { font-size: 28px; font-weight: 800; margin-bottom: 8px; }
    .subtitle { font-size: 14px; color: var(--text-secondary); margin-bottom: 40px; }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 40px;
    }
    .stat-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 24px;
    }
    .stat-label { font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 12px; }
    .stat-value { font-size: 28px; font-weight: 800; color: var(--accent); }
    .stat-sub { font-size: 12px; color: var(--text-tertiary); margin-top: 4px; }
    .section { margin-bottom: 40px; }
    .section-title { font-size: 14px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 16px; }
    .chart-wrap {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 24px;
      position: relative;
      height: 350px;
    }
    .table-wrap {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
    }
    table { width: 100%; border-collapse: collapse; }
    th {
      text-align: left;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-tertiary);
      padding: 12px 20px;
      border-bottom: 1px solid var(--border);
    }
    td { padding: 12px 20px; font-size: 13px; border-bottom: 1px solid var(--border-light); color: var(--text-primary); }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: var(--hover); }
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 600;
    }
    .badge-recurring { background: rgba(204,255,51,0.1); color: #CCFF33; }
    .badge-oneoff { background: var(--border); color: var(--text-secondary); }
    .empty { padding: 48px; text-align: center; color: var(--text-muted); font-size: 14px; }
    #sync-status { font-size: 12px; color: var(--accent); display: none; }
    #theme-btn { cursor: pointer; padding: 4px 8px; background: none; border: none; font-size: 16px; }
    .spinner {
      display: inline-block;
      width: 12px;
      height: 12px;
      border: 2px solid rgba(204,255,51,0.2);
      border-top-color: #CCFF33;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>
  <nav>
    <div class="nav-brand">Level Up · Admin</div>
    <div class="nav-right">
      <span class="last-sync">Last sync: {fmtDate(lastSync)}</span>
      <button class="sync-btn" id="sync-btn">Sync Now</button>
      <button id="theme-btn">🌙</button>
      <button class="logout-btn" id="logout-btn">Sign out</button>
    </div>
  </nav>

  <main>
    <h1>Dashboard</h1>
    <p class="subtitle">Donations and performance overview for welevelup.org</p>

    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">This Month</div>
        <div class="stat-value">{donations ? fmt(donations.totalMonth) : '—'}</div>
        <div class="stat-sub">Total donations received</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">This Year</div>
        <div class="stat-value">{donations ? fmt(donations.totalYear) : '—'}</div>
        <div class="stat-sub">Year to date</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Active Subscribers</div>
        <div class="stat-value">{donations?.activeSubscribers ?? '—'}</div>
        <div class="stat-sub">Monthly recurring donors</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">New This Month</div>
        <div class="stat-value">{donations?.newThisMonth ?? '—'}</div>
        <div class="stat-sub">New recurring donors</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Cancelled</div>
        <div class="stat-value">{donations?.cancelledThisMonth ?? '—'}</div>
        <div class="stat-sub">Cancellations this month</div>
      </div>
    </div>

    <!-- Monthly chart -->
    <div class="section">
      <div class="section-title">Monthly Donations (Last 12 Months)</div>
      {donations?.monthlyTotals?.length ? (
        <div class="chart-wrap">
          <canvas id="monthlyChart"></canvas>
        </div>
      ) : (
        <div class="table-wrap"><div class="empty">No data yet — click "Sync Now" to fetch donations.</div></div>
      )}
    </div>

    <!-- Gateway Breakdown -->
    <div class="section">
      <div class="section-title">Subscriptions by Gateway (Total)</div>
      {donations?.monthlyTotals?.length ? (
        <div class="chart-wrap">
          <canvas id="gatewayChart"></canvas>
        </div>
      ) : (
        <div class="table-wrap"><div class="empty">No data yet.</div></div>
      )}
    </div>

    <!-- Monthly Donation Totals -->
    <div class="section">
      <div class="section-title">Monthly Donation Totals</div>
      {donations?.monthlyTotals?.length ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Month</th>
                <th>Active Subscribers</th>
                <th>Monthly Donations</th>
                <th>One-Off Donations</th>
                <th>Total Donations</th>
              </tr>
            </thead>
            <tbody>
              {donations.monthlyTotals.map((m: any) => (
                <tr>
                  <td>{m.month}</td>
                  <td>{m.active_subscribers || 0}</td>
                  <td>{fmt(m.monthly_donations || 0)}</td>
                  <td>{fmt(m.one_off_donations || 0)}</td>
                  <td><strong>{fmt(m.total)}</strong></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="table-wrap"><div class="empty">No analytics data yet.</div></div>
      )}
    </div>

    <!-- Monthly Subscription Breakdown by Gateway -->
    <div class="section">
      <div class="section-title">Monthly Subscription Breakdown</div>
      {donations?.monthlyTotals?.length ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Month</th>
                <th>Mollie</th>
                <th>GoCardless</th>
                <th>PayPal</th>
                <th>Total</th>
              </tr>
            </thead>
            <tbody>
              {donations.monthlyTotals.map((m: any) => (
                <tr>
                  <td>{m.month}</td>
                  <td>{m.mollie_count || 0}</td>
                  <td>{m.gocardless_count || 0}</td>
                  <td>{m.paypal_count || 0}</td>
                  <td><strong>{(m.mollie_count || 0) + (m.gocardless_count || 0) + (m.paypal_count || 0)}</strong></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="table-wrap"><div class="empty">No analytics data yet.</div></div>
      )}
    </div>
  </main>

  <script type="application/json" id="donations-data">{JSON.stringify({donations})}</script>

  <script>
    // Theme toggle
    const themeBtn = document.getElementById('theme-btn');
    const htmlElement = document.documentElement;
    const savedTheme = localStorage.getItem('admin-theme') || 'dark';

    if (savedTheme === 'light') {
      htmlElement.classList.add('light-mode');
      themeBtn.textContent = '☀️';
    }

    themeBtn?.addEventListener('click', () => {
      if (htmlElement.classList.contains('light-mode')) {
        htmlElement.classList.remove('light-mode');
        localStorage.setItem('admin-theme', 'dark');
        themeBtn.textContent = '🌙';
      } else {
        htmlElement.classList.add('light-mode');
        localStorage.setItem('admin-theme', 'light');
        themeBtn.textContent = '☀️';
      }
    });

    // Initialize charts with proper data
    function initCharts() {
      const dataEl = document.getElementById('donations-data');
      const donationsData = JSON.parse(dataEl.textContent);

      if (!donationsData.donations?.monthlyTotals?.length) return;

      const isDark = !htmlElement.classList.contains('light-mode');
      const textColor = isDark ? '#EEEBD3' : '#1A1A1A';
      const gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.08)';
      const accentColor = isDark ? '#CCFF33' : '#8B7EBD';

      const months = donationsData.donations.monthlyTotals.map((m) => m.month);
      const totals = donationsData.donations.monthlyTotals.map((m) => m.total);

      // Monthly line chart
      const monthlyCtx = document.getElementById('monthlyChart');
      if (monthlyCtx && window.Chart) {
        new Chart(monthlyCtx, {
          type: 'line',
          data: {
            labels: months,
            datasets: [{
              label: 'Monthly Donations',
              data: totals,
              borderColor: accentColor,
              backgroundColor: accentColor + '20',
              borderWidth: 2,
              fill: true,
              tension: 0.4,
              pointRadius: 4,
              pointBackgroundColor: accentColor,
            }],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { labels: { color: textColor } } },
            scales: {
              y: { ticks: { color: textColor }, grid: { color: gridColor } },
              x: { ticks: { color: textColor }, grid: { color: gridColor } },
            },
          },
        });
      }

      // Gateway doughnut chart
      const mollieTotal = donationsData.donations.monthlyTotals.reduce((s, m) => s + (m.mollie_count || 0), 0);
      const gocardlessTotal = donationsData.donations.monthlyTotals.reduce((s, m) => s + (m.gocardless_count || 0), 0);
      const paypalTotal = donationsData.donations.monthlyTotals.reduce((s, m) => s + (m.paypal_count || 0), 0);

      const gatewayCtx = document.getElementById('gatewayChart');
      if (gatewayCtx && window.Chart) {
        new Chart(gatewayCtx, {
          type: 'doughnut',
          data: {
            labels: ['Mollie', 'GoCardless', 'PayPal'],
            datasets: [{
              data: [mollieTotal, gocardlessTotal, paypalTotal],
              backgroundColor: ['#8B7EBD', '#6B63B5', '#5B53A0'],
            }],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { labels: { color: textColor } } },
          },
        });
      }
    }

    // Wait for Chart.js to load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCharts);
    } else {
      initCharts();
    }

    document.getElementById('sync-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('sync-btn');
      btn.disabled = true;
      btn.innerHTML = 'Syncing... ⏳';

      try {
        const res = await fetch('/api/admin-sync', { method: 'POST' });
        if (res.ok) {
          btn.innerHTML = 'Done! Reloading...';
          setTimeout(() => window.location.reload(), 500);
        } else {
          const data = await res.json();
          alert('Sync failed: ' + (data.error || res.status));
          btn.textContent = 'Sync Now';
          btn.disabled = false;
        }
      } catch (err) {
        alert('Sync error: ' + err.message);
        btn.textContent = 'Sync Now';
        btn.disabled = false;
      }
    });

    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/admin-auth', { method: 'DELETE' });
      window.location.href = '/admin';
    });
  </script>
</body>
</html>
