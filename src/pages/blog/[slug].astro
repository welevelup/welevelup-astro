---
/**
 * Individual blog post — rebuilt on the design system.
 * Real markdown content rendered via <Content /> unchanged; campaign
 * callout mapping, share/copy-link JS, and related-posts logic preserved.
 */
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/design-system/Header.astro';
import Section from '../../components/design-system/Section.astro';
import Headline from '../../components/design-system/Headline.astro';
import Button from '../../components/design-system/Button.astro';
import Footer from '../../components/design-system/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

let post = Astro.props.post;
if (!post) {
  const slug = Astro.params.slug;
  const allPosts = await getCollection('blog');
  post = allPosts.find((p) => p.id === slug);
  if (!post) return Astro.redirect('/blog');
}

const { Content } = await render(post);

const allPosts = await getCollection('blog');
const otherPosts = allPosts.filter((p) => p.id !== post.id).slice(0, 3);

const wordCount = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const dateFormatted = new Date(post.data.date).toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});

// Map posts to campaigns
const campaignMap: Record<string, { title: string; url: string }> = {
  'abortion-is-healthcare-why-decriminalisation-must-include-health-workers': { title: 'Abortion is Healthcare', url: '/active-campaigns/abortion-is-healthcare' },
  'ending-prison-for-pregnant-women-a-non-reformist-reform': { title: 'Pregnancy in Prison', url: '/active-campaigns/pregnancy-in-prison' },
  'why-expanding-criminalisation-is-a-feminist-issue': { title: 'Pregnancy in Prison', url: '/active-campaigns/pregnancy-in-prison' },
  'gender-critical-feminism-isnt-feminist': { title: '#NoMoreLyes', url: '/active-campaigns/nomorelyes-2' },
  'why-the-media-should-focus-on-diddys-violence-not-his-kinks': { title: 'Media Guidelines', url: '/active-campaigns/media-guidelines-domestic-abuse' },
};
const relatedCampaign = campaignMap[post.id];
---
<Layout
  headHtml=""
  title={`${post.data.title} | Level Up`}
  description={post.data.excerpt || undefined}
  ogImage={post.data.image}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.excerpt ?? post.data.title,
    "datePublished": new Date(post.data.date).toISOString(),
    "author": { "@type": "Person", "name": post.data.author },
    "publisher": {
      "@type": "Organization",
      "name": "Level Up",
      "url": "https://welevelup.org",
      "logo": { "@type": "ImageObject", "url": "https://welevelup.org/images/logo-email.png" }
    },
    "url": `https://welevelup.org/blog/${post.id}`,
    ...(post.data.image ? { "image": post.data.image } : {})
  })} />

  <Header heroBg="navy" />

  <Section bg="navy">
    <div class="bp-header-inner">
      <a href="/blog" class="bp-back">← Back to blog</a>
      <Headline color="electric-yellow" class="bp-post-title">{post.data.title}</Headline>
      <div class="bp-post-meta">
        <span>By <strong>{post.data.author}</strong></span>
        <span>·</span>
        <time>{dateFormatted}</time>
        <span>·</span>
        <span>{readingTime} min read</span>
      </div>
      <div class="bp-share bp-share--header">
        <span>Share</span>
        <div class="bp-share-links">
          <a href={`https://twitter.com/intent/tweet?url=https://welevelup.org/blog/${post.id}&text=${encodeURIComponent(post.data.title)}`} target="_blank" rel="noopener">Twitter/X</a>
          <button class="bp-copy-link" data-url={`https://welevelup.org/blog/${post.id}`}>Copy link</button>
        </div>
      </div>
    </div>
  </Section>

  <Section bg="pale-yellow">
    <div class="bp-article-inner">
      <Content />

      {relatedCampaign && (
        <aside class="bp-callout">
          <span class="bp-callout-label">Related Campaign</span>
          <h3>{relatedCampaign.title}</h3>
          <p>Join Level Up's campaign — take action now.</p>
          <a href={relatedCampaign.url} class="bp-callout-btn">View campaign →</a>
        </aside>
      )}

      <div class="bp-share">
        <span>Share this article</span>
        <div class="bp-share-links">
          <a href={`https://twitter.com/intent/tweet?url=https://welevelup.org/blog/${post.id}&text=${encodeURIComponent(post.data.title)}`} target="_blank" rel="noopener">Twitter/X</a>
          <button class="bp-copy-link" data-url={`https://welevelup.org/blog/${post.id}`}>Copy link</button>
        </div>
      </div>
    </div>
  </Section>

  {otherPosts.length > 0 && (
    <Section bg="navy">
      <Headline as="h2" color="electric-yellow" class="bp-related-heading">Keep reading</Headline>
      <div class="bp-related-grid">
        {otherPosts.map((p) => (
          <a href={`/blog/${p.id}`} class="bp-related-card">
            <span class="bp-related-tag">{p.data.author}</span>
            <h3>{p.data.title}</h3>
            <span class="bp-related-date">{new Date(p.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
            <span class="bp-related-read">Read →</span>
          </a>
        ))}
      </div>
    </Section>
  )}

  <Section bg="navy">
    <div class="bp-cta">
      <Headline as="h2" color="electric-yellow">Join the Level Up community</Headline>
      <p style="color: var(--color-off-white); opacity: 0.75; max-width: 480px; margin-inline: auto;">Campaign updates, event invitations, and feminist thinking.</p>
      <Button bg="electric-yellow" text="navy" href="https://levelup.yourmovement.org/p/join-us" label="Join us" />
    </div>
  </Section>

  <Footer bg="navy" />
</Layout>

<script>
  document.querySelectorAll('.bp-copy-link').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLElement;
      const url = el.dataset.url;
      if (url) navigator.clipboard.writeText(url);
      el.textContent = 'Copied!';
      setTimeout(() => { el.textContent = 'Copy link'; }, 2000);
    });
  });
</script>

<style>
  .bp-header-inner { max-width: 68ch; }
  .bp-back {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--color-off-white);
    opacity: 0.5;
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--space-6);
  }
  .bp-back:hover { opacity: 1; color: var(--color-electric-yellow); }
  :global(.bp-post-title) { margin-bottom: var(--space-5) !important; }
  .bp-post-meta {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-off-white);
    opacity: 0.6;
    flex-wrap: wrap;
  }
  .bp-post-meta strong { opacity: 1; }

  .bp-share--header {
    border-top: 1px solid rgba(238,235,211,0.15);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
  }
  .bp-share--header > span { color: var(--color-off-white); opacity: 0.6; }
  .bp-share--header .bp-share-links a,
  .bp-share--header .bp-share-links button {
    color: var(--color-electric-yellow);
    border-color: rgba(238,235,211,0.2);
    background: none;
  }
  .bp-share--header .bp-share-links a:hover,
  .bp-share--header .bp-share-links button:hover {
    border-color: var(--color-electric-yellow);
    background: rgba(204,255,51,0.1);
  }

  .bp-article-inner { max-width: 68ch; margin: 0 auto; }

  .bp-callout { background: var(--color-navy); padding: var(--space-8); margin: var(--space-10) 0; }
  .bp-callout-label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-loud-lilac);
    display: block;
    margin-bottom: var(--space-3);
  }
  .bp-callout h3 { font-family: var(--font-headline); font-size: 1.4rem; color: var(--color-electric-yellow); margin: 0 0 var(--space-2); }
  .bp-callout p { font-family: var(--font-body); font-size: 0.9375rem; color: var(--color-off-white); opacity: 0.7; margin: 0 0 var(--space-4); }
  .bp-callout-btn {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--color-electric-yellow);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .bp-callout-btn:hover { color: var(--color-off-white); }

  .bp-share {
    border-top: 1px solid rgba(12,10,62,0.1);
    padding-top: var(--space-5);
    margin-top: var(--space-8);
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .bp-share > span {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-navy);
    opacity: 0.5;
  }
  .bp-share-links { display: flex; gap: var(--space-3); }
  .bp-share-links a, .bp-share-links button {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--color-navy);
    text-decoration: none;
    background: none;
    border: 1px solid rgba(12,10,62,0.15);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
  }
  .bp-share-links a:hover, .bp-share-links button:hover {
    border-color: var(--color-electric-yellow);
    background: rgba(204,255,51,0.1);
  }

  .bp-related-heading { margin-bottom: var(--space-8); }
  .bp-related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  .bp-related-card {
    background: rgba(238,235,211,0.04);
    padding: var(--space-6);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border: 1px solid rgba(238,235,211,0.1);
    transition: border-color 0.15s ease;
  }
  .bp-related-card:hover { border-color: var(--color-electric-yellow); }
  .bp-related-tag {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gentle-lilac);
  }
  .bp-related-card h3 { font-family: var(--font-headline); font-size: 1.05rem; color: var(--color-off-white); margin: 0; flex: 1; }
  .bp-related-date { font-family: var(--font-body); font-size: 0.75rem; color: var(--color-off-white); opacity: 0.5; }
  .bp-related-read { font-family: var(--font-body); font-weight: 700; font-size: 0.8rem; color: var(--color-electric-yellow); margin-top: auto; }

  .bp-cta { text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-4); }

  @media (max-width: 768px) {
    .bp-related-grid { grid-template-columns: 1fr; }
    .bp-share { flex-direction: column; align-items: flex-start; }
    .bp-callout { padding: var(--space-6); }
  }
</style>

<style is:global>
  /* Markdown article body typography — applies to <Content /> output only. */
  .bp-article-inner p {
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-navy);
    opacity: 0.85;
    margin: 0 0 var(--space-6);
  }
  .bp-article-inner h2 {
    font-family: var(--font-headline);
    font-size: 1.75rem;
    color: var(--color-navy);
    margin: var(--space-10) 0 var(--space-4);
  }
  .bp-article-inner h3 {
    font-family: var(--font-headline);
    font-size: 1.4rem;
    color: var(--color-navy);
    margin: var(--space-8) 0 var(--space-3);
  }
  .bp-article-inner blockquote {
    border-left: 4px solid var(--color-electric-yellow);
    padding: var(--space-1) 0 var(--space-1) var(--space-6);
    margin: var(--space-8) 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--color-navy);
  }
  .bp-article-inner a {
    color: var(--color-navy);
    text-decoration: underline;
    text-decoration-color: var(--color-loud-lilac);
    text-underline-offset: 3px;
  }
  .bp-article-inner a:hover { text-decoration-color: var(--color-electric-yellow); }
  .bp-article-inner ul, .bp-article-inner ol { padding-left: var(--space-6); margin: 0 0 var(--space-6); }
  .bp-article-inner li { font-family: var(--font-body); font-size: 1.125rem; line-height: 1.75; color: var(--color-navy); opacity: 0.85; margin-bottom: var(--space-2); }
  .bp-article-inner strong { color: var(--color-navy); opacity: 1; }

  /* Hide duplicate "Written by" line from markdown body */
  .bp-article-inner p:first-child:has(em:only-child) {
    display: none;
  }
</style>
