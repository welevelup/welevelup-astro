---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { extract } from '../../lib/extractHtml';
import homeRaw from '../../_clone/index.html?raw';
import { createMollieClient } from '@mollie/api-client';
import { Redis } from '@upstash/redis';

const { headInner, bodyClass } = extract(homeRaw);

// `ref` is an opaque token set by create-donation.ts and mapped to the Mollie
// payment id in Redis. We resolve it server-side to verify the REAL payment
// status, instead of trusting a cookie (which was lost on Mollie's cross-site
// redirect and stranded donors back on /donate).
const ref = Astro.url.searchParams.get('ref') || '';
const amountParam = Astro.url.searchParams.get('amount') || '';
const typeParam = Astro.url.searchParams.get('type') || 'one-time';

type DonationStatus = 'paid' | 'pending' | 'failed' | 'unknown';
let status: DonationStatus = 'unknown';
let displayAmount = amountParam;

if (/^[a-f0-9]{32}$/.test(ref)) {
  try {
    const redisUrl = process.env.UPSTASH_REDIS_REST_URL;
    const redisToken = process.env.UPSTASH_REDIS_REST_TOKEN;
    const apiKey = process.env.MOLLIE_API_KEY;
    if (redisUrl && redisToken && apiKey) {
      const redis = new Redis({ url: redisUrl, token: redisToken });
      const paymentId = await redis.get(`donation:${ref}`);
      if (paymentId && typeof paymentId === 'string') {
        const mollie = createMollieClient({ apiKey });
        const payment = await mollie.payments.get(paymentId);
        displayAmount = payment.amount?.value || displayAmount;
        if (payment.status === 'paid') status = 'paid';
        else if (payment.status === 'open' || payment.status === 'pending') status = 'pending';
        else status = 'failed'; // failed, canceled, expired
      }
    }
  } catch (err) {
    // Redis or Mollie hiccup: never strand the donor — fall back to a neutral
    // confirmation (we just don't fire analytics for an unverified donation).
    console.error('[thank-you] status check failed:', err instanceof Error ? err.message : String(err));
    status = 'unknown';
  }
}

const isMonthly = typeParam === 'monthly';

const COPY: Record<DonationStatus, { label: string; heading: string }> = {
  paid:    { label: 'Donation received', heading: 'Thank you<br/>for standing<br/>with us.' },
  pending: { label: 'Payment processing', heading: 'Almost<br/>there.' },
  failed:  { label: 'Payment not completed', heading: "Something<br/>went wrong." },
  unknown: { label: 'Thank you', heading: 'Thank you<br/>for standing<br/>with us.' },
};
const copy = COPY[status];
---
<Layout
  headHtml={headInner}
  bodyClass={bodyClass}
  title="Thank You for Your Donation | Level Up"
  description="Thank you for supporting Level Up's feminist campaigns. Your contribution helps us fight for gender justice in the UK."
  noindex={true}
>
  <Nav />

  <main class="lu-thanks" id="main-content">
    <div class="lu-thanks__hero">
      <p class="lu-thanks__label">{copy.label}</p>
      <h1 class="lu-thanks__heading" set:html={copy.heading} />
    </div>

    <div class="lu-thanks__body">
      {status === 'failed' ? (
        <div class="lu-thanks__message">
          <p>Your payment wasn't completed, so you haven't been charged.</p>
          <p>If that wasn't intentional, you can try again — it only takes a moment.</p>
          <div class="lu-thanks__actions">
            <a href="/donate" class="lu-thanks__btn-primary">Try again →</a>
            <a href="/" class="lu-thanks__btn-secondary">Back to home</a>
          </div>
          <p class="lu-thanks__contact">Need a hand? <a href="mailto:hello@welevelup.org">hello@welevelup.org</a></p>
        </div>
      ) : (
        <>
          <div class="lu-thanks__message">
            {status === 'pending' ? (
              <p>Your payment is being confirmed. As soon as it clears you'll receive a confirmation email — usually within minutes for cards.</p>
            ) : (
              <p>Your donation is being processed. You'll receive a confirmation email shortly.</p>
            )}
            {isMonthly && (
              <p>Your monthly donation starts once this first payment clears, and you can manage or cancel it any time.</p>
            )}
          </div>

          <div class="lu-thanks__impact">
            <p class="lu-thanks__impact-label">Your donation powers</p>
            <ul class="lu-thanks__list">
              <li>Campaigns for abortion decriminalisation in England and Wales</li>
              <li>Ending the imprisonment of pregnant women</li>
              <li>Dignified media coverage of domestic abuse deaths</li>
              <li>Community bystander training — We Protect Us</li>
            </ul>
          </div>

          <div class="lu-thanks__actions">
            <a href="/active-campaigns/" class="lu-thanks__btn-primary">See our campaigns →</a>
            <a href="/" class="lu-thanks__btn-secondary">Back to home</a>
          </div>

          <p class="lu-thanks__contact">Questions? <a href="mailto:hello@welevelup.org">hello@welevelup.org</a></p>
        </>
      )}
    </div>
  </main>

  <Footer />

  {status === 'paid' && import.meta.env.PUBLIC_META_PIXEL_ID && (
    <script>
      if (typeof fbq !== 'undefined') {
        fbq('track', 'Donate');
      }
    </script>
  )}

  <script is:inline define:vars={{ status, displayAmount, isMonthly }}>
    (function () {
      // Send the back button to /donate instead of back into the Mollie flow.
      window.addEventListener('popstate', () => {
        window.location.href = '/donate';
      });
      window.history.pushState({ isThankYou: true }, document.title, window.location.href);

      // Only fire the purchase conversion for a server-verified PAID donation.
      if (status !== 'paid') return;
      const amount = parseFloat(displayAmount || '0');
      if (amount <= 0) return;

      function fireEvent() {
        if (typeof gtag !== 'function') return;
        gtag('event', 'purchase', {
          currency: 'GBP',
          value: amount,
          transaction_id: 'donation-' + Date.now(),
          items: [{
            item_id: isMonthly ? 'monthly-donation' : 'one-time-donation',
            item_name: isMonthly ? 'Level Up Monthly Donation' : 'Level Up Donation',
            price: amount,
            quantity: 1,
          }],
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fireEvent);
      } else {
        fireEvent();
      }
    })();
  </script>
</Layout>

<style is:global>
  .lu-thanks {
    font-family: 'DM Sans', system-ui, sans-serif;
  }

  .lu-thanks__hero {
    background: #0C0A3E;
    padding: 80px 40px 72px;
    text-align: center;
  }

  .lu-thanks__label {
    margin: 0 0 20px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #CCFF33 !important;
  }

  .lu-thanks__heading {
    margin: 0;
    font-size: clamp(48px, 8vw, 88px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #EEEBD3;
  }

  .lu-thanks__body {
    max-width: 640px;
    margin: 0 auto;
    padding: 64px 40px 96px;
    text-align: center;
  }

  .lu-thanks__message p {
    font-size: 18px;
    line-height: 1.6;
    color: #333;
    margin: 0 0 16px;
  }

  .lu-thanks__impact {
    margin-top: 48px;
    padding: 32px;
    background: #EEEBD3;
    border-left: 4px solid #CCFF33;
  }

  .lu-thanks__impact-label {
    margin: 0 0 16px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #0C0A3E;
  }

  .lu-thanks__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lu-thanks__list li {
    font-size: 15px;
    line-height: 1.8;
    color: #333;
  }

  .lu-thanks__actions {
    margin-top: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .lu-thanks__btn-primary {
    background: #0C0A3E;
    color: #CCFF33 !important;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    padding: 16px 32px;
    display: inline-block;
  }

  .lu-thanks__btn-secondary {
    font-size: 14px;
    font-weight: 700;
    color: #0C0A3E;
    text-decoration: none;
    border-bottom: 2px solid #0C0A3E;
    padding-bottom: 2px;
  }

  .lu-thanks__contact {
    margin-top: 48px;
    font-size: 14px;
    color: #888;
  }

  .lu-thanks__contact a {
    color: #0C0A3E;
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .lu-thanks__hero {
      padding: 56px 24px 48px;
    }
    .lu-thanks__body {
      padding: 48px 24px 72px;
    }
  }
</style>
