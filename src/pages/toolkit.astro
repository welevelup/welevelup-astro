---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { extract } from '../lib/extractHtml';
import homeRaw from '../_clone/index.html?raw';
const { headInner, bodyClass } = extract(homeRaw);
---

<Layout
  headHtml={headInner}
  bodyClass={bodyClass}
  title="LU x DSC Legal Toolkit — Representing Pregnant Women in the Criminal Justice System"
  description="A free legal toolkit for practitioners representing pregnant women and mothers at every stage of the criminal justice process — from bail to sentencing, appeals, and prison law. Created by Doughty Street Chambers and Level Up."
>
  <Nav />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "LU x DSC Legal Toolkit — Representing Pregnant Women in the Criminal Justice System",
    "description": "A free legal resource for practitioners representing pregnant women and mothers at every stage of the criminal justice process.",
    "publisher": { "@type": "Organization", "name": "Level Up", "url": "https://welevelup.org" },
    "author": [
      { "@type": "Person", "name": "Maya Sikand KC" },
      { "@type": "Person", "name": "Pippa Woodrow" },
      { "@type": "Person", "name": "Hannah Smith" },
      { "@type": "Person", "name": "Janey Starling" }
    ],
    "dateModified": "2025-11-28",
    "url": "https://welevelup.org/toolkit"
  })} />

  <main id="main-content">

    <!-- HERO -->
    <section class="tk-hero">
      <div class="tk-hero-inner">
        <div class="tk-hero-text">
          <span class="tk-eyebrow">Pregnancy in Prison · Legal Resource</span>
          <h1 class="tk-title">LU x DSC<br/>Legal Toolkit</h1>
          <p class="tk-subtitle">A free resource for legal practitioners representing pregnant women and mothers of infants at every stage of the criminal justice process — from bail applications to sentencing, appeals, and prison law.</p>
          <div class="tk-hero-meta">
            <span class="tk-meta-item">By Maya Sikand KC, Pippa Woodrow &amp; Hannah Smith</span>
            <span class="tk-meta-sep">·</span>
            <span class="tk-meta-item">Doughty Street Chambers &amp; Level Up</span>
            <span class="tk-meta-sep">·</span>
            <span class="tk-meta-item">Updated November 2025</span>
          </div>
          <div class="tk-hero-actions">
            <a href="/active-campaigns/pregnancy-in-prison" class="tk-btn-secondary">About the campaign →</a>
            <a href="#" class="tk-btn-download" download>Download Toolkit (PDF)</a>
          </div>
        </div>
        <aside class="tk-hero-aside">
          <div class="tk-stat-card">
            <span class="tk-stat-num">7×</span>
            <span class="tk-stat-label">more likely to experience stillbirth in prison than in the community</span>
          </div>
          <div class="tk-stat-card">
            <span class="tk-stat-num">2×</span>
            <span class="tk-stat-label">higher risk of premature birth for incarcerated pregnant women</span>
          </div>
          <div class="tk-stat-card">
            <span class="tk-stat-num">19/20</span>
            <span class="tk-stat-label">children are forced to leave home when their mother is imprisoned</span>
          </div>
        </aside>
      </div>
    </section>

    <!-- STATS BAR -->
    <div class="tk-stats-bar" role="list" aria-label="Key statistics">
      <div class="tk-stats-bar-inner">
        <div class="tk-bar-stat" role="listitem"><strong>1 in 5</strong> midwifery appointments missed in prison</div>
        <div class="tk-bar-stat" role="listitem"><strong>1 in 10</strong> births happen in-cell or en route to hospital</div>
        <div class="tk-bar-stat" role="listitem"><strong>1 in 4</strong> neonatal admissions 2020–22 (vs 1 in 7 nationally)</div>
        <div class="tk-bar-stat" role="listitem"><strong>82%</strong> of women in prison have mental health issues</div>
      </div>
    </div>

    <!-- INTRO -->
    <section class="tk-intro">
      <div class="tk-intro-inner">
        <p>After baby deaths at HMP Bronzefield (2019) and HMP Styal (2020), it is a matter of urgency that legal practitioners are equipped to protect pregnant women and mothers in the criminal justice system. All prison pregnancies should be classified as high risk.</p>
        <p>This toolkit sets out the core legal arguments, tools and resources to effectively represent clients at every stage — from first appearance to appeal. It is written to be practical and usable in court.</p>
      </div>
    </section>

    <!-- MAIN CONTENT -->
    <div class="tk-body">
      <div class="tk-body-inner">

        <!-- SIDEBAR NAV -->
        <nav class="tk-sidebar" aria-label="Toolkit sections">
          <p class="tk-sidebar-label">Contents</p>
          <a href="#prison-law" class="tk-nav-link">Prison Law Context</a>
          <a href="#sentencing" class="tk-nav-link">Sentencing &amp; Mitigation</a>
          <a href="#bail" class="tk-nav-link">Bail</a>
          <a href="#appeals" class="tk-nav-link">Appeals</a>
          <a href="#checklist" class="tk-nav-link">Checklist for Lawyers</a>
          <a href="#resources" class="tk-nav-link">Support Organisations</a>
          <hr class="tk-sidebar-divider" />
          <a href="#" class="tk-nav-action tk-nav-download" download>⬇ Download PDF</a>
          <a href="/resources/pregnancy-in-prison" class="tk-nav-action">All PIP resources →</a>
          <a href="https://levelup.yourmovement.org/p/pregnancy-in-prison" target="_blank" rel="noopener" class="tk-nav-action">Sign the petition →</a>
        </nav>

        <!-- CONTENT -->
        <div class="tk-content">

          <!-- SECTION 1: PRISON LAW CONTEXT -->
          <section id="prison-law" class="tk-section">
            <h2 class="tk-section-title">Prison Law Context</h2>

            <div class="tk-prose">
              <p>The <strong>Prison Rules 1999</strong> and the <strong>Maternal Imprisonment Policy (MIP)</strong> govern minimum requirements for pregnant individuals, Mother and Baby Units (MBUs), and separated mothers with children under two.</p>
            </div>

            <div class="tk-card">
              <h3 class="tk-card-title">Mother and Baby Units (MBUs)</h3>
              <p class="tk-card-body">Six facilities across England with 64 mother places and 70 child places. Upper age limit is 18 months (extendable to approximately two years). There is <strong>no automatic right to placement</strong> — admission requires application through the MBU Admissions Board. Prior social care involvement increases the likelihood of rejection.</p>
              <div class="tk-card-locations">
                <span class="tk-location">HMP Bronzefield</span>
                <span class="tk-location">HMP Eastwood Park</span>
                <span class="tk-location">HMP Styal</span>
                <span class="tk-location">HMP New Hall</span>
                <span class="tk-location">HMP Peterborough</span>
                <span class="tk-location">HMP Askham Grange</span>
              </div>
            </div>

            <div class="tk-card">
              <h3 class="tk-card-title">Healthcare &amp; Support Requirements</h3>
              <ul class="tk-list">
                <li>24-hour midwifery phone access (policy requirement)</li>
                <li>Antenatal and postnatal care provisions</li>
                <li>Restraints are prohibited for hospital visits except in exceptional circumstances</li>
                <li>Women must not give birth in prison — emergency procedures required if this occurs</li>
                <li>Maternity leave eligibility for all postpartum women</li>
                <li>Postnatal support for eight weeks following birth</li>
              </ul>
            </div>

            <div class="tk-card">
              <h3 class="tk-card-title">Release on Temporary Licence (ROTL)</h3>
              <p class="tk-card-body">Three types available:</p>
              <ul class="tk-list">
                <li><strong>Resettlement Day Release (RDR)</strong> — family maintenance</li>
                <li><strong>Resettlement Overnight Release (ROR)</strong> — family reestablishment</li>
                <li><strong>Childcare Resettlement Licence (CRL)</strong> — for primary carers, available throughout sentence</li>
              </ul>
            </div>

            <div class="tk-card">
              <h3 class="tk-card-title">Home Detention Curfew (HDC)</h3>
              <p class="tk-card-body">Early release up to 180 days before automatic release date. Electronic monitoring with 9–16 hour daily curfews. Address must be approved by Probation.</p>
            </div>

            <div class="tk-card">
              <h3 class="tk-card-title">Appeals Against MBU Decisions</h3>
              <p class="tk-card-body">MBU placement refusals can be appealed within three months via the Prisoner Complaints Policy Framework. Unsuccessful appeals can proceed to judicial review. Damages may be available for unlawful separation under <strong>Article 8 ECHR</strong>.</p>
            </div>
          </section>

          <!-- SECTION 2: SENTENCING -->
          <section id="sentencing" class="tk-section">
            <h2 class="tk-section-title">Sentencing &amp; Mitigation</h2>

            <div class="tk-highlight-box">
              <p><strong>Imposition Guideline (September 2025):</strong> Courts should "avoid the possibility of an offender navigating the risks associated with pregnancy, birth and the postnatal period (up to 12 months after birth) in custody unless the imposition of a custodial sentence is unavoidable."</p>
            </div>

            <div class="tk-prose">
              <p>The <strong>Petherick principle</strong> establishes that impact on family life can render otherwise proportionate sentences disproportionate. Pregnancy and caring responsibilities are recognised mitigating factors.</p>
              <p>The <strong>Sentencing Council's April 2024 guidelines</strong> introduced a dedicated mitigating factor: <em>"Pregnancy, childbirth and post-natal care"</em>.</p>
            </div>

            <div class="tk-card">
              <h3 class="tk-card-title">Core Legal Principles</h3>
              <ul class="tk-list">
                <li>Best interests of the child is "a distinct consideration to which full weight must be given"</li>
                <li>Pregnant defendants are recognised as vulnerable</li>
                <li>Where cases "stand on the cusp of custody, the impact on entirely innocent children may tip the balance against a custodial sentence"</li>
                <li>Pregnancy may constitute "exceptional circumstances" justifying departure from mandatory minimums</li>
                <li>Suspension of sentences frequently justified for pregnant offenders</li>
                <li>Focus must be on risks to mother and baby — not whether the pregnancy was planned</li>
              </ul>
            </div>

            <div class="tk-card">
              <h3 class="tk-card-title">Mitigation Evidence to Gather</h3>
              <ul class="tk-list">
                <li>Medical history — gestational diabetes, pre-eclampsia, bleeding episodes</li>
                <li>Mental health conditions and vulnerability</li>
                <li>Racial disparities affecting pregnancy outcomes</li>
                <li>Complex infant health needs requiring specialist support</li>
                <li>Alternative childcare arrangements (detailed assessment required)</li>
                <li>Breastfeeding status and transition plans</li>
                <li>Risk of maternal separation or re-separation</li>
                <li>Child developmental vulnerabilities</li>
                <li>School and community impact documentation</li>
              </ul>
            </div>
          </section>

          <!-- SECTION 3: BAIL -->
          <section id="bail" class="tk-section">
            <h2 class="tk-section-title">Bail</h2>

            <div class="tk-prose">
              <p>There is a <strong>presumption in favour of bail</strong> (except murder). Remand requires reasonable grounds for failure to surrender, offending while on bail, or witness interference. The Human Rights Act 1998 §6 requires proportionality under Article 8 ECHR.</p>
            </div>

            <div class="tk-card">
              <h3 class="tk-card-title">Key Arguments for Pregnant Clients &amp; Primary Carers</h3>
              <ul class="tk-list">
                <li>If a custodial sentence would be disproportionate at trial, remand is typically also disproportionate</li>
                <li>Sudden, unplanned separation carries significant harm even if short-term</li>
                <li>Pregnancy stage and hospital access are critical factors</li>
                <li>Strong community ties and compliance incentives are typically present</li>
                <li>Pregnancy-related developments (medical complications, housing changes) may justify repeat applications after initial remand</li>
              </ul>
            </div>
          </section>

          <!-- SECTION 4: APPEALS -->
          <section id="appeals" class="tk-section">
            <h2 class="tk-section-title">Appeals Against Sentence</h2>

            <div class="tk-card">
              <h3 class="tk-card-title">Test for Appeal</h3>
              <p class="tk-card-body">Sentence is "manifestly excessive," "wrong in principle," or "disproportionate" in Article 8 ECHR terms.</p>
            </div>

            <div class="tk-card">
              <h3 class="tk-card-title">Grounds</h3>
              <ul class="tk-list">
                <li>Failure to consider child welfare or impact adequately</li>
                <li>Inadequate recognition of pregnancy or maternal separation impacts</li>
                <li>Fresh evidence demonstrating greater actual impact than anticipated</li>
              </ul>
            </div>

            <div class="tk-card">
              <h3 class="tk-card-title">Fresh Evidence (Criminal Appeal Act 1968 §23)</h3>
              <p class="tk-card-body">Test: whether necessary or expedient in the interests of justice. Four-factor assessment: capability of belief, grounds for appeal, admissibility, explanation for late production. Post-sentence developments are particularly relevant. Expert reports often valuable.</p>
            </div>

            <div class="tk-card">
              <h3 class="tk-card-title">Expedition</h3>
              <p class="tk-card-body">Cases involving separation or dangerous pregnancies require urgent handling. Contact the Registrar indicating urgency in Grounds of Appeal. Some cases may justify very rapid listing. Liaise with Probation for release planning — accommodation and support must be in place.</p>
            </div>
          </section>

          <!-- SECTION 5: CHECKLIST -->
          <section id="checklist" class="tk-section">
            <h2 class="tk-section-title">Checklist for Lawyers</h2>

            <div class="tk-card">
              <h3 class="tk-card-title">Instructions Required — Pregnant Defendants</h3>
              <ul class="tk-list">
                <li>Due date and MBU placement expiry dates</li>
                <li>Pregnancy complication history</li>
                <li>Current pregnancy difficulties</li>
                <li>Mental health history</li>
              </ul>
            </div>

            <div class="tk-card">
              <h3 class="tk-card-title">Instructions Required — All Cases with Dependent Children</h3>
              <ul class="tk-list">
                <li>Ages of dependent children</li>
                <li>Child vulnerabilities — physical, mental, emotional</li>
                <li>Existing childcare arrangements and the child's daily experience</li>
                <li>Proposed alternative childcare with practical implications</li>
                <li>Defendant's trauma history, neurodiversity, undiagnosed conditions</li>
              </ul>
            </div>

            <div class="tk-card">
              <h3 class="tk-card-title">Evidence to Obtain</h3>
              <ul class="tk-list">
                <li>Medical records — defendant and children</li>
                <li>Social Care records</li>
                <li>School records and teacher statements</li>
                <li>Relative and community statements on child changes</li>
                <li>Expert evidence (where appropriate)</li>
                <li>Solicitor witness statements (appeal cases)</li>
              </ul>
            </div>

            <div class="tk-card">
              <h3 class="tk-card-title">Appellate-Specific Actions</h3>
              <ul class="tk-list">
                <li>Contact previous representatives (duty to verify Grounds of Appeal)</li>
                <li>Liaise with Probation on release planning</li>
                <li>Seek fresh expert reports or addendums as needed</li>
                <li>Arrange funding applications to Registrar via written application</li>
              </ul>
            </div>
          </section>

          <!-- SECTION 6: RESOURCES -->
          <section id="resources" class="tk-section">
            <h2 class="tk-section-title">Support Organisations</h2>

            <div class="tk-resources-grid">
              <div class="tk-resource">
                <h3 class="tk-resource-name">Birth Companions</h3>
                <p class="tk-resource-desc">Pregnancy, birth and motherhood support for women in prison.</p>
              </div>
              <div class="tk-resource">
                <h3 class="tk-resource-name">Children Heard and Seen</h3>
                <p class="tk-resource-desc">Support for children affected by parental imprisonment.</p>
              </div>
              <div class="tk-resource">
                <h3 class="tk-resource-name">Family Rights Group</h3>
                <p class="tk-resource-desc">Parental rights advice regarding child welfare decisions.</p>
              </div>
              <div class="tk-resource">
                <h3 class="tk-resource-name">Hope Street</h3>
                <p class="tk-resource-desc">Trauma-informed residential alternative to custody for justice-involved women and children.</p>
              </div>
              <div class="tk-resource">
                <h3 class="tk-resource-name">National Women's Justice Coalition</h3>
                <p class="tk-resource-desc">Service mapping directory for women in the justice system.</p>
              </div>
              <div class="tk-resource">
                <h3 class="tk-resource-name">Phoenix Futures</h3>
                <p class="tk-resource-desc">Specialist family residential service with substance use focus.</p>
              </div>
              <div class="tk-resource">
                <h3 class="tk-resource-name">Trevi House</h3>
                <p class="tk-resource-desc">Jasmine Mother &amp; Child residential assessment centre.</p>
              </div>
              <div class="tk-resource">
                <h3 class="tk-resource-name">Women in Prison</h3>
                <p class="tk-resource-desc">National charity delivering community and prison support.</p>
              </div>
            </div>

            <div class="tk-further-reading">
              <h3 class="tk-further-title">Key Documents</h3>
              <ul class="tk-list">
                <li>Birth Companions <em>Inside Guide to Pregnancy, Birth and Motherhood in Prison</em></li>
                <li>Birth Charter for women with social care involvement</li>
                <li>Prisoners Advice Service MBU Self-Help Toolkit</li>
                <li>PACT <em>Guide to Being a Good Mum in Prison</em></li>
              </ul>
              <h3 class="tk-further-title" style="margin-top:28px;">Further Reading</h3>
              <ul class="tk-list">
                <li>Abbott &amp; Baldwin (2023) <em>Pregnancy and New Motherhood in Prison</em></li>
                <li>Baldwin (2022) <em>Motherhood In and After Prison</em></li>
                <li>Minson (2020) <em>Maternal Sentencing and the Rights of the Child</em></li>
                <li>Lost Mothers Project — Dr Laura Abbott's research on mandatory separation effects</li>
              </ul>
            </div>
          </section>

        </div>
      </div>
    </div>

    <!-- CTA -->
    <section class="tk-cta" aria-labelledby="tk-cta-h">
      <div class="tk-cta-inner">
        <h2 id="tk-cta-h" class="tk-cta-title">End pregnancy in prison</h2>
        <p class="tk-cta-sub">Level Up has campaigned since 2021 for an end to the imprisonment of pregnant women and new mothers in the UK. Join over 12,000 people who have already signed.</p>
        <div class="tk-cta-actions">
          <a href="https://levelup.yourmovement.org/p/pregnancy-in-prison" target="_blank" rel="noopener" class="tk-cta-btn-primary">Sign the petition</a>
          <a href="/resources/pregnancy-in-prison" class="tk-cta-btn-secondary">All campaign resources →</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style is:global>
  /* ── Base ── */
  .tk-hero, .tk-intro, .tk-body, .tk-cta, .tk-stats-bar {
    font-family: 'DM Sans', system-ui, sans-serif;
  }

  /* ── Hero ── */
  .tk-hero {
    background: #0C0A3E;
    padding: 100px 24px 80px;
  }
  .tk-hero-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 64px;
    align-items: start;
  }
  .tk-eyebrow {
    display: inline-block;
    font: 700 11px/1 'DM Sans', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #A89CED;
    margin-bottom: 24px;
  }
  .tk-title {
    font: 900 clamp(48px, 8vw, 96px)/0.9 'DM Sans', sans-serif;
    color: #CCFF33;
    letter-spacing: -0.04em;
    margin: 0 0 28px;
  }
  .tk-subtitle {
    font: 400 18px/1.65 'DM Sans', sans-serif;
    color: rgba(238,235,211,0.75);
    max-width: 560px;
    margin: 0 0 24px;
  }
  .tk-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 32px;
  }
  .tk-meta-item {
    font: 400 13px/1 'DM Sans', sans-serif;
    color: rgba(238,235,211,0.5);
  }
  .tk-meta-sep { color: rgba(238,235,211,0.25); }
  .tk-btn-secondary {
    display: inline-block;
    font: 700 13px/1 'DM Sans', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #CCFF33 !important;
    text-decoration: none !important;
    border-bottom: 1.5px solid #CCFF33;
    padding-bottom: 4px;
    transition: color 0.15s, border-color 0.15s;
  }
  .tk-btn-secondary:hover { color: #A89CED !important; border-color: #A89CED; }
  .tk-hero-actions {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 16px;
  }
  .tk-btn-download {
    display: inline-flex;
    align-items: center;
    font: 700 13px/1 'DM Sans', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #0C0A3E;
    background: #CCFF33;
    text-decoration: none;
    padding: 12px 20px;
    transition: background 0.15s, color 0.15s;
  }
  .tk-btn-download:hover { background: #A89CED; color: #fff; }

  .tk-hero-aside {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 8px;
  }
  .tk-stat-card {
    background: rgba(204,255,51,0.08);
    border: 1px solid rgba(204,255,51,0.2);
    padding: 20px 24px;
  }
  .tk-stat-num {
    display: block;
    font: 900 40px/1 'DM Sans', sans-serif;
    color: #CCFF33;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }
  .tk-stat-label {
    display: block;
    font: 400 13px/1.5 'DM Sans', sans-serif;
    color: rgba(238,235,211,0.65);
  }

  /* ── Stats bar ── */
  .tk-stats-bar {
    background: #CCFF33;
    padding: 0 24px;
    overflow: hidden;
  }
  .tk-stats-bar-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  .tk-bar-stat {
    font: 400 13px/1.5 'DM Sans', sans-serif;
    color: #0C0A3E;
    padding: 20px 24px;
    border-right: 1px solid rgba(12,10,62,0.15);
  }
  .tk-bar-stat:last-child { border-right: none; }
  .tk-bar-stat strong { font-weight: 800; display: block; font-size: 18px; margin-bottom: 4px; }

  /* ── Intro ── */
  .tk-intro {
    background: #EEEBD3;
    padding: 56px 24px;
    border-bottom: 1px solid rgba(12,10,62,0.08);
  }
  .tk-intro-inner {
    max-width: 760px;
    margin: 0 auto;
  }
  .tk-intro p {
    font: 400 17px/1.75 'DM Sans', sans-serif;
    color: rgba(12,10,62,0.75);
    margin: 0 0 16px;
  }
  .tk-intro p:last-child { margin: 0; }

  /* ── Body ── */
  .tk-body {
    background: #EEEBD3;
    padding: 64px 24px 96px;
  }
  .tk-body-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 64px;
    align-items: start;
  }

  /* ── Sidebar ── */
  .tk-sidebar {
    position: sticky;
    top: 100px;
  }
  .tk-sidebar-label {
    font: 700 10px/1 'DM Sans', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: rgba(12,10,62,0.45);
    margin: 0 0 16px;
  }
  .tk-nav-link {
    display: block;
    font: 600 13px/1 'DM Sans', sans-serif;
    color: #0C0A3E;
    text-decoration: none;
    padding: 11px 0;
    border-bottom: 1px solid rgba(12,10,62,0.08);
    transition: color 0.15s, padding-left 0.15s;
  }
  .tk-nav-link:hover { color: #A89CED; padding-left: 6px; }
  .tk-sidebar-divider { border: none; border-top: 1px solid rgba(12,10,62,0.14); margin: 20px 0; }
  .tk-nav-action {
    display: block;
    font: 700 12px/1 'DM Sans', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #0C0A3E;
    text-decoration: none;
    padding: 10px 0;
    transition: color 0.15s;
  }
  .tk-nav-action:hover { color: #A89CED; }
  .tk-nav-download {
    background: #CCFF33;
    color: #0C0A3E;
    padding: 10px 12px;
    margin-bottom: 12px;
    transition: background 0.15s;
  }
