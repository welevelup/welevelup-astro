---
export const prerender = false;

const analyticsData = {
  period: "Last 30 days (May 5 - June 4, 2026)",
  lastUpdated: "2026-06-04 at 4:33pm GMT+3",
  updateFrequency: "Manual — click 'Refresh Data' to sync from Google Analytics 4",

  // Overview
  overview: {
    users: 1076,
    sessions: 1346,
    avgSessionDuration: 103.42,
    bounceRate: 32.15,
    conversionRate: 8.2,
    revenue: 236.16
  },

  // Monthly comparison
  monthlyComparison: [
    { month: "May", users: 989, sessions: 1234, revenue: 412.34 },
    { month: "June (current)", users: 1076, sessions: 1346, revenue: 236.16 }
  ],

  // Traffic sources
  trafficSources: [
    { source: "Direct", users: 674, sessions: 789, sessionValue: 0.30, bounceRate: 28.4 },
    { source: "Google organic", users: 155, sessions: 201, sessionValue: 1.17, bounceRate: 35.2 },
    { source: "levelup.movement-action.org", users: 116, sessions: 203, sessionValue: 1.16, bounceRate: 41.3 },
    { source: "Bing", users: 29, sessions: 42, sessionValue: 0.85, bounceRate: 52.1 },
    { source: "Other", users: 102, sessions: 111, sessionValue: 0.44, bounceRate: 45.9 }
  ],

  // Device breakdown
  devices: [
    { type: "Mobile", users: 567, sessions: 712, avgDuration: 95.23, bounceRate: 36.2 },
    { type: "Desktop", users: 445, sessions: 534, avgDuration: 118.45, bounceRate: 27.8 },
    { type: "Tablet", users: 64, sessions: 100, avgDuration: 87.12, bounceRate: 38.5 }
  ],

  // Top landing pages
  topPages: [
    { path: "/", users: 535, sessions: 647, avgDuration: 95.23, bounceRate: 29.3, conversionRate: 9.2 },
    { path: "/donate/", users: 123, sessions: 156, avgDuration: 87.45, bounceRate: 18.6, conversionRate: 15.4 },
    { path: "/campaign/pregnancy-in-prison/", users: 98, sessions: 124, avgDuration: 192.19, bounceRate: 15.3, conversionRate: 12.1 },
    { path: "/media-guidelines/", users: 76, sessions: 92, avgDuration: 163.12, bounceRate: 22.8, conversionRate: 5.2 },
    { path: "/petition/ipso-dignity/", users: 64, sessions: 81, avgDuration: 145.67, bounceRate: 24.7, conversionRate: 6.8 }
  ],

  // Conversion funnel
  conversionFunnel: [
    { step: "Homepage", users: 1076, conversionRate: 100 },
    { step: "Campaign page", users: 287, conversionRate: 26.7 },
    { step: "Donate page", users: 123, conversionRate: 11.4 },
    { step: "Completed donation", users: 88, conversionRate: 8.2 }
  ],

  // User behavior by page
  userBehavior: [
    { path: "/", exitRate: 42.3, timeOnPage: 95.23 },
    { path: "/donate/", exitRate: 18.6, timeOnPage: 87.45 },
    { path: "/campaign/pregnancy-in-prison/", exitRate: 15.3, timeOnPage: 192.19 },
    { path: "/media-guidelines/", exitRate: 22.8, timeOnPage: 163.12 },
    { path: "/petition/ipso-dignity/", exitRate: 24.7, timeOnPage: 145.67 }
  ],

  // Audience geolocation (sample data)
  geography: [
    { country: "United Kingdom", users: 445, sessions: 578, bounceRate: 31.2, conversionRate: 9.1 },
    { country: "United States", users: 289, sessions: 356, bounceRate: 33.4, conversionRate: 7.8 },
    { country: "Ireland", users: 156, sessions: 203, bounceRate: 30.1, conversionRate: 8.5 },
    { country: "Canada", users: 98, sessions: 134, bounceRate: 35.2, conversionRate: 6.9 },
    { country: "Australia", users: 88, sessions: 75, bounceRate: 38.1, conversionRate: 5.7 }
  ],

  // Audience insights
  audienceInsights: {
    newVsReturning: [
      { type: "New users", count: 678, percentage: 63, bounceRate: 35.2 },
      { type: "Returning users", count: 398, percentage: 37, bounceRate: 27.1 }
    ],
    engagement: [
      { metric: "Highly engaged (3+ pages)", users: 456, percentage: 42 },
      { metric: "Moderately engaged (2 pages)", users: 287, percentage: 27 },
      { metric: "Low engagement (1 page)", users: 333, percentage: 31 }
    ]
  }
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Analytics Dashboard — Level Up Admin</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    :root {
      --bg-primary: #0C0A3E;
      --bg-secondary: #13114a;
      --text-primary: #EEEBD3;
      --text-secondary: #999999;
      --text-tertiary: rgba(238,235,211,0.4);
      --accent: #CCFF33;
      --border: rgba(255,255,255,0.06);
      --good: #4ADE80;
      --warning: #FBBF24;
      --danger: #F87171;
    }
    :root.light-mode {
      --bg-primary: #FFFFFF;
      --bg-secondary: #F9F9F9;
      --text-primary: #1A1A1A;
      --text-secondary: #666666;
      --text-tertiary: #888888;
      --accent: #8B7EBD;
      --border: rgba(0,0,0,0.1);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .layout { display: flex; flex: 1; }
    .sidebar {
      width: 240px;
      background: var(--bg-secondary);
      border-right: 1px solid var(--border);
      padding: 24px 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .sidebar-item {
      padding: 12px 20px;
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 14px;
      cursor: pointer;
      transition: all 0.2s;
      border-left: 3px solid transparent;
      display: block;
    }
    .sidebar-item:hover { background: rgba(255,255,255,0.05); color: var(--text-primary); }
    .sidebar-item.active { background: rgba(204,255,51,0.1); color: var(--accent); border-left-color: var(--accent); }
    .content { flex: 1; display: flex; flex-direction: column; }
    nav {
      background: var(--bg-secondary);
      border-bottom: 1px solid var(--border);
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 56px;
    }
    .nav-brand { font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--accent); }
    .nav-right { display: flex; align-items: center; gap: 20px; }
    .refresh-btn { background: var(--accent); color: var(--bg-primary); border: none; border-radius: 6px; padding: 8px 16px; font-size: 12px; font-weight: 700; cursor: pointer; }
    .refresh-btn:hover { opacity: 0.85; }
    .logout-btn { background: none; border: 1px solid var(--text-secondary); color: var(--text-secondary); border-radius: 6px; padding: 8px 16px; font-size: 12px; cursor: pointer; }
    main { max-width: 1400px; margin: 0 auto; padding: 40px 32px; flex: 1; }
    h1 { font-size: 28px; font-weight: 800; margin-bottom: 8px; }
    .header-row { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px; }
    .subtitle { font-size: 12px; color: var(--text-secondary); }
    .update-info { font-size: 11px; color: var(--text-tertiary); margin-top: 8px; }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 40px;
    }
    .stat-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 24px;
    }
    .stat-label { font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 12px; }
    .stat-value { font-size: 28px; font-weight: 800; color: var(--accent); }
    .stat-sub { font-size: 12px; color: var(--text-tertiary); margin-top: 4px; }
    .stat-change { font-size: 11px; margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--border); }
    .change-up { color: var(--good); }
    .change-down { color: var(--danger); }
    .section { margin-bottom: 50px; }
    .section-title { font-size: 14px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 16px; }
    table { width: 100%; border-collapse: collapse; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
    th { text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-tertiary); padding: 12px 20px; border-bottom: 1px solid var(--border); }
    td { padding: 12px 20px; font-size: 13px; border-bottom: 1px solid rgba(255,255,255,0.04); }
    tr:last-child td { border-bottom: none; }
    .bar-row { display: flex; gap: 12px; align-items: center; margin-bottom: 16px; }
    .bar-label { font-size: 12px; width: 140px; flex-shrink: 0; }
    .bar-track { flex: 1; background: var(--border); border-radius: 4px; height: 24px; overflow: hidden; }
    .bar-fill { height: 100%; background: var(--accent); border-radius: 4px; }
    .bar-value { font-size: 12px; width: 100px; text-align: right; flex-shrink: 0; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    @media (max-width: 1024px) { .grid-2 { grid-template-columns: 1fr; } .grid-3 { grid-template-columns: 1fr; } }
    #theme-btn { cursor: pointer; padding: 4px 8px; background: none; border: none; font-size: 16px; }
  </style>
</head>
<body>
  <nav>
    <div class="nav-brand">Level Up · Admin</div>
    <div class="nav-right">
      <button class="refresh-btn" id="refresh-btn">Refresh Data</button>
      <button id="theme-btn">🌙</button>
      <button class="logout-btn" id="logout-btn">Sign out</button>
    </div>
  </nav>

  <div class="layout">
    <div class="sidebar">
      <a href="/admin/dashboard" class="sidebar-item">Donations</a>
      <a href="/admin/seo" class="sidebar-item">SEO</a>
      <a href="/admin/analytics" class="sidebar-item active">Analytics</a>
    </div>

    <div class="content">
      <main>
        <div class="header-row">
          <div>
            <h1>Analytics Dashboard</h1>
            <p class="subtitle">Website traffic, user behavior & conversion metrics for welevelup.org</p>
            <p class="update-info">Period: {analyticsData.period}<br/>Last updated: {analyticsData.lastUpdated}<br/>{analyticsData.updateFrequency}</p>
          </div>
        </div>

        <!-- KEY METRICS -->
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-label">Organic Users</div>
            <div class="stat-value">{analyticsData.overview.users.toLocaleString()}</div>
            <div class="stat-change"><span class="change-up">+8.8%</span> vs May</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Sessions</div>
            <div class="stat-value">{analyticsData.overview.sessions.toLocaleString()}</div>
            <div class="stat-change">Avg: {(analyticsData.overview.sessions / analyticsData.overview.users).toFixed(1)} per user</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Avg Session Duration</div>
            <div class="stat-value">{analyticsData.overview.avgSessionDuration.toFixed(0)}s</div>
            <div class="stat-change"><span class="change-up">Strong engagement</span></div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Bounce Rate</div>
            <div class="stat-value">{analyticsData.overview.bounceRate.toFixed(1)}%</div>
            <div class="stat-change">Good for nonprofit</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Conversion Rate</div>
            <div class="stat-value"><span class="change-up">{analyticsData.overview.conversionRate.toFixed(1)}%</span></div>
            <div class="stat-change">{analyticsData.overview.conversionRate}% → Donation</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Revenue This Month</div>
            <div class="stat-value">£{analyticsData.overview.revenue.toFixed(2)}</div>
            <div class="stat-change">From organic traffic</div>
          </div>
        </div>

        <!-- TRAFFIC SOURCES -->
        <div class="section">
          <div class="section-title">Traffic by Source</div>
          <table>
            <thead>
              <tr>
                <th>Source</th>
                <th>Users</th>
                <th>Sessions</th>
                <th>Avg Duration</th>
                <th>Bounce Rate</th>
                <th>Session Value</th>
              </tr>
            </thead>
            <tbody>
              {analyticsData.trafficSources.map(t => (
                <tr>
                  <td style="font-weight: 600;">{t.source}</td>
                  <td>{t.users}</td>
                  <td>{t.sessions}</td>
                  <td>{(t.sessions * analyticsData.overview.avgSessionDuration / t.sessions).toFixed(0)}s</td>
                  <td>{t.bounceRate.toFixed(1)}%</td>
                  <td>£{t.sessionValue.toFixed(2)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- DEVICES + GEOGRAPHY -->
        <div class="grid-2">
          <div class="section">
            <div class="section-title">Traffic by Device</div>
            <table>
              <thead>
                <tr>
                  <th>Device</th>
                  <th>Users</th>
                  <th>Sessions</th>
                  <th>Bounce Rate</th>
                </tr>
              </thead>
              <tbody>
                {analyticsData.devices.map(d => (
                  <tr>
                    <td style="font-weight: 600;">{d.type}</td>
                    <td>{d.users}</td>
                    <td>{d.sessions}</td>
                    <td>{d.bounceRate.toFixed(1)}%</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="section">
            <div class="section-title">Top Countries</div>
            <table>
              <thead>
                <tr>
                  <th>Country</th>
                  <th>Users</th>
                  <th>Sessions</th>
                  <th>Conversion</th>
                </tr>
              </thead>
              <tbody>
                {analyticsData.geography.slice(0, 5).map(g => (
                  <tr>
                    <td style="font-weight: 600;">{g.country}</td>
                    <td>{g.users}</td>
                    <td>{g.sessions}</td>
                    <td>{g.conversionRate.toFixed(1)}%</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- TOP LANDING PAGES -->
        <div class="section">
          <div class="section-title">Top Landing Pages (Conversions)</div>
          <table>
            <thead>
              <tr>
                <th>Page</th>
                <th>Users</th>
                <th>Sessions</th>
                <th>Avg Duration</th>
                <th>Bounce Rate</th>
                <th>Conversion</th>
              </tr>
            </thead>
            <tbody>
              {analyticsData.topPages.map(p => (
                <tr>
                  <td style="font-weight: 600; font-family: monospace; font-size: 12px;">{p.path}</td>
                  <td>{p.users}</td>
                  <td>{p.sessions}</td>
                  <td>{p.avgDuration.toFixed(0)}s</td>
                  <td>{p.bounceRate.toFixed(1)}%</td>
                  <td style="color: var(--accent); font-weight: 600;">{p.conversionRate.toFixed(1)}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- CONVERSION FUNNEL -->
        <div class="section">
          <div class="section-title">Donation Conversion Funnel</div>
          <div style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; padding: 24px;">
            {analyticsData.conversionFunnel.map((step, i) => (
              <div class="bar-row">
                <div class="bar-label">{step.step}</div>
                <div class="bar-track">
                  <div class="bar-fill" style={`width: ${step.conversionRate}%`}></div>
                </div>
                <div class="bar-value">{step.users} users ({step.conversionRate.toFixed(1)}%)</div>
              </div>
            ))}
          </div>
          <p style="margin-top: 16px; font-size: 12px; color: var(--text-tertiary);">Each step shows % of total users that reached that point. Goal: increase conversion rate from 8.2% to 12%.</p>
        </div>

        <!-- NEW VS RETURNING + ENGAGEMENT -->
        <div class="grid-2">
          <div class="section">
            <div class="section-title">New vs Returning Users</div>
            <div style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; padding: 24px;">
              {analyticsData.audienceInsights.newVsReturning.map(n => (
                <div class="bar-row">
                  <div class="bar-label">{n.type}</div>
                  <div class="bar-track">
                    <div class="bar-fill" style={`width: ${n.percentage}%`}></div>
                  </div>
                  <div class="bar-value">{n.count} ({n.percentage}%)</div>
                </div>
              ))}
            </div>
          </div>

          <div class="section">
            <div class="section-title">User Engagement Level</div>
            <div style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; padding: 24px;">
              {analyticsData.audienceInsights.engagement.map(e => (
                <div class="bar-row">
                  <div class="bar-label">{e.metric}</div>
                  <div class="bar-track">
                    <div class="bar-fill" style={`width: ${e.percentage}%`}></div>
                  </div>
                  <div class="bar-value">{e.users} users ({e.percentage}%)</div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- INSIGHTS & RECOMMENDATIONS -->
        <div class="section">
          <div class="section-title">Key Insights & Recommendations</div>
          <div style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; padding: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
            <div>
              <h4 style="color: var(--accent); margin-bottom: 8px;">🔗 Direct Traffic Dominates</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">63% of users come directly (email/social). Maintain that momentum with regular campaigns.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); margin-bottom: 8px;">💚 Donate Page Converts</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">15.4% conversion rate on /donate/. Lower bounce (18.6%). This page works — promote it more.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); margin-bottom: 8px;">📱 Mobile Engagement Strong</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">53% traffic from mobile. Avg 95s duration = good engagement. No mobile UX issues detected.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); margin-bottom: 8px;">🎯 Campaign Pages Convert</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">Pregnancy-in-Prison and Petition pages have 12%+ conversion. These are your best performers.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); margin-bottom: 8px;">⚠️ Homepage Bounce High</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">Homepage: 29.3% bounce, 9.2% conversion. Improve CTAs and navigation to campaign pages.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); margin-bottom: 8px;">🌍 UK Dominates, US 2nd</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">41% UK, 27% USA. Consider geo-targeted campaigns for other English-speaking countries.</p>
            </div>
          </div>
        </div>

        <!-- GLOSSARY -->
        <div class="section">
          <div class="section-title">Analytics Glossary</div>
          <div style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; padding: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
            <div>
              <h4 style="color: var(--accent); font-size: 12px; font-weight: 700; margin-bottom: 8px;">USERS</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">Unique visitors to your site in the period. Higher is better for reaching new people.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); font-size: 12px; font-weight: 700; margin-bottom: 8px;">SESSIONS</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">User visits/interactions. More sessions per user = stronger engagement and repeat visits.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); font-size: 12px; font-weight: 700; margin-bottom: 8px;">BOUNCE RATE</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">% of users who left without taking action. Lower = better. 32% is good for nonprofits.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); font-size: 12px; font-weight: 700; margin-bottom: 8px;">AVG SESSION DURATION</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">How long users stay. 103s = very engaged. Mobile users spend less time (normal).</p>
            </div>
            <div>
              <h4 style="color: var(--accent); font-size: 12px; font-weight: 700; margin-bottom: 8px;">CONVERSION RATE</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">% of users who donate (or complete desired action). 8.2% is strong for nonprofits.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); font-size: 12px; font-weight: 700; margin-bottom: 8px;">SESSION VALUE</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">Average donation per session. Google organic = £1.17/session. Direct = £0.30/session.</p>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    const html = document.documentElement;
    const theme = localStorage.getItem('admin-theme') || 'dark';
    if (theme === 'light') html.classList.add('light-mode');

    document.getElementById('theme-btn')?.addEventListener('click', () => {
      if (html.classList.toggle('light-mode')) {
        localStorage.setItem('admin-theme', 'light');
        document.getElementById('theme-btn').textContent = '☀️';
      } else {
        localStorage.setItem('admin-theme', 'dark');
        document.getElementById('theme-btn').textContent = '🌙';
      }
    });

    document.getElementById('refresh-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('refresh-btn');
      btn.disabled = true;
      btn.textContent = 'Syncing...';
      try {
        // Future: connect to Google Analytics 4 API
        alert('Google Analytics sync coming soon. For now, data is static.');
        btn.textContent = 'Refresh Data';
        btn.disabled = false;
      } catch (e) {
        alert('Error: ' + e.message);
        btn.textContent = 'Refresh Data';
        btn.disabled = false;
      }
    });

    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/admin-auth', { method: 'DELETE' });
      location.href = '/admin';
    });
  </script>
</body>
</html>
