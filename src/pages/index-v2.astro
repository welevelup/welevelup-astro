---
// Step 2 homepage rebuild on the design system. Kept at a separate path
// (index-v2) rather than overwriting index.astro until approved — see
// docs/brand/DEVIATIONS.md and the Step 2 plan for the two mockup-vs-guide
// deviations this page ships with deliberately.
import Layout from '../layouts/Layout.astro';
import Section from '../components/design-system/Section.astro';
import Grid25 from '../components/design-system/Grid25.astro';
import Grid3 from '../components/design-system/Grid3.astro';
import Headline from '../components/design-system/Headline.astro';
import Subheadline from '../components/design-system/Subheadline.astro';
import Label from '../components/design-system/Label.astro';
import Highlight from '../components/design-system/Highlight.astro';
import Button from '../components/design-system/Button.astro';
import Header from '../components/design-system/Header.astro';
import Footer from '../components/design-system/Footer.astro';
import Ticker from '../components/design-system/Ticker.astro';
import SplitHero from '../components/design-system/SplitHero.astro';
import PetitionCard from '../components/design-system/PetitionCard.astro';
import BlogCard from '../components/design-system/BlogCard.astro';
import Collage from '../components/design-system/Collage.astro';
import VideoEmbed from '../components/design-system/VideoEmbed.astro';
import { CAMPAIGNS, FEATURED_CAMPAIGN, TICKER_CAMPAIGN } from '../lib/campaigns';

const otherCampaigns = CAMPAIGNS.filter((c) => c !== FEATURED_CAMPAIGN);
// Mockup shows 2 featured + 3 secondary petition cards. The "latest campaign"
// panel above already spotlights FEATURED_CAMPAIGN, but it's still an active
// petition, so it reappears here as one of the 2 featured cards rather than
// inventing a 5th real campaign that doesn't exist in the content.
const featuredRow = [FEATURED_CAMPAIGN, otherCampaigns[0]];
const secondaryRow = otherCampaigns.slice(1, 4);

function signatureLine(c: (typeof CAMPAIGNS)[number]): string {
  return c.goal
    ? `${c.signatures.toLocaleString('en-GB')} of ${c.goal.toLocaleString('en-GB')} signatures.`
    : `${c.signatures.toLocaleString('en-GB')}+ signatures.`;
}

const blogModules = import.meta.glob('../content/blog/*.md', { eager: true }) as Record<
  string,
  { frontmatter: { title: string; author: string; date: string; excerpt: string } }
>;
const latestPosts = Object.entries(blogModules)
  .map(([file, mod]) => ({ file, frontmatter: mod.frontmatter }))
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime())
  .slice(0, 3);
const [featuredPost, ...secondaryPosts] = latestPosts;

const tickerText = TICKER_CAMPAIGN
  ? `${TICKER_CAMPAIGN.name} • ${TICKER_CAMPAIGN.signatures.toLocaleString('en-GB')} of ${TICKER_CAMPAIGN.goal?.toLocaleString('en-GB')} signatures • Help us reach our goal →`
  : '';
---

<Layout headHtml="" title="Level Up | We are a feminist community campaigning for gender justice in the UK" description="We run feminist campaigns and collective action to advance gender justice in the UK.">
  <main>
    <Header heroBg="gentle-lilac" />

    <!-- HERO -->
    <Section bg="gentle-lilac">
      <div class="hp-hero">
        <div class="hp-hero-copy">
          <Headline>We are a feminist community</Headline>
          <Subheadline as="h2">campaigning for gender justice in the UK.</Subheadline>
        </div>
        <Collage index={6} class="hp-hero-collage" />
      </div>
    </Section>

    <!-- LATEST CAMPAIGN -->
    <SplitHero bg="loud-lilac" imageSrc={FEATURED_CAMPAIGN.imageSrc} imageAlt={FEATURED_CAMPAIGN.imageAlt}>
      <Subheadline as="h2" color="off-white">Take action on our latest campaign:</Subheadline>
      <p class="hp-campaign-highlight"><Highlight><Headline as="h3">{FEATURED_CAMPAIGN.tag}</Headline></Highlight></p>
      <p class="hp-campaign-body" style="color: var(--color-off-white);">{FEATURED_CAMPAIGN.intro}</p>
      <div class="hp-campaign-actions">
        <!-- Mockup deviation #1: Sign the petition uses Gentle Lilac + navy here (allowed pairing) -->
        <Button bg="gentle-lilac" text="navy" href={FEATURED_CAMPAIGN.petitionHref} label="Sign the petition" />
        <Button bg="off-white" text="navy" href={FEATURED_CAMPAIGN.href} label="Read more" />
      </div>
    </SplitHero>

    <!-- TICKER -->
    {tickerText && <Ticker bg="electric-yellow" text="navy" items={[tickerText]} />}

    <!-- WHO WE ARE -->
    <Section bg="off-white">
      <Grid25>
        <Fragment slot="narrow">
          <Headline as="h2">Who we are</Headline>
          <Collage index={4} />
        </Fragment>
        <Fragment slot="wide">
          <p>We create digital tools and campaigns that interrupt cultural moments to fight for gender justice – like flying a plane banner over a football match to break the silence around rape in sports, pushing ITV to drop plastic surgery adverts from Love Island and producing the UK's first media guidelines on reporting domestic abuse deaths.</p>
          <p>We're working towards a world where people of all genders are loved and liberated from bodily and systemic violence. We do this in our campaign coalitions, and through gathering with community like our monthly workshops on bystander intervention and intervening in police violence.</p>
          <p>Our movement includes feminists from a range of backgrounds and all genders, centring the voices and liberation of people who experience gender injustice: women, gender-nonconforming and trans people.</p>
        </Fragment>
      </Grid25>
    </Section>

    <!-- TEDX -->
    <Section bg="navy">
      <Grid25>
        <Fragment slot="narrow">
          <Label color="electric-yellow">TEDxLondon &middot; March 2023</Label>
          <Subheadline as="h2" color="off-white">How Collective Care Can Change Society</Subheadline>
          <p style="color: var(--color-off-white);">Level Up's vision is a world where everyone is loved and liberated. We believe that collective care is the route to building this world. Level Up co-directors Seyi and Janey explained what this means in a TEDxLondon talk in March 2023.</p>
        </Fragment>
        <Fragment slot="wide">
          <VideoEmbed src="https://www.youtube-nocookie.com/embed/xj-alDQD2fg" title="How collective care can change society | Janey Starling & Seyi Falodun-Liburd | TEDxLondon" />
        </Fragment>
      </Grid25>
    </Section>

    <!-- SIGN OUR PETITIONS -->
    <Section bg="off-white">
      <Grid25>
        <Fragment slot="narrow">
          <Headline as="h2">Sign our petitions</Headline>
          <Collage index={5} />
        </Fragment>
        <Fragment slot="wide">
          <div class="hp-petitions-featured">
            {featuredRow.map((c) => (
              <PetitionCard
                variant="featured"
                bg="electric-yellow"
                text="navy"
                buttonBg="loud-lilac"
                buttonText="off-white"
                secondaryHref={c.href}
                imageSrc={c.imageSrc}
                imageAlt={c.imageAlt}
                title={c.name}
                body={`${c.intro} ${signatureLine(c)}`}
                href={c.petitionHref}
              />
            ))}
          </div>
          <Grid3 class="hp-petitions-secondary">
            {secondaryRow.map((c) => (
              <PetitionCard
                variant="secondary"
                bg="off-white"
                text="navy"
                buttonBg="loud-lilac"
                buttonText="off-white"
                secondaryHref={c.href}
                imageSrc={c.imageSrc}
                imageAlt={c.imageAlt}
                title={c.name}
                body={`${c.intro} ${signatureLine(c)}`}
                href={c.petitionHref}
              />
            ))}
          </Grid3>
        </Fragment>
      </Grid25>
    </Section>

    <!-- FROM THE BLOG -->
    <Section bg="gentle-lilac">
      <Label color="navy">Feminist thinking</Label>
      <Headline as="h2">From the blog</Headline>
      <div class="hp-blog-grid">
        {featuredPost && (
          <BlogCard
            variant="featured-navy"
            title={featuredPost.frontmatter.title}
            excerpt={featuredPost.frontmatter.excerpt}
            author={featuredPost.frontmatter.author}
            date={featuredPost.frontmatter.date}
            href={`/blog/${featuredPost.file.split('/').pop()?.replace(/\.md$/, '')}`}
          />
        )}
        {secondaryPosts.map((post) => (
          <BlogCard
            variant="secondary-white"
            title={post.frontmatter.title}
            excerpt={post.frontmatter.excerpt}
            author={post.frontmatter.author}
            date={post.frontmatter.date}
            href={`/blog/${post.file.split('/').pop()?.replace(/\.md$/, '')}`}
          />
        ))}
      </div>
    </Section>

    <!-- JOIN THE COMMUNITY -->
    <Section bg="navy">
      <div class="hp-join">
        <div class="hp-join-copy">
          <Headline as="h2" color="off-white">Join the Level Up community</Headline>
          <p style="color: var(--color-off-white);">Campaign updates, event invitations, and feminist thinking.</p>
          <!-- Mockup deviation #1 continued: Gentle Lilac + navy is an allowed pairing, used here too -->
          <Button bg="gentle-lilac" text="navy" href="https://levelup.yourmovement.org/p/join-us" label="Join us" />
        </div>
        <Collage index={6} class="hp-join-collage" />
      </div>
    </Section>

    <Footer bg="loud-lilac" />
  </main>
</Layout>

<style>
  .hp-hero { display: grid; grid-template-columns: 1.2fr 1fr; align-items: center; gap: var(--space-8); }
  .hp-hero-collage { justify-self: end; max-width: 360px; }
  .hp-campaign-highlight { margin: var(--space-4) 0; }
  .hp-campaign-body { max-width: 46ch; }
  .hp-campaign-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-4); }
  .hp-petitions-featured { margin-bottom: var(--space-4); }
  .hp-blog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-4); margin-top: var(--space-6); }
  .hp-join { display: grid; grid-template-columns: 1.2fr 1fr; align-items: center; gap: var(--space-8); }
  .hp-join-collage { justify-self: end; max-width: 320px; }
  @media (max-width: 768px) {
    .hp-hero, .hp-join { grid-template-columns: 1fr; }
    .hp-hero-collage, .hp-join-collage { justify-self: center; }
  }
</style>
