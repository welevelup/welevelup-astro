---
/**
 * Blog listing — rebuilt on the design system (Section/Grid3/BlogCard).
 * Post metadata (title/date/tag) matches the real posts, cross-checked
 * against the content collection for author/excerpt. Real content only.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/design-system/Header.astro';
import Section from '../components/design-system/Section.astro';
import Grid3 from '../components/design-system/Grid3.astro';
import Headline from '../components/design-system/Headline.astro';
import Label from '../components/design-system/Label.astro';
import Button from '../components/design-system/Button.astro';
import BlogCard from '../components/design-system/BlogCard.astro';
import Footer from '../components/design-system/Footer.astro';
import { getCollection } from 'astro:content';

const collection = await getCollection('blog');
const bySlug = Object.fromEntries(collection.map((p) => [p.id, p.data]));

const POSTS = [
  { slug: 'if-you-like-us-cite-us', title: 'TLDR: If you like us, cite us', tag: 'Solidarity & Movement', date: '19 Apr 2026' },
  { slug: 'abortion-is-healthcare-why-decriminalisation-must-include-health-workers', title: 'Abortion Is Healthcare: Why Decriminalisation Must Include Health Workers', tag: 'Reproductive Justice', date: '12 Sep 2025', img: '/wp-content/uploads/2025/08/image-5.webp' },
  { slug: 'ending-prison-for-pregnant-women-a-non-reformist-reform', title: 'Ending Prison for Pregnant Women: A Non-Reformist Reform', tag: 'Criminalisation & Justice', date: '28 Aug 2025' },
  { slug: 'gender-critical-feminism-isnt-feminist', title: '"Gender-Critical" Feminism Isn\'t Feminist — It\'s Anti-Trans Politics', tag: 'Trans-Inclusive Feminism', date: '15 Jul 2025' },
  { slug: 'why-the-media-should-focus-on-diddys-violence-not-his-kinks', title: 'Why the Media Should Focus on Diddy\'s Violence, Not His Kinks', tag: 'Media & Violence', date: '3 Jun 2025' },
  { slug: 'why-we-need-to-start-moving-offline', title: 'Why We Need to Start Moving Offline', tag: 'Solidarity & Movement', date: '20 May 2025' },
  { slug: 'how-we-choose-our-campaigns', title: 'How We Choose Our Campaigns', tag: 'Solidarity & Movement', date: '8 Apr 2025' },
  { slug: 'beyond-sympathy-feminist-solidarity-without-deservingness', title: 'Beyond Sympathy: Feminist Solidarity Without Deservingness', tag: 'Solidarity & Movement', date: '22 Mar 2025' },
  { slug: 'the-griefs-left-unattended', title: 'The Griefs Left Unattended', tag: 'Solidarity & Movement', date: '10 Feb 2025' },
  { slug: 'why-expanding-criminalisation-is-a-feminist-issue', title: 'Why Expanding Criminalisation Is a Feminist Issue', tag: 'Criminalisation & Justice', date: '5 Jan 2025' },
  { slug: 'its-time-to-reclaim-the-socialist-roots-of-international-womens-day', title: "It's Time to Reclaim the Socialist Roots of International Women's Day", tag: 'Solidarity & Movement', date: '8 Mar 2024' },
].map((p) => ({ ...p, author: bySlug[p.slug]?.author ?? 'Level Up', excerpt: bySlug[p.slug]?.excerpt ?? '' }));

const featuredIdx = POSTS.findIndex((p) => p.img);
const featured = POSTS[featuredIdx];
const rest = POSTS.filter((_, i) => i !== featuredIdx);
---
<Layout
  headHtml=""
  title="Feminist Thinking — Blog | Level Up"
  description="Analysis, essays and feminist thinking from Level Up — on reproductive justice, gender-based violence, criminalisation, trans-inclusive feminism and more."
  ogImage="https://welevelup.org/wp-content/uploads/2025/07/level_up_new.webp"
>
  <Header heroBg="navy" />

  <Section bg="navy">
    <Label color="gentle-lilac">Feminist Thinking</Label>
    <Headline color="electric-yellow">Feminist Thinking</Headline>
    <p style="color: var(--color-off-white); opacity: 0.85; max-width: 56ch;">Analysis, perspectives, and feminist thinking from Level Up on campaigns, policy, and gender justice in the UK.</p>
  </Section>

  <Section bg="pale-yellow">
    <a href={`/blog/${featured.slug}`} class="bl-featured">
      {featured.img && <div class="bl-featured-img" style={`background-image:url('${featured.img}')`}></div>}
      <div class="bl-featured-body">
        <span class="bl-tag">{featured.tag}</span>
        <h2>{featured.title}</h2>
        {featured.excerpt && <p class="bl-featured-excerpt">{featured.excerpt}</p>}
        <div class="bl-featured-meta">
          <span class="bl-date">{featured.author} &middot; {featured.date}</span>
          <span class="bl-read">Read article →</span>
        </div>
      </div>
    </a>

    <Grid3 class="bl-grid3">
      {rest.map((post) => (
        <BlogCard
          title={post.title}
          excerpt={post.excerpt || post.tag}
          author={post.author}
          date={post.date}
          href={`/blog/${post.slug}`}
        />
      ))}
    </Grid3>
  </Section>

  <Section bg="navy">
    <div class="bl-cta">
      <Headline as="h2" color="electric-yellow">Join the Level Up community</Headline>
      <p style="color: var(--color-off-white); opacity: 0.75; max-width: 480px; margin-inline: auto;">Campaign updates, event invitations, and feminist thinking.</p>
      <Button bg="electric-yellow" text="navy" href="https://levelup.yourmovement.org/p/join-us" label="Join us" />
    </div>
  </Section>

  <Footer bg="navy" />
</Layout>

<style>
  .bl-featured {
    display: block;
    text-decoration: none;
    color: var(--color-navy);
    background: var(--color-white);
    border-radius: var(--radius-card);
    overflow: hidden;
    margin-bottom: var(--space-8);
  }
  .bl-featured-img { height: 320px; background-size: cover; background-position: center; }
  .bl-featured-body { padding: var(--space-8); display: flex; flex-direction: column; gap: var(--space-3); }
  .bl-featured-body h2 { font-family: var(--font-headline); font-size: var(--text-subheadline); margin: 0; }
  .bl-tag { font-family: var(--font-body); font-weight: 700; font-size: var(--text-label); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-loud-lilac); }
  .bl-featured-excerpt { font-family: var(--font-body); color: var(--color-navy); opacity: 0.75; margin: 0; max-width: 68ch; }
  .bl-featured-meta { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); flex-wrap: wrap; margin-top: var(--space-2); }
  .bl-date { font-family: var(--font-body); font-size: var(--text-label); opacity: 0.6; }
  .bl-read { font-family: var(--font-body); font-weight: 700; font-size: var(--text-label); }

  .bl-cta { text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-4); }
</style>
