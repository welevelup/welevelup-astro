---
/**
 * Contact — rebuilt on the design system (Section/Grid25/Headline).
 * Real content and the working /api/contact form handler preserved
 * verbatim — see .bak-pre-step2 for the original.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/design-system/Header.astro';
import Section from '../components/design-system/Section.astro';
import Grid25 from '../components/design-system/Grid25.astro';
import Headline from '../components/design-system/Headline.astro';
import Label from '../components/design-system/Label.astro';
import Button from '../components/design-system/Button.astro';
import Footer from '../components/design-system/Footer.astro';
---
<Layout
  headHtml=""
  title="Contact Level Up"
  description="Get in touch with Level Up. We'd love to hear from you. Email us at hello@welevelup.org or send a message via our contact form."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact Level Up",
    "url": "https://welevelup.org/contact",
    "description": "Get in touch with Level Up — a UK feminist campaigning organisation. Email hello@welevelup.org or use the contact form.",
    "mainEntity": {
      "@type": "NGO",
      "name": "Level Up",
      "url": "https://welevelup.org",
      "email": "hello@welevelup.org",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "3rd Floor, 86–90 Paul Street",
        "addressLocality": "London",
        "postalCode": "EC2A 4NE",
        "addressCountry": "GB"
      }
    }
  })} />

  <Header heroBg="navy" />

  <Section bg="navy">
    <Label color="gentle-lilac">Get in touch</Label>
    <Headline color="electric-yellow">Contact Level Up</Headline>
    <p style="color: var(--color-off-white); opacity: 0.85; max-width: 56ch;">We're a UK-based feminist campaigning organisation working to end bodily and systemic violence. If you're a journalist, supporter, potential partner, or someone with a campaign idea — we'd love to hear from you.</p>
  </Section>

  <Section bg="pale-yellow">
    <Grid25>
      <Fragment slot="wide">
        <h2 class="ct-form-heading">Send us a message</h2>
        <form class="ct-form" id="ct-form">
          <label>
            <span>Name</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label>
            <span>Subject</span>
            <input type="text" name="subject" />
          </label>
          <label>
            <span>Message</span>
            <textarea name="message" rows="6" required></textarea>
          </label>
          <button type="button" id="ct-submit" class="ct-submit">Send message</button>
          <p id="ct-status" class="ct-status" aria-live="polite"></p>
        </form>
      </Fragment>

      <Fragment slot="narrow">
        <div class="ct-info">
          <div class="ct-info-block">
            <p class="ct-info-label">For media enquiries</p>
            <a href="mailto:media@welevelup.org">media@welevelup.org</a>
          </div>
          <div class="ct-info-block">
            <p class="ct-info-label">Got a campaign idea, or just want to say hi?</p>
            <a href="mailto:hello@welevelup.org">hello@welevelup.org</a>
          </div>
          <div class="ct-info-block">
            <p class="ct-info-label">Work with us</p>
            <a href="mailto:hello@welevelup.org">hello@welevelup.org</a>
          </div>
          <div class="ct-info-block">
            <p class="ct-info-label">Address</p>
            <p class="ct-info-text">3rd Floor 86 – 90 Paul Street<br/>London<br/>EC2A 4NE</p>
          </div>
          <div class="ct-info-block">
            <p class="ct-info-label">Follow us</p>
            <div class="ct-social">
              <a href="https://www.facebook.com/levelupaction" target="_blank" rel="noopener">Facebook</a>
              <a href="https://twitter.com/we_level_up" target="_blank" rel="noopener">Twitter/X</a>
              <a href="https://www.instagram.com/welevelup" target="_blank" rel="noopener">Instagram</a>
              <a href="https://www.tiktok.com/@levelupactionuk" target="_blank" rel="noopener">TikTok</a>
            </div>
          </div>
        </div>
      </Fragment>
    </Grid25>
  </Section>

  <Section bg="navy">
    <div class="ct-cta">
      <Headline as="h2" color="electric-yellow">Join the Level Up community</Headline>
      <p style="color: var(--color-off-white); opacity: 0.75; max-width: 480px; margin-inline: auto;">Campaign updates, event invitations, and feminist thinking.</p>
      <Button bg="electric-yellow" text="navy" href="https://levelup.yourmovement.org/p/join-us" label="Join us" />
    </div>
  </Section>

  <Footer bg="navy" />
</Layout>

<script>
  const btn = document.getElementById('ct-submit');
  const form = document.getElementById('ct-form') as HTMLFormElement;
  const status = document.getElementById('ct-status') as HTMLElement;
  btn?.addEventListener('click', async () => {
    const name = (form.querySelector('[name=name]') as HTMLInputElement).value.trim();
    const email = (form.querySelector('[name=email]') as HTMLInputElement).value.trim();
    const message = (form.querySelector('[name=message]') as HTMLTextAreaElement).value.trim();
    if (!name || !email || !message) {
      status.textContent = 'Name, email and message are required.';
      status.className = 'ct-status ct-status--err';
      return;
    }
    const subject = (form.querySelector('[name=subject]') as HTMLInputElement)?.value ?? '';
    const originalLabel = btn.textContent;
    btn.textContent = 'Sending…';
    (btn as HTMLButtonElement).setAttribute('disabled', 'true');
    status.textContent = '';
    status.className = 'ct-status';
    try {
      const res = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name, email, message, subject }) });
      let json: any = {};
      try { json = await res.json(); } catch (_) {}
      if (res.ok) {
        status.textContent = "Message sent — we'll be in touch soon!";
        status.className = 'ct-status ct-status--ok';
        form.reset();
        status.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        status.textContent = json.error || 'Something went wrong. Please email us directly.';
        status.className = 'ct-status ct-status--err';
      }
    } catch {
      status.textContent = 'Something went wrong. Please email hello@welevelup.org';
      status.className = 'ct-status ct-status--err';
    }
    btn.textContent = originalLabel;
    btn.removeAttribute('disabled');
  });
</script>

<style>
  .ct-form-heading {
    font-family: var(--font-headline);
    font-size: var(--text-subheadline);
    color: var(--color-navy);
    margin: 0 0 var(--space-6);
  }
  .ct-form { display: flex; flex-direction: column; gap: var(--space-5); }
  .ct-form label { display: flex; flex-direction: column; gap: var(--space-2); }
  .ct-form label span {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-navy);
    opacity: 0.6;
  }
  .ct-form input, .ct-form textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: var(--space-3) var(--space-4);
    border: 2px solid rgba(12,10,62,0.15);
    background: var(--color-white);
    color: var(--color-navy);
  }
  .ct-form input:focus, .ct-form textarea:focus {
    outline: 3px solid var(--color-navy);
    outline-offset: 2px;
    border-color: var(--color-navy);
  }
  .ct-submit {
    font-family: var(--font-headline);
    font-size: var(--text-body);
    background: var(--color-electric-yellow);
    color: var(--color-navy);
    border: none;
    padding: var(--space-3) var(--space-6);
    cursor: pointer;
    align-self: flex-start;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .ct-submit:hover { transform: translateY(-1px); opacity: 0.92; }
  .ct-submit:disabled { opacity: 0.6; cursor: default; transform: none; }

  .ct-status { font-family: var(--font-body); font-size: 0.9375rem; padding: var(--space-3) var(--space-4); margin: 0; display: none; }
  .ct-status--ok { display: block; background: var(--color-electric-yellow); color: var(--color-navy); border-left: 4px solid var(--color-navy); }
  .ct-status--err { display: block; background: #ffe0e0; color: #8b0000; border-left: 4px solid #8b0000; }

  .ct-info { display: flex; flex-direction: column; gap: var(--space-6); }
  .ct-info-label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-navy);
    margin: 0 0 var(--space-2);
  }
  .ct-info-block a {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-navy);
    text-decoration: underline;
    text-decoration-color: var(--color-loud-lilac);
    text-underline-offset: 3px;
  }
  .ct-info-text { font-family: var(--font-body); color: var(--color-navy); opacity: 0.8; margin: 0; }
  .ct-social { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  .ct-social a {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-navy);
    text-decoration: none;
    border-bottom: 2px solid var(--color-loud-lilac);
    padding-bottom: 2px;
  }

  .ct-cta { text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-4); }
</style>
