---
export const prerender = false;

const seoData = {
  period: "May 5 - June 4, 2026",
  keywords: [
    { query: "level up", impressions: 2233, clicks: 36, ctr: 1.61, position: 7.0 },
    { query: "level up uk", impressions: 35, clicks: 8, ctr: 22.86, position: 1.5 },
    { query: "feminist campaigns", impressions: 14, clicks: 1, ctr: 7.14, position: 1.5 },
    { query: "pregnancy in prison", impressions: 9, clicks: 0, ctr: 0.00, position: 18.9 },
    { query: "feminist groups uk", impressions: 3, clicks: 0, ctr: 0.00, position: 16.7 }
  ],
  pages: [
    { url: "/", impressions: 3976, clicks: 128, ctr: 3.22, position: 2.5 },
    { url: "/campaign/pregnancy-in-prison/", impressions: 867, clicks: 102, ctr: 11.76, position: 5.1 },
    { url: "/petition/ipso-dignity/", impressions: 456, clicks: 55, ctr: 12.06, position: 4.4 },
    { url: "/media-guidelines/", impressions: 305, clicks: 38, ctr: 12.46, position: 6.2 },
    { url: "/blog/", impressions: 187, clicks: 12, ctr: 6.42, position: 15.1 }
  ],
  ctr_opportunity: 3976 * 0.032,
  position_opportunity: "levelup (one word) at #10.5 - 265 impressions"
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>SEO Dashboard — Level Up Admin</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    :root {
      --bg-primary: #0C0A3E;
      --bg-secondary: #13114a;
      --text-primary: #EEEBD3;
      --text-secondary: #999999;
      --text-tertiary: rgba(238,235,211,0.4);
      --accent: #CCFF33;
      --border: rgba(255,255,255,0.06);
    }
    :root.light-mode {
      --bg-primary: #FFFFFF;
      --bg-secondary: #F9F9F9;
      --text-primary: #1A1A1A;
      --text-secondary: #666666;
      --text-tertiary: #888888;
      --accent: #8B7EBD;
      --border: rgba(0,0,0,0.1);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .layout { display: flex; flex: 1; }
    .sidebar {
      width: 240px;
      background: var(--bg-secondary);
      border-right: 1px solid var(--border);
      padding: 24px 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .sidebar-item {
      padding: 12px 20px;
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 14px;
      cursor: pointer;
      transition: all 0.2s;
      border-left: 3px solid transparent;
      display: block;
    }
    .sidebar-item:hover { background: rgba(255,255,255,0.05); color: var(--text-primary); }
    .sidebar-item.active { background: rgba(204,255,51,0.1); color: var(--accent); border-left-color: var(--accent); }
    .content { flex: 1; display: flex; flex-direction: column; }
    nav {
      background: var(--bg-secondary);
      border-bottom: 1px solid var(--border);
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 56px;
    }
    .nav-brand { font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--accent); }
    .nav-right { display: flex; align-items: center; gap: 20px; }
    .logout-btn { background: none; border: 1px solid var(--text-secondary); color: var(--text-secondary); border-radius: 6px; padding: 8px 16px; font-size: 12px; cursor: pointer; }
    main { max-width: 1200px; margin: 0 auto; padding: 40px 32px; flex: 1; }
    h1 { font-size: 28px; font-weight: 800; margin-bottom: 8px; }
    .subtitle { font-size: 14px; color: var(--text-secondary); margin-bottom: 40px; }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 40px;
    }
    .stat-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 24px;
    }
    .stat-label { font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 12px; }
    .stat-value { font-size: 28px; font-weight: 800; color: var(--accent); }
    .stat-sub { font-size: 12px; color: var(--text-tertiary); margin-top: 4px; }
    .section { margin-bottom: 40px; }
    .section-title { font-size: 14px; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 16px; }
    table { width: 100%; border-collapse: collapse; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
    th { text-align: left; font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--text-tertiary); padding: 12px 20px; border-bottom: 1px solid var(--border); }
    td { padding: 12px 20px; font-size: 13px; border-bottom: 1px solid rgba(255,255,255,0.04); }
    tr:last-child td { border-bottom: none; }
    .good { color: #CCFF33; font-weight: 600; }
    .fair { color: #FFA500; }
    .poor { color: #FF6B6B; }
    #theme-btn { cursor: pointer; padding: 4px 8px; background: none; border: none; font-size: 16px; }
  </style>
</head>
<body>
  <nav>
    <div class="nav-brand">Level Up · Admin</div>
    <div class="nav-right">
      <button id="theme-btn">🌙</button>
      <button class="logout-btn" id="logout-btn">Sign out</button>
    </div>
  </nav>

  <div class="layout">
    <div class="sidebar">
      <a href="/admin/dashboard" class="sidebar-item">Donations</a>
      <a href="/admin/seo" class="sidebar-item active">SEO</a>
      <a href="/admin/analytics" class="sidebar-item">Analytics</a>
    </div>

    <div class="content">
      <main>
        <h1>SEO Dashboard</h1>
        <p class="subtitle">Search Engine Optimization metrics for welevelup.org (Last 30 days)</p>

        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-label">Top Keyword</div>
            <div class="stat-value">"level up"</div>
            <div class="stat-sub">2,233 impressions · Rank #7</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Best CTR</div>
            <div class="stat-value"><span class="good">22.86%</span></div>
            <div class="stat-sub">"level up uk" · Rank #1.5</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Homepage CTR</div>
            <div class="stat-value"><span class="fair">3.22%</span></div>
            <div class="stat-sub">128 clicks from 3,976 impressions</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Opportunity</div>
            <div class="stat-value">"levelup"</div>
            <div class="stat-sub">265 impressions · Rank #10.5</div>
          </div>
        </div>

        <div class="section">
          <div class="section-title">Top Keywords (5 tracked)</div>
          <table>
            <thead>
              <tr>
                <th>Query</th>
                <th>Impressions</th>
                <th>Clicks</th>
                <th>CTR</th>
                <th>Avg Position</th>
              </tr>
            </thead>
            <tbody>
              {seoData.keywords.map(k => (
                <tr>
                  <td style="font-weight: 600;">{k.query}</td>
                  <td>{k.impressions.toLocaleString()}</td>
                  <td>{k.clicks}</td>
                  <td class={k.ctr > 10 ? 'good' : k.ctr > 3 ? 'fair' : 'poor'}>{k.ctr.toFixed(2)}%</td>
                  <td>#{k.position.toFixed(1)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="section">
          <div class="section-title">Top Pages</div>
          <table>
            <thead>
              <tr>
                <th>URL</th>
                <th>Impressions</th>
                <th>Clicks</th>
                <th>CTR</th>
                <th>Avg Pos</th>
              </tr>
            </thead>
            <tbody>
              {seoData.pages.map(p => (
                <tr>
                  <td style="font-weight: 600; font-family: monospace; font-size: 12px;">{p.url}</td>
                  <td>{p.impressions.toLocaleString()}</td>
                  <td>{p.clicks}</td>
                  <td>{p.ctr.toFixed(2)}%</td>
                  <td>#{p.position.toFixed(1)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="section">
          <div class="section-title">Quick Recommendations</div>
          <div style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; padding: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
            <div>
              <h3 style="color: var(--accent); margin-bottom: 8px;">📈 Homepage CTR</h3>
              <p style="color: var(--text-secondary); font-size: 13px;">3,976 impressions but only 3.22% CTR. Optimize title/meta description to improve click-through rate.</p>
            </div>
            <div>
              <h3 style="color: var(--accent); margin-bottom: 8px;">🎯 Position "levelup"</h3>
              <p style="color: var(--text-secondary); font-size: 13px;">265 impressions at rank #10.5 (one-word variant). Add content to rank higher on this variant.</p>
            </div>
            <div>
              <h3 style="color: var(--accent); margin-bottom: 8px;">📝 Blog Visibility</h3>
              <p style="color: var(--text-secondary); font-size: 13px;">Blog at position 15.1 with low clicks. Improve internal linking and on-page SEO for blog pages.</p>
            </div>
          </div>
        </div>

        <div class="section">
          <div class="section-title">SEO Metrics Glossary</div>
          <div style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; padding: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
            <div>
              <h4 style="color: var(--accent); font-size: 12px; font-weight: 700; margin-bottom: 8px;">IMPRESSIONS</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">Number of times your site appeared in Google search results. Higher is better for visibility, but click-through rate also matters.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); font-size: 12px; font-weight: 700; margin-bottom: 8px;">CLICKS</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">Number of times people clicked on your site in search results. This drives actual traffic to welevelup.org.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); font-size: 12px; font-weight: 700; margin-bottom: 8px;">CTR (Click-Through Rate)</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">Percentage of people who clicked your link from search results (clicks ÷ impressions × 100). A 22% CTR is excellent; 3% is average.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); font-size: 12px; font-weight: 700; margin-bottom: 8px;">AVERAGE POSITION</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">Your average ranking in Google search results. #1 is ideal; #5-10 is good; #11+ means you're on page 2 of results.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); font-size: 12px; font-weight: 700; margin-bottom: 8px;">RANK #1.5</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">Position between results #1 and #2. Google sometimes shows featured snippets or special boxes that occupy space before ranking positions.</p>
            </div>
            <div>
              <h4 style="color: var(--accent); font-size: 12px; font-weight: 700; margin-bottom: 8px;">OPPORTUNITY</h4>
              <p style="color: var(--text-secondary); font-size: 13px;">Keywords with high impressions but low CTR or high position rank. Improve these and you'll see traffic gains quickly.</p>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    const html = document.documentElement;
    const theme = localStorage.getItem('admin-theme') || 'dark';
    if (theme === 'light') html.classList.add('light-mode');

    document.getElementById('theme-btn')?.addEventListener('click', () => {
      if (html.classList.toggle('light-mode')) {
        localStorage.setItem('admin-theme', 'light');
        document.getElementById('theme-btn').textContent = '☀️';
      } else {
        localStorage.setItem('admin-theme', 'dark');
        document.getElementById('theme-btn').textContent = '🌙';
      }
    });

    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/admin-auth', { method: 'DELETE' });
      location.href = '/admin';
    });
  </script>
</body>
</html>
